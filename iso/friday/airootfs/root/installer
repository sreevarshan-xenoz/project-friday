#!/usr/bin/env bash
# FRIDAY Live ISO Target Installer (Visual Identity Pass)
set -euo pipefail

FRIDAY_ACCENT="#7AA2F7"
FRIDAY_SECONDARY="#BB9AF7"
FRIDAY_MUTED="#565F89"
FRIDAY_SUCCESS="#9ECE6A"
FRIDAY_BORDER="#3B4261"

draw_status() {
  clear
  gum style \
    --foreground "$FRIDAY_ACCENT" \
    --border-foreground "$FRIDAY_BORDER" \
    --border rounded \
    --align center \
    --width 64 \
    --padding "1 2" \
    "I N I T I A L I Z I N G   F R I D A Y" \
    "────────────────────────────────────" \
    "$1"
  echo
}

draw_status "Preparing target disk $TARGET_DISK..."

# 1. Partition & Format Target Disk
gum style --foreground "$FRIDAY_MUTED" "Partitioning $TARGET_DISK (GPT / ESP / Root)..."
parted -s "$TARGET_DISK" mklabel gpt
parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 1024MiB
parted -s "$TARGET_DISK" set 1 esp on
parted -s "$TARGET_DISK" mkpart primary ext4 1024MiB 100%

if [[ "$TARGET_DISK" =~ nvme || "$TARGET_DISK" =~ mmcblk ]]; then
  BOOT_PART="${TARGET_DISK}p1"
  ROOT_PART="${TARGET_DISK}p2"
else
  BOOT_PART="${TARGET_DISK}1"
  ROOT_PART="${TARGET_DISK}2"
fi

gum style --foreground "$FRIDAY_MUTED" "Formatting filesystems (FAT32 / EXT4)..."
mkfs.vfat -F32 "$BOOT_PART" >/dev/null
mkfs.ext4 -F "$ROOT_PART" >/dev/null

draw_status "Mounting target filesystems..."
mkdir -p /mnt
mount "$ROOT_PART" /mnt
mkdir -p /mnt/boot
mount "$BOOT_PART" /mnt/boot

# 2. Pacstrap Base System & Packages
draw_status "Pacstrapping base Arch Linux & desktop substrate..."
pacstrap /mnt base linux linux-firmware sudo zsh hyprland sddm uwsm quickshell waybar xdg-desktop-portal-hyprland grim slurp wl-clipboard pipewire pipewire-alsa pipewire-pulse wireplumber foot ttf-jetbrains-mono-nerd noto-fonts networkmanager rsync gum

draw_status "Generating system fstab..."
genfstab -U /mnt >> /mnt/etc/fstab

# 3. Materialize FRIDAY Binaries & Omarchy Substrate into Target /mnt
draw_status "Materializing FRIDAY runtime & Omarchy substrate..."
mkdir -p /mnt/usr/bin
cp -p /usr/bin/friday /usr/bin/friday-ctl /usr/bin/friday-linux-daemon /mnt/usr/bin/
chmod 755 /mnt/usr/bin/friday*

mkdir -p /mnt/usr/share/omarchy
rsync -a /usr/share/omarchy/ /mnt/usr/share/omarchy/

rsync -a /etc/sddm.conf.d/ /mnt/etc/sddm.conf.d/ 2>/dev/null || true
rsync -a /etc/sysctl.d/ /mnt/etc/sysctl.d/ 2>/dev/null || true

# 4. Enable SDDM & User Services on Target System
draw_status "Configuring SDDM & systemd user services..."
mkdir -p /mnt/etc/systemd/system
ln -sf /usr/lib/systemd/system/sddm.service /mnt/etc/systemd/system/display-manager.service
mkdir -p /mnt/etc/systemd/user/default.target.wants
cp -p /etc/systemd/user/friday-linux-daemon.service /mnt/etc/systemd/user/ 2>/dev/null || true
ln -sf ../friday-linux-daemon.service /mnt/etc/systemd/user/default.target.wants/friday-linux-daemon.service 2>/dev/null || true

# 5. Set up First-Boot Provisioning Marker
draw_status "Arming first-boot provisioning marker..."
mkdir -p /mnt/var/lib/omarchy/provisioning
touch /mnt/var/lib/omarchy/provisioning/pending
cat << EOF > /mnt/var/lib/omarchy/provisioning/install-info.json
{
  "hostname": "$HOSTNAME",
  "username": "$USERNAME",
  "timezone": "$TIMEZONE",
  "keyboard": "$KEYBOARD"
}
EOF

# 6. Configure Bootloader
draw_status "Installing UEFI bootloader..."
bootctl --path=/mnt/boot install >/dev/null
cat << EOF > /mnt/boot/loader/loader.conf
default arch.conf
timeout 1
EOF

cat << EOF > /mnt/boot/loader/entries/arch.conf
title   FRIDAY OS
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=PARTUUID=$(blkid -s PARTUUID -o value "$ROOT_PART") rw
EOF

chmod +x /root/configurator /root/installer

clear
gum style \
  --foreground "$FRIDAY_SUCCESS" \
  --border-foreground "$FRIDAY_BORDER" \
  --border rounded \
  --align center \
  --width 64 \
  --padding "1 2" \
  "S Y S T E M   R E A D Y" \
  "──────────────────────" \
  "FRIDAY has been installed to $TARGET_DISK." \
  "" \
  "Remove the installation media and reboot."

sleep 3
umount -R /mnt
reboot
