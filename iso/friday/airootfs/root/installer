#!/usr/bin/env bash
# FRIDAY OS Automated Core Assembler (M7 Identity Baseline + Dots-Hyprland Theming)
set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"

# Configuration. The disk and password have no defaults: the configurator
# (or an unattended run) must name them, and ERASE_DISK must repeat the disk
# as the go-ahead to erase it.
TARGET_DISK="${TARGET_DISK:-}"
ERASE_DISK="${ERASE_DISK:-}"
KEYBOARD="${KEYBOARD:-us}"
# Not $HOSTNAME: bash sets that to the live system's name ("archiso").
HOSTNAME="${FRIDAY_HOSTNAME:-friday}"
USERNAME="${USERNAME:-friday}"
PASSWORD="${PASSWORD:-}"
TIMEZONE="${TIMEZONE:-UTC}"
THEME="${THEME:-FRIDAY Shell (Ember, made for FRIDAY)}"
SHELL_STYLE="${SHELL_STYLE:-Ember (bar flush with the top edge)}"
SESSION="${SESSION:-Hyprland (tiling, the FRIDAY OS default)}"
SDDM_THEME="${SDDM_THEME:-SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)}"
AUTO_REBOOT="${AUTO_REBOOT:-false}"
# Skip the SDDM password screen at boot. Off by default: with it on, anyone
# who powers the machine on gets the desktop.
AUTOLOGIN="${AUTOLOGIN:-false}"
# LUKS2 full-disk encryption of the root partition, unlocked with PASSWORD
# at boot. The configurator asks (default yes); unattended runs opt in.
ENCRYPT="${ENCRYPT:-false}"
FRIDAY_AI_PROVIDER="${FRIDAY_AI_PROVIDER:-}"
FRIDAY_AI_KEY="${FRIDAY_AI_KEY:-}"
# Root SSH + serial autologin on the installed system, for VM debugging only.
# Opt in with FRIDAY_DEBUG_ACCESS=true or `friday.debug` on the live kernel cmdline.
FRIDAY_DEBUG_ACCESS="${FRIDAY_DEBUG_ACCESS:-false}"
if grep -qw 'friday.debug' /proc/cmdline 2>/dev/null; then FRIDAY_DEBUG_ACCESS=true; fi
LOG_FILE="/tmp/friday-installer.log"

# shellcheck source=friday-tui.sh
source "$(dirname "$(readlink -f "$0")")/friday-tui.sh"
INSTALL_STARTED=$SECONDS
INSTALL_STEPS=(DISK MOUNT PACKAGES FRIDAY CONFIGURE BOOT)

elapsed() { printf '%02d:%02d' $(((SECONDS - INSTALL_STARTED) / 60)) $(((SECONDS - INSTALL_STARTED) % 60)); }

# phase_msg <step 1-6> <what FRIDAY is doing>
phase_msg() {
  friday_speak "Step $1 of 6. $2"
  {
    friday_header "INSTALLING"
    friday_rail "$1" "${INSTALL_STEPS[@]}"
    friday_note "  $USERNAME@$HOSTNAME  ·  $TARGET_DISK  ·  elapsed $(elapsed)"
    echo
    gum style --margin "0 0 0 $FRIDAY_INDENT" --foreground "$FRIDAY_SUCCESS" --bold "Step $1 of 6 · $2"
    echo
    friday_note "  Full log: $LOG_FILE  (Alt+F2 for a shell: tail -f it)"
    echo
  } >&3 2>/dev/null || echo "Step $1 of 6: $2" >&3
  echo "=== Step $1 of 6: $2"
}

# A live one-line status under the step header while a long step runs:
# spinner, elapsed time, and the latest package pacman is handling.
LIVE_PID=""
live_status_start() {
  [[ -t 3 ]] || return 0
  (
    trap - ERR EXIT
    set +e
    # The console font has no Braille (or half blocks): a plain spinner there.
    frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'; [[ "${TERM:-}" == linux ]] && frames='|/-\|/-\|/'; i=0
    while true; do
      line=$(tail -n 40 "$LOG_FILE" 2>/dev/null | tr '\r' '\n' \
        | grep -oE '\(\s*[0-9]+/[0-9]+\) (installing|upgrading|checking|downloading|loading|resolving)[^ ]* ?[^ ]*|downloading [^ ]+|:: [A-Za-z ]+\.\.\.' \
        | tail -n 1)
      printf '\r\e[2K%s%s%s\e[0m %s  %s%s\e[0m' "$FRIDAY_PAD" "$(friday_fg "$FRIDAY_ACCENT")" \
        "${frames:i%10:1}" "$(elapsed)" "$(friday_fg "$FRIDAY_MUTED")" "${line:0:60}" >&3
      i=$((i + 1))
      sleep 0.15
    done
  ) &
  LIVE_PID=$!
}
live_status_stop() {
  [[ -n "$LIVE_PID" ]] || return 0
  local pid="$LIVE_PID"
  LIVE_PID=""
  # A killed job makes `wait` return 143; never let that trip set -e / ERR.
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  printf '\r\e[2K' >&3
}
trap 'live_status_stop' EXIT

exec 3>&1 4>&2
exec >>"$LOG_FILE" 2>&1

# On any failure, show what went wrong on screen instead of a silent exit.
on_failure() {
  local code=$?
  trap - ERR
  live_status_stop
  {
    echo
    friday_err "Installation stopped (exit $code). Last lines of $LOG_FILE:"
    echo
    tail -n 15 "$LOG_FILE" | sed 's/^/    /'
    echo
  } >&3 2>&1
  exit "$code"
}
set -E
trap on_failure ERR

# systemd-boot needs UEFI: stop before touching the disk on a BIOS boot.
if [[ ! -d /sys/firmware/efi && -z "${FRIDAY_ASSUME_UEFI:-}" ]]; then
  { friday_err "This computer started in legacy BIOS mode; FRIDAY OS needs UEFI. Nothing was erased."; } >&3 2>&1
  exit 1
fi

# Nothing is erased unless the target is a whole disk, named twice, and not
# the USB stick this live system runs from.
refuse() { { friday_err "$1 Nothing was erased."; } >&3 2>&1; exit 1; }
[[ -n "$TARGET_DISK" ]] || refuse "No disk was chosen (TARGET_DISK)."
[[ "$ERASE_DISK" == "$TARGET_DISK" ]] || refuse "Erasing $TARGET_DISK wasn't confirmed (ERASE_DISK must name it too)."
[[ -b "$TARGET_DISK" && "$(lsblk -n -d -o TYPE "$TARGET_DISK" 2>/dev/null)" == disk ]] \
  || refuse "$TARGET_DISK isn't a whole disk."
[[ "$(readlink -f "$TARGET_DISK")" != "$(friday_live_disk)" ]] \
  || refuse "$TARGET_DISK is the USB stick FRIDAY OS is running from."
[[ -n "$PASSWORD" ]] || refuse "No password was set (PASSWORD)."
echo "Target: $TARGET_DISK, $(lsblk -n -d -o SIZE,MODEL "$TARGET_DISK" 2>/dev/null | xargs)"

phase_msg 1 "Preparing $TARGET_DISK"
if mountpoint -q /mnt; then fuser -km /mnt 2>/dev/null || true; fi
umount -R /mnt 2>/dev/null || true
cryptsetup close cryptroot 2>/dev/null || true   # left open by an earlier attempt
swapoff -a 2>/dev/null || true

parted -s "$TARGET_DISK" mklabel gpt
parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 1024MiB
parted -s "$TARGET_DISK" set 1 esp on
parted -s "$TARGET_DISK" mkpart primary ext4 1024MiB 100%

# The kernel's rule: a disk whose name ends in a digit (nvme0n1, mmcblk0,
# md0, nbd0) names its partitions with a "p".
if [[ "$TARGET_DISK" =~ [0-9]$ ]]; then
  BOOT_PART="${TARGET_DISK}p1"
  ROOT_PART="${TARGET_DISK}p2"
else
  BOOT_PART="${TARGET_DISK}1"
  ROOT_PART="${TARGET_DISK}2"
fi

# Wait for kernel partition table refresh
sleep 1
udevadm settle

mkfs.vfat -F32 "$BOOT_PART"
ROOT_DEV="$ROOT_PART"
if [[ "$ENCRYPT" == "true" ]]; then
  # Passphrase via stdin, never argv.
  printf '%s' "$PASSWORD" | cryptsetup luksFormat --type luks2 --batch-mode --key-file=- "$ROOT_PART"
  printf '%s' "$PASSWORD" | cryptsetup open --key-file=- "$ROOT_PART" cryptroot
  ROOT_DEV=/dev/mapper/cryptroot
fi
mkfs.ext4 -F "$ROOT_DEV"

phase_msg 2 "Mounting filesystems"
mkdir -p /mnt
mount "$ROOT_DEV" /mnt
mkdir -p /mnt/boot
# Root-only ESP: it holds the systemd-boot random seed, which bootctl flags
# as a security hole when world-readable. genfstab carries the options over.
mount -o fmask=0077,dmask=0077 "$BOOT_PART" /mnt/boot

phase_msg 3 "Downloading and installing packages (the long one)"
# A single slow or unreachable mirror ("Operation too slow") aborts pacstrap.
# Re-running it on the same /mnt is safe: already-downloaded packages stay in
# the cache and already-installed ones are skipped, so retry before giving up.
PACSTRAP_ATTEMPTS="${PACSTRAP_ATTEMPTS:-3}"
pacstrap_with_retry() {
  local attempt=1
  while true; do
    if pacstrap "$@"; then
      return 0
    fi
    if (( attempt >= PACSTRAP_ATTEMPTS )); then
      echo "pacstrap failed after $attempt attempts" >&2
      return 1
    fi
    echo "pacstrap attempt $attempt failed; retrying in $((attempt * 10))s" >&2
    phase_msg 3 "A mirror was slow; retrying (attempt $((attempt + 1)) of $PACSTRAP_ATTEMPTS)"
    sleep $((attempt * 10))
    attempt=$((attempt + 1))
  done
}
# pacstrap needs the live system's pacman keyring. pacman-init.service
# creates it, but only after time sync; if that hasn't happened (no NTP, slow
# boot), initialise the keyring here instead of failing with "keyring is not
# writable".
for _ in $(seq 120); do   # let a running pacman-init finish first
  [[ "$(systemctl is-active pacman-init.service 2>/dev/null)" == activating ]] || break
  sleep 1
done
if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg && ! -s /etc/pacman.d/gnupg/pubring.kbx ]] \
   || ! systemctl is-active --quiet pacman-init.service; then
  echo "pacman keyring not initialised by pacman-init.service; initialising it now"
  pacman-key --init
  pacman-key --populate archlinux
fi

live_status_start
pacstrap_with_retry /mnt base linux linux-firmware sudo zsh hyprland sddm uwsm quickshell waybar \
  xdg-desktop-portal-hyprland grim slurp wl-clipboard pipewire pipewire-alsa pipewire-pulse wireplumber \
  foot alacritty ttf-jetbrains-mono-nerd noto-fonts networkmanager rsync gum openssh \
  jq socat fzf bc wtype fastfetch starship playerctl brightnessctl pavucontrol polkit-kde-agent \
  matugen hypridle hyprlock fuzzel cliphist imagemagick libqalculate hyprsunset hyprpaper swaybg \
  qt6-5compat qt6-imageformats qt6-multimedia qt6-multimedia-ffmpeg qt6-virtualkeyboard qt6-quicktimeline qt6-svg qt6-wayland \
  qt6-positioning ttf-material-symbols-variable \
  kirigami kdialog syntax-highlighting chromium libnotify niri xwayland-satellite \
  udiskie inotify-tools xdg-terminal-exec nautilus hyprpicker power-profiles-daemon \
  bluez bluez-utils sof-firmware alsa-utils noto-fonts-emoji wireless-regdb less \
  btop xdg-user-dirs
live_status_stop

genfstab -U /mnt >> /mnt/etc/fstab

phase_msg 4 "Installing FRIDAY and the desktop"
# FRIDAY itself is the friday-git package the ISO was built with (daemon,
# CLI, user service); pacman owns its files, so `pacman -Syu` and a later
# package upgrade work on the installed system.
FRIDAY_PKG=$(find /opt/friday/repo -maxdepth 1 -name 'friday-git-*.pkg.tar.zst' 2>/dev/null | sort | tail -n1)
[[ -n "$FRIDAY_PKG" ]] || { echo "the FRIDAY package is missing from /opt/friday/repo" >&2; exit 1; }
POCKETDESK_PKG=$(find /opt/friday/repo -maxdepth 1 -name 'pocketdesk-*.pkg.tar.zst' 2>/dev/null | sort | tail -n1)
[[ -n "$POCKETDESK_PKG" ]] || { echo "the Pocketdesk package is missing from /opt/friday/repo" >&2; exit 1; }
pacstrap_with_retry -U /mnt "$FRIDAY_PKG" "$POCKETDESK_PKG"
# Updates: each FRIDAY release publishes friday-git to this pacman repo, so
# pacman -Syu keeps FRIDAY current. Packages and the database are signed with
# FRIDAY's release key (shipped in friday-git); pacman trusts that one key and
# refuses anything it didn't sign.
arch-chroot /mnt pacman-key --add /usr/share/friday/friday-signing-key.asc
arch-chroot /mnt pacman-key --lsign-key "$(cat /mnt/usr/share/friday/friday-signing-key.fpr)"
cat >>/mnt/etc/pacman.conf <<'PACMAN'

[friday]
SigLevel = Required DatabaseRequired
Server = https://github.com/sreevarshan-xenoz/project-friday/releases/download/pacman
PACMAN
mkdir -p /mnt/usr/bin
# Omarchy's scripts expect /usr/bin/omarchy-* (its package's layout): its
# env-bootstrap only adds /usr/share/omarchy/bin to PATH in dev-link mode, so
# without these login shells (a console, SSH) can't find omarchy-* commands.
for f in /usr/share/omarchy/bin/omarchy*; do
  ln -sf "/usr/share/omarchy/bin/${f##*/}" "/mnt/usr/bin/${f##*/}"
done
ln -sf friday /mnt/usr/bin/friday-os

mkdir -p /mnt/usr/share/omarchy
rsync -a /usr/share/omarchy/ /mnt/usr/share/omarchy/
# The lock screen (friday.lock, like Omarchy's) authenticates through
# /etc/pam.d/omarchy-lock-password and refuses to lock without it. Omarchy's
# own installer writes it (install/config/lockscreen-pam.sh); this is that step.
arch-chroot /mnt env OMARCHY_PATH=/usr/share/omarchy PATH=/usr/share/omarchy/bin:/usr/bin omarchy-apply-lock >/dev/null \
  || echo "warning: could not set up lock screen authentication (run omarchy-apply-lock after login)" >&2

# The FRIDAY OS desktop (the package owns the rest of /usr/share/friday).
if [ -d /usr/share/friday/dots-hyprland ]; then
  mkdir -p /mnt/usr/share/friday
  rsync -a /usr/share/friday/dots-hyprland /mnt/usr/share/friday/
fi

rsync -a /etc/sddm.conf* /mnt/etc/ 2>/dev/null || true
rsync -a /etc/sddm.conf.d/ /mnt/etc/sddm.conf.d/ 2>/dev/null || true
rsync -a /etc/sysctl.d/ /mnt/etc/sysctl.d/ 2>/dev/null || true
rsync -a /etc/skel/ /mnt/etc/skel/ 2>/dev/null || true
rsync -a /etc/fastfetch/ /mnt/etc/fastfetch/ 2>/dev/null || true
rsync -a /etc/plymouth/ /mnt/etc/plymouth/ 2>/dev/null || true
rsync -a /etc/profile.d/ /mnt/etc/profile.d/ 2>/dev/null || true
cp -p /etc/os-release /mnt/etc/os-release 2>/dev/null || true
cp -p /etc/motd /mnt/etc/motd 2>/dev/null || true

# System branding and session links
mkdir -p /mnt/usr/share/wayland-sessions
cp -p /usr/share/wayland-sessions/* /mnt/usr/share/wayland-sessions/ 2>/dev/null || true

mkdir -p /mnt/usr/share/sddm/themes
rsync -a /usr/share/sddm/themes/ /mnt/usr/share/sddm/themes/ 2>/dev/null || true

mkdir -p /mnt/usr/share/fonts
rsync -a /usr/share/fonts/ /mnt/usr/share/fonts/ 2>/dev/null || true

mkdir -p /mnt/usr/share/plymouth/themes
cp -r /usr/share/plymouth/themes/omarchy /mnt/usr/share/plymouth/themes/ 2>/dev/null || true
# Omarchy's splash (progress bar and disk-password prompt) with FRIDAY's mark.
cp -f /usr/share/friday-installer/plymouth-logo.png /mnt/usr/share/plymouth/themes/omarchy/logo.png 2>/dev/null || true

phase_msg 5 "Creating $USERNAME and applying your theme"
# Hostname & Locales
echo "$HOSTNAME" > /mnt/etc/hostname
echo "LANG=en_US.UTF-8" > /mnt/etc/locale.conf
echo "en_US.UTF-8 UTF-8" >> /mnt/etc/locale.gen
arch-chroot /mnt locale-gen 2>/dev/null || true

# Keyboard: the chosen console keymap and its desktop layout, as localectl
# would set them. vconsole.conf serves the console, the disk-unlock prompt
# (it is in place before mkinitcpio runs) and Hyprland (Omarchy's input.lua
# reads XKBLAYOUT/XKBVARIANT); 00-keyboard.conf serves localed, so niri and
# the login screen type the same.
read -r XKB_LAYOUT XKB_MODEL XKB_VARIANT XKB_OPTIONS < <(friday_xkb_for_keymap "$KEYBOARD")
[[ "$XKB_VARIANT" == "-" ]] && XKB_VARIANT=""
[[ "$XKB_OPTIONS" == "-" ]] && XKB_OPTIONS=""
cat << EOF_VCONSOLE > /mnt/etc/vconsole.conf
KEYMAP=$KEYBOARD
XKBLAYOUT=$XKB_LAYOUT
XKBMODEL=$XKB_MODEL
XKBVARIANT=$XKB_VARIANT
XKBOPTIONS=$XKB_OPTIONS
EOF_VCONSOLE
mkdir -p /mnt/etc/X11/xorg.conf.d
cat << EOF_XKB > /mnt/etc/X11/xorg.conf.d/00-keyboard.conf
# Written by the FRIDAY OS installer; change it with localectl set-x11-keymap.
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "$XKB_LAYOUT"
        Option "XkbModel" "$XKB_MODEL"
        Option "XkbVariant" "$XKB_VARIANT"
        Option "XkbOptions" "$XKB_OPTIONS"
EndSection
EOF_XKB

# Timezone
arch-chroot /mnt ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime 2>/dev/null || true

# Display manager & services
mkdir -p /mnt/etc/systemd/system
ln -sf /usr/lib/systemd/system/sddm.service /mnt/etc/systemd/system/display-manager.service
arch-chroot /mnt systemctl enable NetworkManager 2>/dev/null || true
arch-chroot /mnt systemctl enable sddm 2>/dev/null || true
arch-chroot /mnt systemctl enable bluetooth 2>/dev/null || true

# FRIDAY systemd user daemon
# (enabled for every user, like `systemctl --global enable`)
mkdir -p /mnt/etc/systemd/user/default.target.wants
ln -sf /usr/lib/systemd/user/friday-linux-daemon.service \
  /mnt/etc/systemd/user/default.target.wants/friday-linux-daemon.service

# Debug-only access: serial root autologin + open root SSH. Never on by default —
# an installed system must not accept unauthenticated or root logins over the network.
if [ "$FRIDAY_DEBUG_ACCESS" = "true" ]; then
  mkdir -p /mnt/etc/systemd/system/serial-getty@ttyS0.service.d
  cat << 'EOF_SERIAL' > /mnt/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin root -s %I 115200,38400,9600 vt220
EOF_SERIAL

  mkdir -p /mnt/etc/ssh/sshd_config.d
  cat << 'EOF_SSH' > /mnt/etc/ssh/sshd_config.d/10-friday.conf
PasswordAuthentication yes
PermitRootLogin yes
PermitEmptyPasswords yes
EOF_SSH
  arch-chroot /mnt systemctl enable sshd 2>/dev/null || true
fi

# Create Admin User
USER_HOME="/home/$USERNAME"
if [ "$USERNAME" != "root" ]; then
  arch-chroot /mnt useradd -m -G wheel,video,audio,input,storage -s /bin/zsh "$USERNAME" 2>/dev/null || true
else
  USER_HOME="/root"
fi
echo "$USERNAME:$PASSWORD" | arch-chroot /mnt chpasswd
# Root stays locked: the person administers with sudo (wheel). Only the VM
# debug access below gets a root password, for SSH into a test install.
if [ "$FRIDAY_DEBUG_ACCESS" = "true" ] || [ "$USERNAME" = "root" ]; then
  echo "root:$PASSWORD" | arch-chroot /mnt chpasswd
else
  arch-chroot /mnt passwd -l root
fi
mkdir -p /mnt/etc/sudoers.d
echo "%wheel ALL=(ALL:ALL) ALL" > /mnt/etc/sudoers.d/wheel
chmod 440 /mnt/etc/sudoers.d/wheel

# Populate User Home from /etc/skel
mkdir -p "/mnt$USER_HOME"
rsync -a /mnt/etc/skel/. "/mnt$USER_HOME/" 2>/dev/null || true
if [ "$USERNAME" != "root" ]; then
  mkdir -p /mnt/root
  rsync -a /mnt/etc/skel/. /mnt/root/ 2>/dev/null || true
fi
# rsync -a ran as root and copied skel's own ownership, home directory
# included. Hand the home to the user now: the theme step below runs as
# the user and cannot write to a root-owned home.
# What the person let FRIDAY do (setup's FEATURES step); defaults write nothing.
friday_write_features "/mnt$USER_HOME/.config/friday"
echo "FRIDAY features: desktop=$FEAT_DESKTOP tasks=$FEAT_TASKS appname=$FEAT_APPNAME screentext=$FEAT_SCREENTEXT"

if [ "$USERNAME" != "root" ]; then
  arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "$USER_HOME"
fi

# Deploy Theme Selection
if [[ "$THEME" =~ "Dots-Hyprland" ]]; then
  if [ -d /mnt/usr/share/friday/dots-hyprland ]; then
    rsync -a /mnt/usr/share/friday/dots-hyprland/.config/ /mnt/etc/skel/.config/ 2>/dev/null || true
    rsync -a /mnt/usr/share/friday/dots-hyprland/.local/ /mnt/etc/skel/.local/ 2>/dev/null || true
    rsync -a /mnt/usr/share/friday/dots-hyprland/.config/ "/mnt$USER_HOME/.config/" 2>/dev/null || true
    rsync -a /mnt/usr/share/friday/dots-hyprland/.local/ "/mnt$USER_HOME/.local/" 2>/dev/null || true
    if [ "$USERNAME" != "root" ]; then
      rsync -a /mnt/usr/share/friday/dots-hyprland/.config/ /mnt/root/.config/ 2>/dev/null || true
      rsync -a /mnt/usr/share/friday/dots-hyprland/.local/ /mnt/root/.local/ 2>/dev/null || true
    fi
    # Its Hyprland config says kb_layout "us": type with the system layout
    # instead (vconsole.conf, set above and by localectl), in its custom file.
    for dots_home in /mnt/etc/skel "/mnt$USER_HOME" /mnt/root; do
      [[ -d "$dots_home/.config/hypr/custom" ]] || continue
      cat << 'EOF_DOTS_KB' >> "$dots_home/.config/hypr/custom/general.lua"

-- FRIDAY OS: the system keyboard layout (localectl set-keymap changes it).
do
    local kb = {}
    local f = io.open("/etc/vconsole.conf", "r")
    if f then
        for line in f:lines() do
            local k, v = line:match('^%s*([%w_]+)%s*=%s*"?([^"]*)"?%s*$')
            if k then kb[k] = v end
        end
        f:close()
    end
    if kb.XKBLAYOUT and kb.XKBLAYOUT ~= "" then
        hl.config({ input = {
            kb_layout = kb.XKBLAYOUT,
            kb_variant = kb.XKBVARIANT or "",
            kb_options = kb.XKBOPTIONS or "",
        } })
    end
end
EOF_DOTS_KB
    done
  fi

  cat << 'EOF_FRIDAY_SESSION' > /mnt/usr/share/wayland-sessions/friday.desktop
[Desktop Entry]
Name=FRIDAY OS (Dots Hyprland)
Comment=FRIDAY OS Cognitive Desktop with Material You Quickshell
Exec=/usr/bin/start-hyprland
TryExec=/usr/bin/start-hyprland
Type=Application
DesktopNames=Hyprland
EOF_FRIDAY_SESSION

  cp -p /mnt/usr/share/wayland-sessions/friday.desktop /mnt/usr/share/wayland-sessions/hyprland.desktop 2>/dev/null || true
else
  # Every other option is FRIDAY Shell on Omarchy's Hyprland config. The
  # FRIDAY Shell option uses FRIDAY's own colours; the named themes colour
  # FRIDAY Shell from the Omarchy theme.
  THEME_SLUG="matte-black"; SHELL_PALETTE="classic"
  case "$THEME" in
    *"FRIDAY Shell Frost"*) THEME_SLUG="matte-black"; SHELL_PALETTE="frost" ;;
    *"FRIDAY Shell Moss"*)  THEME_SLUG="matte-black"; SHELL_PALETTE="moss" ;;
    *"FRIDAY Shell Dawn"*)  THEME_SLUG="matte-black"; SHELL_PALETTE="dawn" ;;
    *"FRIDAY Shell"*) THEME_SLUG="matte-black"; SHELL_PALETTE="ember" ;;
    *"Tokyo Night"*)  THEME_SLUG="tokyo-night" ;;
    *"Catppuccin"*)   THEME_SLUG="catppuccin" ;;
    *"Nord"*)         THEME_SLUG="nord" ;;
  esac
  # A login shell outside the desktop session has neither OMARCHY_PATH nor
  # Omarchy's bin/ on PATH (uwsm sets both at login), so pass them here.
  # omarchy-theme-set exits 0 even when it fails, so check what it left.
  arch-chroot /mnt su - "$USERNAME" -c \
    "OMARCHY_PATH=/usr/share/omarchy PATH=/usr/share/omarchy/bin:\$PATH omarchy-theme-set '$THEME_SLUG'" || true
  if [[ ! -s "/mnt$USER_HOME/.local/state/omarchy/current/theme.name" ]]; then
    echo "warning: could not apply the $THEME_SLUG theme (run omarchy-theme-set $THEME_SLUG after login)" >&2
  fi

  # FRIDAY Shell draws the bar, notifications and OSD, so Omarchy's shell turns
  # those off (friday.bar is an empty bar option), and friday.lock replaces
  # Omarchy's lock screen. Its user shell.json replaces
  # the defaults wholesale, so start from the pinned defaults.
  mkdir -p "/mnt$USER_HOME/.config/omarchy" "/mnt$USER_HOME/.config/friday"
  # Omarchy's screensaver needs ttfx, which is in Omarchy's package repo,
  # not Arch's; without it the screen fills with "command not found". Put it
  # a day out, so the 5-minute lock always comes first (and it's skipped
  # while locked).
  if jq '.bar.id = "friday.bar" | .idle.screensaver = 86400
         | .disabledPlugins = (((.disabledPlugins // []) + ["omarchy.notifications", "omarchy.osd", "omarchy.lock"]) | unique)' \
       /mnt/usr/share/omarchy/config/omarchy/shell.json >"/mnt$USER_HOME/.config/omarchy/shell.json.new"; then
    mv "/mnt$USER_HOME/.config/omarchy/shell.json.new" "/mnt$USER_HOME/.config/omarchy/shell.json"
  else
    rm -f "/mnt$USER_HOME/.config/omarchy/shell.json.new"
    echo "warning: could not write Omarchy shell.json; Omarchy's bar stays on" >&2
  fi
  case "$SHELL_STYLE" in
    Island*) SHELL_STYLE_ID=island ;;
    Dock*)   SHELL_STYLE_ID=dock ;;
    *)       SHELL_STYLE_ID=ember ;;
  esac
  printf '{\n  "style": "%s",\n  "palette": "%s"\n}\n' "$SHELL_STYLE_ID" "$SHELL_PALETTE" \
    >"/mnt$USER_HOME/.config/friday/shell.json"
  # Windows' gaps, corners and borders to match (~/.config/friday/hypr-look.lua),
  # written as the user, who must own the directory first.
  arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "$USER_HOME/.config/friday"
  arch-chroot /mnt su - "$USERNAME" -c "friday shell style '$SHELL_STYLE_ID'" >/dev/null \
    || echo "warning: could not write the window look (run friday shell style $SHELL_STYLE_ID after login)" >&2
fi

# FRIDAY AI provider credentials, loaded by friday-linux-daemon.service via
# EnvironmentFile. Owner-only (0600); the key is never echoed so it stays out of $LOG_FILE.
AI_KEY_VAR=""
AI_VISION=false
case "$FRIDAY_AI_PROVIDER" in
  opencode)   AI_KEY_VAR="OPENCODE_API_KEY";   AI_VISION=true ;;
  gemini)     AI_KEY_VAR="GEMINI_API_KEY";     AI_VISION=true ;;
  groq)       AI_KEY_VAR="GROQ_API_KEY";       AI_VISION=true ;;
  nvidia-nim) AI_KEY_VAR="NVIDIA_NIM_API_KEY"; AI_VISION=true ;;
  openrouter) AI_KEY_VAR="OPENROUTER_API_KEY" ;;
  cerebras)   AI_KEY_VAR="CEREBRAS_API_KEY" ;;
esac
if [[ -n "$AI_KEY_VAR" && -n "$FRIDAY_AI_KEY" ]]; then
  (
    umask 077
    mkdir -p "/mnt$USER_HOME/.config/friday"
    {
      echo "# FRIDAY AI provider credentials (written by the installer)."
      printf '%s=%s\n' "$AI_KEY_VAR" "$FRIDAY_AI_KEY"
      # Screen-context reads need a provider with a vision model.
      if $AI_VISION; then echo "FRIDAY_CONTEXT_PROVIDER=$FRIDAY_AI_PROVIDER"; fi
    } > "/mnt$USER_HOME/.config/friday/friday.env"
  )
  echo "FRIDAY AI provider configured: $FRIDAY_AI_PROVIDER"
else
  echo "No AI key: FRIDAY uses OpenCode Zen's free models (change with: friday setup-ai)."
fi

if [ "$USERNAME" != "root" ]; then
  arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "$USER_HOME" 2>/dev/null || true
fi

# Configure SDDM Greeter Theme Architecture
SDDM_THEME_ID="silent-friday"
case "$SDDM_THEME" in
  *"FRIDAY Edition"*)
    SDDM_THEME_ID="silent-friday"
    ;;
  *"Classic"*)
    SDDM_THEME_ID="silent"
    sed -i 's|^ConfigFile=.*|ConfigFile=configs/default.conf|' /mnt/usr/share/sddm/themes/silent/metadata.desktop 2>/dev/null || true
    ;;
  *"Rei"*)
    SDDM_THEME_ID="silent"
    sed -i 's|^ConfigFile=.*|ConfigFile=configs/rei.conf|' /mnt/usr/share/sddm/themes/silent/metadata.desktop 2>/dev/null || true
    ;;
  *"Ken"*)
    SDDM_THEME_ID="silent"
    sed -i 's|^ConfigFile=.*|ConfigFile=configs/ken.conf|' /mnt/usr/share/sddm/themes/silent/metadata.desktop 2>/dev/null || true
    ;;
  *"Nord"*)
    SDDM_THEME_ID="silent"
    sed -i 's|^ConfigFile=.*|ConfigFile=configs/nord.conf|' /mnt/usr/share/sddm/themes/silent/metadata.desktop 2>/dev/null || true
    ;;
  *"Classic SDDM"*)
    SDDM_THEME_ID="omarchy"
    ;;
  *)
    SDDM_THEME_ID="silent-friday"
    ;;
esac

mkdir -p /mnt/etc/sddm.conf.d
cat << EOF_SDDM_THEME > /mnt/etc/sddm.conf.d/10-theme.conf
[Theme]
Current=$SDDM_THEME_ID

[General]
InputMethod=qtvirtualkeyboard
GreeterEnvironment=QML2_IMPORT_PATH=/usr/share/sddm/themes/$SDDM_THEME_ID/components/,QT_IM_MODULE=qtvirtualkeyboard
EOF_SDDM_THEME
cp -p /mnt/etc/sddm.conf.d/10-theme.conf /mnt/etc/sddm.conf

rm -f /mnt/etc/sddm.conf.d/autologin.conf
# The desktop to start: the chosen window manager (niri only with FRIDAY
# Shell; the Dots-Hyprland desktop is Hyprland's). The other stays at the
# login screen.
SESSION_FILE=hyprland.desktop
if [[ "$SESSION" == niri* && "$THEME" != *"Dots-Hyprland"* ]]; then SESSION_FILE=niri.desktop; fi
if [[ "$AUTOLOGIN" == "true" ]]; then
  cat << EOF_SDDM_AUTO > /mnt/etc/sddm.conf.d/autologin.conf
[Autologin]
User=$USERNAME
Session=$SESSION_FILE
Relogin=false
EOF_SDDM_AUTO
fi
# SDDM preselects the last session: start it at the chosen one.
mkdir -p /mnt/var/lib/sddm
cat << EOF_SDDM_STATE > /mnt/var/lib/sddm/state.conf
[Last]
Session=/usr/share/wayland-sessions/$SESSION_FILE
User=$USERNAME
EOF_SDDM_STATE
arch-chroot /mnt chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true

mkdir -p /mnt/var/lib/omarchy/provisioning
cat << EOF_INFO > /mnt/var/lib/omarchy/provisioning/install-info.json
{
  "hostname": "$HOSTNAME",
  "username": "$USERNAME",
  "timezone": "$TIMEZONE",
  "keyboard": "$KEYBOARD",
  "theme": "$THEME",
  "sddm_theme": "$SDDM_THEME"
}
EOF_INFO

phase_msg 6 "Installing the bootloader"
bootctl --path=/mnt/boot install
cat << EOF_LOADER > /mnt/boot/loader/loader.conf
default arch.conf
timeout 2
EOF_LOADER

if [[ "$ENCRYPT" == "true" ]]; then
  LUKS_UUID=$(cryptsetup luksUUID "$ROOT_PART")
  [[ -n "$LUKS_UUID" ]] || { echo "Could not read the LUKS UUID of $ROOT_PART." >&2; false; }
  ROOT_OPTIONS=$(friday_add_crypt_hook /mnt/etc/mkinitcpio.conf "$LUKS_UUID" cryptroot)
  arch-chroot /mnt mkinitcpio -P
else
  ROOT_PARTUUID=$(blkid -s PARTUUID -o value "$ROOT_PART")
  if [[ -z "$ROOT_PARTUUID" ]]; then
    echo "Could not read the PARTUUID of $ROOT_PART; the boot entry would be unbootable." >&2
    false
  fi
  ROOT_OPTIONS="root=PARTUUID=$ROOT_PARTUUID"
fi
cat << EOF_ENTRY > /mnt/boot/loader/entries/arch.conf
title   FRIDAY OS
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options $ROOT_OPTIONS rw console=ttyS0,115200 console=tty1
EOF_ENTRY

chmod +x /root/configurator /root/installer

exec 1>&3 2>&4
trap - ERR
live_status_stop

friday_banner "SYSTEM ASSEMBLY COMPLETE"
friday_rail 7 "${INSTALL_STEPS[@]}"
gum style --foreground "$FRIDAY_SUCCESS" --border "$FRIDAY_BORDER_STYLE" --border-foreground "$FRIDAY_BORDER" \
  --align center --width 64 --padding "1 2" --margin "0 0 0 $(( ($(tput cols 2>/dev/null || echo 80) - 64) / 2 ))" \
  "FRIDAY OS is installed on $TARGET_DISK" \
  "in $(elapsed)." \
  "" \
  "Sign in as $USERNAME on $HOSTNAME." \
  "Press Super+Y any time to ask me something." \
  "" \
  "Remove the USB stick before you restart."
echo
friday_say "All done, $USERNAME. Remove the USB stick and I'll see you on the other side."
echo

if [[ "$AUTO_REBOOT" == "true" ]]; then
  echo "Rebooting into FRIDAY OS in 3 seconds..."
  sleep 3
  umount -R /mnt 2>/dev/null || true
  reboot
elif [[ "${FRIDAY_INTERACTIVE:-0}" == "1" ]]; then
  friday_speak "FRIDAY OS is installed. Restart whenever you're ready."
  if gum confirm --affirmative="Reboot now" --negative="Stay in the live system" "Restart into FRIDAY OS?"; then
    umount -R /mnt 2>/dev/null || true
    systemctl reboot
  fi
fi
