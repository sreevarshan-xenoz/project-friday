#!/usr/bin/env bash
# FRIDAY Live ISO interactive configurator.
# Collects the install specification, then hands off to /root/installer.
# Every step validates its input and loops on mistakes; the review screen can
# jump back to any step; leaving never strands tty1 on a blank screen.
set -uo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"
# shellcheck source=friday-tui.sh
source "$(dirname "$(readlink -f "$0")")/friday-tui.sh"
friday_console_theme

STEPS=(NETWORK DISK REGION IDENTITY SECURITY LOOK FEATURES BROWSERS AI REVIEW)

# Defaults (also what an unattended run would use).
TARGET_DISK="" TARGET_LABEL=""
INSTALL_MODE="erase" FRIDAY_SIZE_MB="" BOOT_DEFAULT="friday" ALONGSIDE_OS="" BITLOCKER_ACK=""
# Empty until named, so typing replaces the placeholder (empty input means "friday").
HOSTNAME="" USERNAME="" PASSWORD=""
KEYBOARD="us" TIMEZONE="UTC"
THEME="FRIDAY Shell Core (obsidian and core red; the FRIDAY OS look)"
SHELL_STYLE="Lean (thin borders, small gaps, no blur; the FRIDAY OS look)"
SESSION="Hyprland (tiling, the FRIDAY OS default)"
SDDM_THEME="SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)"
BROWSERS=""
DEFAULT_BROWSER="chromium"
FRIDAY_AI_PROVIDERS="" FRIDAY_AI_KEYS=""
FRIDAY_LOCAL_ENGINE="" FRIDAY_LOCAL_BUDGET_MB="" FRIDAY_LOCAL_MODEL="" FRIDAY_LOCAL_LABEL=""
AUTOLOGIN="false"
ENCRYPT="true"
FRIDAY_AI_LABEL="OpenCode Zen free models (no key)"

screen() { # screen <step-index> [subtitle]
  friday_header "${2:-SETUP}"
  friday_rail "$1" "${STEPS[@]}"
}

# Never leave tty1 dead: always end in a menu.
leave_menu() {
  local why="${1:-}"
  while true; do
    friday_banner "SETUP PAUSED"
    [[ -n "$why" ]] && friday_say "$why"
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" "Start setup again" "Open a shell" "Reboot" "Power off")" in
      "Start setup again") exec "$0" ;;
      "Open a shell")
        friday_note "Type 'exit' to come back to setup."
        bash -l || true ;;
      "Reboot") systemctl reboot ;;
      "Power off") systemctl poweroff ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------------ steps

step_welcome() {
  friday_banner
  friday_say "Hello. I'm FRIDAY."
  friday_say "I'll ask you a few questions, then build your system while you grab a coffee."
  friday_say "It usually takes 15 to 30 minutes, depending on your connection."
  echo
  gum confirm --affirmative="Let's begin" --negative="Not now" "Ready?" || leave_menu "Whenever you're ready."
  # FRIDAY OS boots with systemd-boot, which needs UEFI: say so now, before
  # any question, rather than after the disk has been erased.
  if [[ ! -d /sys/firmware/efi && -z "${FRIDAY_ASSUME_UEFI:-}" ]]; then
    leave_menu "This computer started in legacy BIOS mode, and FRIDAY OS needs UEFI. Turn on UEFI boot in the firmware settings, then start the installer again."
  fi
}

connect_wifi() {
  local dev ssid pass
  dev=$(basename "$(dirname "$(ls -d /sys/class/net/*/wireless 2>/dev/null | head -n1)")" 2>/dev/null)
  if [[ -z "$dev" || "$dev" == "." ]]; then
    friday_err "No Wi-Fi adapter found. Plug in an Ethernet cable instead."
    sleep 2
    return 1
  fi
  gum spin --spinner dot --title "Scanning for networks on $dev…" -- \
    bash -c "iwctl station '$dev' scan >/dev/null 2>&1; sleep 4"
  ssid=$( { iw dev "$dev" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p'
            iwctl station "$dev" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
              | awk 'NR>4 && NF>=3 {sub(/^[ >]+/,""); $(NF)=""; $(NF-1)=""; sub(/[ ]+$/,""); print}'
          } | grep -v '^$' | sort -u | gum filter --placeholder "Choose a network (type to search)" ) || return 1
  [[ -n "$ssid" ]] || return 1
  pass=$(gum input --password --placeholder "Password for $ssid (empty for open network)") || return 1
  if [[ -n "$pass" ]]; then
    gum spin --spinner dot --title "Connecting to $ssid…" -- \
      iwctl --passphrase "$pass" station "$dev" connect "$ssid"
  else
    gum spin --spinner dot --title "Connecting to $ssid…" -- iwctl station "$dev" connect "$ssid"
  fi
  sleep 3
}

# Optional: FRIDAY talks through the install. The voice (about 100 MB) is
# downloaded into RAM for this session only; nothing is kept on the new system.
offer_voice() {
  [[ -e "$FRIDAY_LIVE_VOICE/on" ]] && return 0
  command -v friday-ctl >/dev/null || return 0
  gum confirm --default=No --affirmative="Yes, talk to me" --negative="No, stay quiet" \
    "Want me to talk you through the install? (downloads a small voice, about 100 MB)" || return 0
  livecd-sound -u >/dev/null 2>&1 || true
  mkdir -p "$FRIDAY_LIVE_VOICE"
  if gum spin --spinner dot --title "Getting my voice…" -- \
    env FRIDAY_VOICE_DIR="$FRIDAY_LIVE_VOICE" friday-ctl say --setup kitten; then
    : >"$FRIDAY_LIVE_VOICE/on"
    friday_say "That's me. I'll keep you posted as we go."
  else
    friday_warn "I couldn't get the voice. Carrying on quietly."
  fi
}

step_network() {
  while true; do
    screen 1
    friday_head "Network"
    if gum spin --spinner dot --title "Checking the internet connection…" -- bash -c "$(declare -f friday_online); friday_online"; then
      friday_ok "Online. I'll download the latest packages during install."
      offer_voice
      sleep 1
      return
    fi
    friday_warn "I can't reach the package mirrors, and I need them to install."
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" "Connect to Wi-Fi" "Check again (I plugged in a cable)" "Open a shell to fix it" "Quit setup")" in
      "Connect to Wi-Fi") connect_wifi || true ;;
      "Check again"*) ;;
      "Open a shell"*) friday_note "Type 'exit' when done."; bash -l || true ;;
      *) leave_menu "Setup needs a network connection." ;;
    esac
  done
}

step_disk() {
  screen 2
  local boot_dev name type size model fstypes
  boot_dev=$(friday_live_disk)
  local labels=()
  while read -r name type size model; do
    [[ "$type" == "disk" && ! "$name" =~ ^(fd|loop|ram|sr|zram) ]] || continue
    [[ -n "$boot_dev" && "/dev/$name" == "$boot_dev" ]] && continue
    fstypes=$(lsblk -n -o FSTYPE "/dev/$name" 2>/dev/null | grep -v '^$' | sort -u | paste -sd, -)
    labels+=("/dev/$name │ $size │ ${model:-unknown model}${fstypes:+ │ has: $fstypes}")
  done < <(lsblk -d -n -o NAME,TYPE,SIZE,MODEL)

  if (( ${#labels[@]} == 0 )); then
    leave_menu "I couldn't find a disk to install onto (the USB stick I booted from is excluded). On a laptop whose storage is in Intel RST/RAID mode, Linux can't see the disk: don't switch it to AHCI without preparing Windows first."
  fi
  [[ -n "$boot_dev" ]] && friday_note "  Your boot USB ($boot_dev) is protected and not listed."
  friday_head "Where should FRIDAY live?"
  TARGET_LABEL=$(printf '%s\n' "${labels[@]}" | gum choose --cursor="$FRIDAY_CURSOR" --height=8) || leave_menu
  TARGET_DISK=$(awk -F'│' '{print $1}' <<<"$TARGET_LABEL" | xargs)
  step_disk_mode
}

# Erase the disk, or (when it already holds a system and has free space)
# install alongside it. Sets INSTALL_MODE, FRIDAY_SIZE_MB, BOOT_DEFAULT.
step_disk_mode() {
  INSTALL_MODE=erase FRIDAY_SIZE_MB="" BOOT_DEFAULT=friday BITLOCKER_ACK=""
  local scan table parts free esp esp_free windows others bitlocker os
  scan=$(friday_disk_scan "$TARGET_DISK")
  get() { sed -n "s/^$1=//p" <<<"$scan"; }
  table=$(get table) parts=$(get parts) free=$(get free_mb) esp=$(get esp)
  esp_free=$(get esp_free_mb) windows=$(get windows) others=$(get others) bitlocker=$(get bitlocker)
  if (( ${parts:-0} == 0 )); then
    friday_note "  The disk is empty: FRIDAY gets all of it."
    return 0
  fi
  os="the system on it"
  [[ "$windows" == 1 ]] && os="Windows"
  [[ "$windows" != 1 && -n "$others" ]] && os="$others"
  echo
  friday_say "This disk already has $os on it."
  local why=""
  if [[ "$table" != gpt ]]; then
    why="it uses the old MBR partition style, and FRIDAY installs alongside only on GPT disks"
  elif [[ -z "$esp" ]]; then
    why="it has no EFI partition to share for the start menu"
  elif (( ${esp_free:-0} < 5 )); then
    why="its EFI partition is full (FRIDAY's start menu needs about 5 MB there)"
  elif (( ${free:-0} < FRIDAY_MIN_MB )); then
    why="it has $(friday_gb "${free:-0}") of free space, and FRIDAY needs at least $(friday_gb "$FRIDAY_MIN_MB")"
  fi
  local keep
  keep="Install alongside $os (uses the $(friday_gb "${free:-0}") of free space)"
  local choices=()
  if [[ -z "$why" ]]; then
    choices+=("$keep")
  else
    friday_warn "I can't put FRIDAY next to $os: $why."
    [[ "$windows" == 1 ]] && (( ${free:-0} < FRIDAY_MIN_MB )) && [[ "$table" == gpt ]] && {
      friday_note "  To make room, start Windows, open Disk Management (right-click Start),"
      friday_note "  right-click C: › Shrink Volume, shrink it by 60 GB or more, then start setup again."
    }
  fi
  choices+=("Erase the whole disk (removes $os and everything on it)" "Pick another disk" "Quit setup (nothing is written)")
  case "$(printf '%s\n' "${choices[@]}" | gum choose --cursor="$FRIDAY_CURSOR")" in
    "$keep") ;;
    Erase*) return 0 ;;
    "Pick another disk") step_disk; return ;;
    *) leave_menu "Nothing was written to disk." ;;
  esac
  INSTALL_MODE=alongside
  if [[ "$bitlocker" == 1 ]]; then
    echo
    friday_warn "$os's drive is encrypted with BitLocker."
    friday_note "  After FRIDAY is installed (and with Secure Boot off), Windows may stop at start and ask"
    friday_note "  for its 48-digit recovery key. Without it, Windows and its files stay locked."
    friday_note "  Get the key first (aka.ms/myrecoverykey), or turn BitLocker off in Windows and come back."
    gum confirm --default=false --affirmative="I have the key (or BitLocker is off)" --negative="Stop, I'll get it" \
      "Carry on?" || leave_menu "Nothing was written. Get the BitLocker recovery key (or turn BitLocker off), then start setup again."
    BITLOCKER_ACK=1
  fi
  [[ "$windows" == 1 ]] && friday_note "  Shut Windows down fully before installing (turn off Fast Startup), or its drive stays locked."
  step_disk_size "$free"
  echo
  friday_head "When the computer starts"
  case "$(gum choose --cursor="$FRIDAY_CURSOR" \
      "$os starts as it does now; pick FRIDAY OS from the boot menu key (the next restart goes to FRIDAY once)" \
      "FRIDAY's menu every time, with $os in it")" in
    FRIDAY*) BOOT_DEFAULT=friday ;;
    *) BOOT_DEFAULT=other ;;
  esac
  ALONGSIDE_OS="$os"
}

# How much of the free space FRIDAY gets, with advice on the size.
step_disk_size() {
  local free="$1" model=0 rec v mb advice presets
  # The biggest local model this computer can run (local-ai presets know).
  presets=$(FRIDAY_DISK_FREE_MB="$free" friday local-ai presets 2>/dev/null) || presets=""
  model=$(awk -F'|' '$8 == 1 && $5 ~ /^[0-9]+$/ && $5 > m { m = $5 } END { print m + 0 }' <<<"$presets")
  rec=$(friday_size_recommend "$free" "$model")
  echo
  friday_head "How much space for FRIDAY?"
  friday_note "  Free: $(friday_gb "$free"). At least 40 GB; 60 to 80 GB is comfortable;"
  (( model > 0 )) && friday_note "  local AI on this computer adds its model ($(friday_gb "$model")) and room to update it."
  friday_note "  I'd use $(friday_gb "$rec"). What's left stays free for the other system."
  while true; do
    v=$(gum input --value="$(( rec / 1024 ))" --prompt="Size in GB › " --placeholder="$(( rec / 1024 ))") || leave_menu
    v="${v// /}"; v="${v%[Gg][Bb]}"; v="${v%[Gg]}"
    [[ "$v" =~ ^[0-9]+$ ]] || { friday_err "A number of GB, like $(( rec / 1024 ))."; continue; }
    mb=$(( v * 1024 ))
    if ! advice=$(friday_size_advice "$mb" "$free" "$model"); then
      friday_err "$advice"
      continue
    fi
    case "$advice" in Good*) friday_ok "$advice" ;; *) friday_warn "$advice" ;; esac
    gum confirm --affirmative="Use $v GB" --negative="Change it" "$(friday_gb $(( free - mb ))) stays free. Use $v GB?" || continue
    FRIDAY_SIZE_MB=$mb
    return 0
  done
}

step_identity() {
  screen 4
  friday_head "Name your machine and yourself"
  local v
  while true; do
    v=$(gum input --value="$HOSTNAME" --prompt="Computer name › " --placeholder="friday") || leave_menu
    v=$(tr '[:upper:]' '[:lower:]' <<<"${v:-friday}")
    friday_valid_hostname "$v" && { HOSTNAME="$v"; break; }
    friday_err "Use lowercase letters, digits and hyphens (no spaces), up to 63 characters."
  done
  friday_ok "Computer name: $HOSTNAME"
  while true; do
    v=$(gum input --value="$USERNAME" --prompt="Your username › " --placeholder="friday") || leave_menu
    v="${v:-friday}"
    friday_valid_username "$v" && { USERNAME="$v"; break; }
    friday_err "Start with a lowercase letter; then lowercase letters, digits, - or _. System names like root are taken."
  done
  friday_ok "Username: $USERNAME"
}

step_security() {
  screen 5
  friday_head "Choose a password for $USERNAME"
  friday_note "  It's also used for sudo."
  local p1 p2
  while true; do
    p1=$(gum input --password --prompt="Password › ") || leave_menu
    if [[ -z "$p1" ]]; then friday_err "The password can't be empty."; continue; fi
    p2=$(gum input --password --prompt="Again › ") || leave_menu
    if [[ "$p1" != "$p2" ]]; then friday_err "Those didn't match. Let's try again."; continue; fi
    if (( ${#p1} < 6 )); then
      gum confirm --affirmative="Keep it" --negative="Choose another" "That's short (${#p1} characters). Keep it anyway?" || continue
    fi
    PASSWORD="$p1"
    break
  done
  friday_ok "Password set"
  echo
  if gum confirm --default=false --affirmative="Yes, skip it" --negative="No, ask for it" \
      "Skip the password screen when the computer starts?"; then
    AUTOLOGIN="true"
    friday_warn "Automatic login on: anyone who turns this computer on gets your desktop."
  else
    AUTOLOGIN="false"
    friday_ok "Password required at login"
  fi
  echo
  if gum confirm --default=true --affirmative="Encrypt" --negative="Don't encrypt" \
      "Encrypt the disk with this password? (asked at every start; recommended for laptops)"; then
    ENCRYPT="true"
    friday_ok "Disk will be encrypted (LUKS2)"
  else
    ENCRYPT="false"
    friday_warn "Disk not encrypted: anyone with the drive can read your files."
  fi
}

step_region() {
  screen 3
  friday_head "Region"
  local v
  friday_note "  Type to search, e.g. 'kolkata', 'berlin', 'new_york'."
  # The current choice comes first, so Enter without typing keeps it.
  v=$({ echo "$TIMEZONE"; friday_timezones | grep -vxF -- "$TIMEZONE"; } \
    | gum filter --height=10 --placeholder="Timezone (current: $TIMEZONE)") || true
  if friday_valid_timezone "${v:-}"; then TIMEZONE="$v"; fi
  friday_ok "Timezone: $TIMEZONE"
  friday_note "  Keyboard layout, e.g. 'us', 'uk', 'de', 'fr'."
  v=$({ echo "$KEYBOARD"; friday_keymaps | grep -vxF -- "$KEYBOARD"; } \
    | gum filter --height=10 --placeholder="Keyboard (current: $KEYBOARD)") || true
  if friday_valid_keymap "${v:-}"; then KEYBOARD="$v"; fi
  # Type the passwords that follow with this layout: the disk-unlock prompt
  # and the login use it, so a password typed with another one wouldn't match.
  loadkeys "$KEYBOARD" >/dev/null 2>&1 || true
  friday_ok "Keyboard: $KEYBOARD"
}

step_look() {
  screen 6
  friday_head "Desktop"
  local v
  # Most people keep FRIDAY's look; four questions only for those who don't.
  # From the review screen ("Change desktop") it goes straight to them.
  if [[ "${1:-}" != choose ]]; then
    friday_note "  FRIDAY's look: FRIDAY Shell in obsidian and core red with plain, thin-bordered windows on Hyprland, and FRIDAY's login screen. Change any of it later in the controls drawer (Look)."
    if gum confirm --affirmative="Keep FRIDAY's look" --negative="Choose my own" "Use FRIDAY's look?"; then
      friday_ok "FRIDAY's look"
      return 0
    fi
  fi
  friday_note "  Colours. Change them any time in the controls drawer (Look) or with friday shell palette."
  v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=11 --selected="$THEME" \
    "FRIDAY Shell Core (obsidian and core red; the FRIDAY OS look)" \
    "FRIDAY Shell Polar (arctic Nord blues)" \
    "FRIDAY Shell (Ember, made for FRIDAY)" \
    "FRIDAY Shell Frost (cool slate, ice blue)" \
    "FRIDAY Shell Moss (dark olive, lichen green)" \
    "FRIDAY Shell Dawn (light, warm paper)" \
    "FRIDAY Tokyo Night (Default Cybernetic Dark)" \
    "FRIDAY Catppuccin Mocha" \
    "FRIDAY Nord Arctic" \
    "end-4 Dots-Hyprland (Material You / Illogical Impulse)") && THEME="$v"
  friday_ok "$THEME"
  if [[ "$THEME" != *"Dots-Hyprland"* ]]; then
    echo
    friday_head "Window manager"
    friday_note "  Both are installed; pick the other one at the login screen any time."
    v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=4 --selected="$SESSION" \
      "Hyprland (tiling, the FRIDAY OS default)" \
      "niri (scrollable tiling: windows in an endless row)") && SESSION="$v"
    friday_ok "$SESSION"
    echo
    friday_head "Style"
    friday_note "  Where the bar sits and its shape; windows' gaps and corners follow it."
    v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=6 --selected="$SHELL_STYLE" \
      "Lean (thin borders, small gaps, no blur; the FRIDAY OS look)" \
      "Ember (bar flush with the top edge)" \
      "Island (floating pills along the top)" \
      "Dock (floating bar along the bottom)") && SHELL_STYLE="$v"
    friday_ok "$SHELL_STYLE"
  fi
  echo
  friday_head "Login screen"
  v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=8 --selected="$SDDM_THEME" \
    "SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)" \
    "SilentSDDM Classic (Minimal Dark Smoky)" \
    "SilentSDDM Rei (Animated Cyberpunk)" \
    "SilentSDDM Ken (Animated Synthwave)" \
    "SilentSDDM Nord (Arctic Frost)" \
    "Classic SDDM (plain dark)") && SDDM_THEME="$v"
  friday_ok "$SDDM_THEME"
}

step_features() {
  screen 7
  friday_head "What may FRIDAY do?"
  friday_say "FRIDAY only acts when you ask. Pick what it may do; change any of it later."
  friday_note "  Press x to turn a line on or off, Enter to confirm. Closing a window and anything that"
  friday_note "  deletes or sends always asks you first, whatever you pick here."
  echo
  local a="Handle my windows and apps plus volume and music when I ask"
  local b="Run tasks I schedule (\"every morning at 8 ...\")"
  local c="Tell the AI which app a selected text came from"
  local d="Send a window's text instead of a screenshot when the app offers it (faster; it can include text scrolled out of view)"
  local e="Offer to pair my Android phone at first login (FRIDAY Mobile; it stays off until I pair)"
  local picks
  picks=$(printf '%s\n' "$a" "$b" "$c" "$d" "$e" \
    | gum choose --no-limit --cursor="$FRIDAY_CURSOR" --height=7 \
        --selected="$a,$b,$c,$d,$e") || return 0
  FEAT_DESKTOP=false FEAT_TASKS=false FEAT_APPNAME=false FEAT_SCREENTEXT=false FEAT_PHONE=false
  [[ $picks == *"$a"* ]] && FEAT_DESKTOP=true
  [[ $picks == *"$b"* ]] && FEAT_TASKS=true
  [[ $picks == *"$c"* ]] && FEAT_APPNAME=true
  [[ $picks == *"window's text"* ]] && FEAT_SCREENTEXT=true
  [[ $picks == *"pair my Android phone"* ]] && FEAT_PHONE=true
  friday_ok "$(friday_features_label)"
}

# One line for the review screen.
friday_features_label() {
  local on=()
  [[ $FEAT_DESKTOP == true ]] && on+=("desktop control")
  [[ $FEAT_TASKS == true ]] && on+=("scheduled tasks")
  [[ $FEAT_APPNAME == true ]] && on+=("app name")
  [[ $FEAT_SCREENTEXT == true ]] && on+=("window text")
  [[ $FEAT_PHONE == true ]] && on+=("phone pairing")
  if ((${#on[@]} == 0)); then echo "nothing (questions only)"; return; fi
  local out="${on[0]}" item
  for item in "${on[@]:1}"; do out+=", $item"; done
  echo "$out"
}

step_browsers() {
  screen 8
  friday_head "Which browsers do you want?"
  friday_say "Chromium is always installed for web apps and the desktop. Choose any others you want."
  friday_note "  Press x to turn a line on or off, Enter to confirm."
  echo
  local a="Brave" b="Firefox" c="Zen" d="Vivaldi"
  local sel=() before="$BROWSERS"
  [[ " $BROWSERS " == *" brave "* ]] && sel+=("$a")
  [[ " $BROWSERS " == *" firefox "* ]] && sel+=("$b")
  [[ " $BROWSERS " == *" zen "* ]] && sel+=("$c")
  [[ " $BROWSERS " == *" vivaldi "* ]] && sel+=("$d")
  local -a sel_arg=()
  if ((${#sel[@]} > 0)); then
    local IFS=,
    sel_arg=(--selected="${sel[*]}")
  fi
  local picks
  picks=$(printf '%s\n' "$a" "$b" "$c" "$d" \
    | gum choose --no-limit --cursor="$FRIDAY_CURSOR" --height=6 "${sel_arg[@]}") || picks=""
  local -a chosen=() chosen_labels=()
  [[ $picks == *"$a"* ]] && { chosen+=("brave"); chosen_labels+=("$a"); }
  [[ $picks == *"$b"* ]] && { chosen+=("firefox"); chosen_labels+=("$b"); }
  [[ $picks == *"$c"* ]] && { chosen+=("zen"); chosen_labels+=("$c"); }
  [[ $picks == *"$d"* ]] && { chosen+=("vivaldi"); chosen_labels+=("$d"); }
  BROWSERS="${chosen[*]:-}"

  local -a avail=("${chosen_labels[@]}" "Chromium")
  if ((${#chosen[@]} > 0)); then
    echo
    friday_say "Which one opens links?"
    local pick
    local -a sel_link=()
    # On a first visit the cursor starts on the first browser just picked;
    # coming back, on the one chosen before (Chromium included).
    local def_label=""
    [[ -n "$before" && "$DEFAULT_BROWSER" == chromium ]] && def_label="Chromium"
    case "$DEFAULT_BROWSER" in
      brave) def_label="Brave" ;;
      firefox) def_label="Firefox" ;;
      zen) def_label="Zen" ;;
      vivaldi) def_label="Vivaldi" ;;
    esac
    for item in "${avail[@]}"; do
      if [[ "$item" == "$def_label" ]]; then
        sel_link=(--selected="$def_label")
        break
      fi
    done
    pick=$(printf '%s\n' "${avail[@]}" \
      | gum choose --cursor="$FRIDAY_CURSOR" --height=$(( ${#avail[@]} + 1 )) "${sel_link[@]}") || pick="${avail[0]}"
    case "$pick" in
      Brave) DEFAULT_BROWSER="brave" ;;
      Firefox) DEFAULT_BROWSER="firefox" ;;
      Zen) DEFAULT_BROWSER="zen" ;;
      Vivaldi) DEFAULT_BROWSER="vivaldi" ;;
      *) DEFAULT_BROWSER="chromium" ;;
    esac
  else
    DEFAULT_BROWSER="chromium"
  fi
  friday_ok "$(friday_browsers_label)"
}

friday_browsers_label() {
  local -a names=()
  local b name
  for b in chromium $BROWSERS; do
    case "$b" in
      brave) name="Brave" ;;
      firefox) name="Firefox" ;;
      zen) name="Zen" ;;
      vivaldi) name="Vivaldi" ;;
      chromium) name="Chromium" ;;
      *) name="$b" ;;
    esac
    [[ "$b" == "$DEFAULT_BROWSER" ]] && name+=" (default)"
    names+=("$name")
  done
  local out="${names[0]}"
  for name in "${names[@]:1}"; do out+=", $name"; done
  echo "$out"
}

step_ai() {
  screen 9
  friday_head "Give FRIDAY a brain"
  friday_say "I think with language models. Pick one or more: cloud providers, a model on this computer, or both."
  friday_note "  Tab or x picks, Enter goes on. OpenCode Zen's free models need no account and back up the rest."
  friday_note "  Use Claude Code, Codex, Antigravity or Cline? Connect it after you log in (it signs in"
  friday_note "  in a browser): FRIDAY offers it when you first log in, or run: friday connect"
  friday_note "  Free models may keep what you send them, screenshots included;"
  friday_note "  use your own key, account or local AI for private work."
  echo
  local choices choice id name key want_local=false
  choices=$(gum choose --no-limit --cursor="$FRIDAY_CURSOR" --height=10 \
    "OpenCode Zen (free, no key needed)" \
    "Google Gemini (vision, free tier)" \
    "Groq (fast, vision)" \
    "NVIDIA NIM (vision)" \
    "Runcrate (six free models weekly, GitHub sign-in)" \
    "AxForge (3M free tokens a month, keeps nothing)" \
    "OpenRouter (many models, no screen context)" \
    "Cerebras (fast, no screen context)" \
    "Local AI (on this computer: private, works offline)") || choices=""
  [[ -n "$choices" ]] || choices="OpenCode Zen (free, no key needed)"
  FRIDAY_AI_PROVIDERS="" FRIDAY_AI_KEYS=""
  FRIDAY_LOCAL_ENGINE="" FRIDAY_LOCAL_BUDGET_MB="" FRIDAY_LOCAL_MODEL=""
  local -a labels=()
  # fd 3: gum input reads the keyboard on stdin.
  while IFS= read -r -u 3 choice; do
    case "$choice" in
      "OpenCode Zen"*)  id=opencode ;;
      "Google Gemini"*) id=gemini ;;
      "Groq"*)          id=groq ;;
      "NVIDIA NIM"*)    id=nvidia-nim ;;
      "Runcrate"*)      id=runcrate ;;
      "AxForge"*)       id=axforge ;;
      "OpenRouter"*)    id=openrouter ;;
      "Cerebras"*)      id=cerebras ;;
      "Local AI"*)      want_local=true; continue ;;
      *) continue ;;
    esac
    name="${choice%% (*}"
    local placeholder="paste it here (Enter to skip $name)"
    [[ $id == opencode ]] && placeholder="optional: OpenCode key for paid models (Enter to skip)"
    while true; do
      key=$(gum input --password --prompt="$name key › " --placeholder="$placeholder") || key=""
      if [[ -z "$key" ]]; then
        [[ $id == opencode ]] || friday_note "  No key: skipped $name."
        break
      fi
      if friday_valid_api_key "$key"; then
        FRIDAY_AI_PROVIDERS="${FRIDAY_AI_PROVIDERS:+$FRIDAY_AI_PROVIDERS }$id"
        FRIDAY_AI_KEYS+="$id=$key"$'\n'
        labels+=("$name (key ••••${key: -4})")
        break
      fi
      friday_err "That doesn't look like an API key (too short, or has spaces/symbols). Try again."
    done
  done 3<<<"$choices"
  $want_local && step_local_ai
  [[ -n "$FRIDAY_LOCAL_MODEL" ]] && labels+=("$FRIDAY_LOCAL_LABEL")
  (( ${#labels[@]} )) || labels=("OpenCode Zen free models (no key)")
  FRIDAY_AI_LABEL="${labels[0]}"
  local l
  for l in "${labels[@]:1}"; do FRIDAY_AI_LABEL+=", $l"; done
  friday_ok "$FRIDAY_AI_LABEL"
}

# Local AI: the engine, then how much of this computer it may use. The
# numbers come from `friday local-ai` (friday-git is on the live ISO).
step_local_ai() {
  local summary presets size_mb line
  if ! summary=$(friday local-ai summary 2>/dev/null); then
    friday_err "Couldn't check this computer for local AI; set it up after you log in: friday setup-ai local"
    return 0
  fi
  echo
  friday_say "Local AI runs on this computer: it works offline, but it's slower than cloud."
  friday_note "  This computer: $(head -n1 <<<"$summary")"
  while IFS= read -r line; do friday_note "  $line"; done < <(tail -n +2 <<<"$summary")
  local engine eng
  engine=$(gum choose --cursor="$FRIDAY_CURSOR" \
    "Ollama (simplest; installed from the Arch repos)" \
    "llama.cpp (lighter; llama.cpp's official build)") || engine="Ollama"
  case "$engine" in llama.cpp*) eng=llamacpp ;; *) eng=ollama ;; esac
  # Free space: FRIDAY's share (the whole disk, or the size chosen next to
  # another system) less ~20 GB for the system.
  if [[ "$INSTALL_MODE" == alongside ]]; then
    size_mb=$(( FRIDAY_SIZE_MB - 20480 ))
  else
    size_mb=$(lsblk -b -d -n -o SIZE "$TARGET_DISK" 2>/dev/null | head -n1 | xargs)
    if [[ "$size_mb" =~ ^[0-9]+$ ]]; then size_mb=$(( size_mb / 1048576 - 20480 )); else size_mb=1000000; fi
  fi
  presets=$(FRIDAY_DISK_FREE_MB="$size_mb" friday local-ai presets "$eng" 2>/dev/null) || presets=""
  local -a options=() ids=()
  local id label budget model dl vision fast available note speed
  while IFS='|' read -r id label budget model dl vision fast available note; do
    [[ -n "$id" ]] || continue
    if [[ -z "$model" || $available != 1 ]]; then
      friday_note "  ${label%% (*}: $note"
      continue
    fi
    speed="slower (CPU)"; (( fast )) && speed="fast (GPU)"
    options+=("$label: $model, $(awk -v m="$dl" 'BEGIN { printf "%.1f GB", m / 1024 }') download, $note, $speed")
    ids+=("$id|$budget|$model|$vision")
  done <<<"$presets"
  friday_note "  The amount picks the model. It's in memory only while FRIDAY answers, and freed after 5 idle minutes."
  friday_note "  Models above 4B answer first. Smaller ones back up cloud, so your questions go to a cloud model first."
  friday_note "  To keep everything on this computer, choose Local first in FRIDAY Settings later (or: friday private on)."
  if (( ${#options[@]} == 0 )); then
    friday_err "This computer can't run a local model well, so FRIDAY uses cloud providers only."
    return 0
  fi
  local pick i
  pick=$(printf '%s\n' "${options[@]}" "Pick the model myself" "No local AI after all" | gum choose --cursor="$FRIDAY_CURSOR" --height=9) || pick=""
  if [[ $pick == "Pick the model myself" ]]; then
    pick_local_model "$eng" "$engine" "$size_mb"
    return 0
  fi
  for i in "${!options[@]}"; do
    [[ "${options[$i]}" == "$pick" ]] || continue
    IFS='|' read -r _ FRIDAY_LOCAL_BUDGET_MB FRIDAY_LOCAL_MODEL vision <<<"${ids[$i]}"
    FRIDAY_LOCAL_ENGINE="$eng"
    local sees="text only"; (( vision )) && sees="sees screenshots"
    local when="backs up cloud"; [[ $pick == *", answers first,"* ]] && when="answers first"
    FRIDAY_LOCAL_LABEL="Local: $FRIDAY_LOCAL_MODEL on ${engine%% (*} ($sees, $when)"
    friday_ok "$FRIDAY_LOCAL_LABEL; it downloads after your first login"
  done
}

# Every model FRIDAY sets up on the engine (Ollama: its own library only;
# llama.cpp: GGUF files, small ones for low-end computers too), each with
# what it needs; one too big for this computer's memory or disk says so.
pick_local_model() {
  local eng="$1" engine="$2" disk_mb="$3" ram_mb rows id need dl vision line
  local -a options=() ids=()
  ram_mb=$(friday local-ai detect 2>/dev/null | sed -n 's/^ram_mb=//p')
  rows=$(friday local-ai models "$eng" 2>/dev/null) || rows=""
  while IFS='|' read -r id need dl vision; do
    [[ -n "$id" ]] || continue
    line="$id: needs $(friday_gb "$need") of memory, $(friday_gb "$dl") download"
    (( vision )) && line+=", sees screenshots" || line+=", text only"
    if (( dl + 1024 > disk_mb )); then line+=" (not enough disk)"
    elif [[ "$ram_mb" =~ ^[0-9]+$ ]] && (( need > ram_mb * 3 / 4 )); then line+=" (too big for this computer's memory)"; fi
    options+=("$line"); ids+=("$id|$need|$vision")
  done <<<"$rows"
  local pick i
  pick=$(printf '%s\n' "${options[@]}" "No local AI after all" | gum choose --cursor="$FRIDAY_CURSOR" --height=10) || pick=""
  for i in "${!options[@]}"; do
    [[ "${options[$i]}" == "$pick" ]] || continue
    IFS='|' read -r FRIDAY_LOCAL_MODEL FRIDAY_LOCAL_BUDGET_MB vision <<<"${ids[$i]}"
    FRIDAY_LOCAL_ENGINE="$eng"
    local sees="text only"; (( vision )) && sees="sees screenshots"
    FRIDAY_LOCAL_LABEL="Local: $FRIDAY_LOCAL_MODEL on ${engine%% (*} ($sees)"
    friday_ok "$FRIDAY_LOCAL_LABEL; it downloads after your first login"
  done
}

review() {
  while true; do
    screen 10 "REVIEW"
    local disk_lines=("Disk        $TARGET_LABEL$([[ $ENCRYPT == true ]] && echo "  (encrypted)")")
    [[ "$INSTALL_MODE" == alongside ]] \
      && disk_lines+=("            alongside $ALONGSIDE_OS: $(friday_gb "$FRIDAY_SIZE_MB") of its free space")
    gum style --foreground "$FRIDAY_ACCENT" --border "$FRIDAY_BORDER_STYLE" --border-foreground "$FRIDAY_BORDER" \
      --margin "0 0 0 $FRIDAY_INDENT" --padding "1 2" --width "$FRIDAY_WIDTH" \
      "${disk_lines[@]}" \
      "Computer    $HOSTNAME" \
      "User        $USERNAME   (password set, $([[ $AUTOLOGIN == true ]] && echo "automatic login" || echo "asked at login"))" \
      "Region      $TIMEZONE · keyboard $KEYBOARD" \
      "Desktop     $THEME$([[ $THEME != *Dots-Hyprland* ]] && echo " · ${SHELL_STYLE%% (*} · ${SESSION%% (*}")" \
      "Login       $SDDM_THEME" \
      "Browsers    $(friday_browsers_label)" \
      "Allowed     $(friday_features_label)" \
      "AI          $FRIDAY_AI_LABEL"
    echo
    if [[ "$INSTALL_MODE" == alongside ]]; then
      gum style --margin "0 0 0 $FRIDAY_INDENT" --foreground "$FRIDAY_SUCCESS" --bold \
        "Installing adds FRIDAY in $(friday_gb "$FRIDAY_SIZE_MB") of free space; $ALONGSIDE_OS and its files stay as they are."
    else
      gum style --margin "0 0 0 $FRIDAY_INDENT" --foreground "$FRIDAY_WARNING" --bold "Installing erases everything on $TARGET_DISK."
    fi
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" \
        "Install FRIDAY OS" "Change disk" "Change names" "Change password" \
        "Change region" "Change desktop" "Change what FRIDAY may do" "Change browsers" "Change AI" "Quit setup")" in
      "Install FRIDAY OS")
        if [[ "$INSTALL_MODE" == alongside ]]; then
          gum confirm --default=false --affirmative="Install alongside" --negative="Back" \
            "Last check: add FRIDAY next to $ALONGSIDE_OS on $TARGET_DISK?" && return 0
        else
          gum confirm --default=false --affirmative="Erase and install" --negative="Back" \
            "Last check: erase $TARGET_DISK and install?" && return 0
        fi ;;
      "Change disk") step_disk ;;
      "Change names") step_identity ;;
      "Change password") step_security ;;
      "Change region")
        local kb_before="$KEYBOARD"
        step_region
        if [[ "$KEYBOARD" != "$kb_before" ]]; then
          friday_note "  The keyboard changed, so type your password again with it."
          step_security
        fi ;;
      "Change desktop") step_look choose ;;
      "Change what FRIDAY may do") step_features ;;
      "Change browsers") step_browsers ;;
      "Change AI") step_ai ;;
      *) leave_menu "Nothing was written to disk." ;;
    esac
  done
}

