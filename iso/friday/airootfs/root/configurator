#!/usr/bin/env bash
# FRIDAY Live ISO Interactive Configurator (TUI Visual Identity Pass 2)
set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"

# Centralized FRIDAY Visual Tokens
FRIDAY_ACCENT="#7AA2F7"      # Deep Ice Blue
FRIDAY_SECONDARY="#BB9AF7"   # Soft Purple
FRIDAY_MUTED="#565F89"       # Muted Slate
FRIDAY_SUCCESS="#9ECE6A"     # Mint Green
FRIDAY_WARNING="#E0AF68"     # Warm Amber
FRIDAY_ERROR="#F7768E"       # Crimson Red
FRIDAY_BORDER="#3B4261"      # Border Slate

draw_brand_banner() {
  clear
  echo
  gum style --foreground "$FRIDAY_ACCENT" --align center \
" ██████╗ ██████╗ ██╗██████╗  █████╗ ██╗   ██╗" \
" ██╔════╝██╔══██╗██║██╔══██╗██╔══██╗╚██╗ ██╔╝" \
" █████╗  ██████╔╝██║██║  ██║███████║ ╚████╔╝ " \
" ██╔══╝  ██╔══██╗██║██║  ██║██╔══██║  ╚██╔╝  " \
" ██║     ██║  ██║██║██████╔╝██║  ██║   ██║   " \
" ╚═╝     ╚═╝  ╚═╝╚═╝╚═════╝ ╚═╝  ╚═╝   ╚═╝   "
  echo
  gum style --foreground "$FRIDAY_SECONDARY" --bold --align center "COGNITIVE OPERATING SYSTEM"
  gum style --foreground "$FRIDAY_MUTED" --align center "────────────────────────────────────────────────────────────"
  echo
}

draw_rail() {
  local step="$1"
  local s1="○ MACHINE" s2="○ IDENTITY" s3="○ SECURITY" s4="○ TIME" s5="○ THEME" s6="○ INSTALL"

  case "$step" in
    1) s1="● MACHINE" ;;
    2) s1="✓ MACHINE"; s2="● IDENTITY" ;;
    3) s1="✓ MACHINE"; s2="✓ IDENTITY"; s3="● SECURITY" ;;
    4) s1="✓ MACHINE"; s2="✓ IDENTITY"; s3="✓ SECURITY"; s4="● TIME" ;;
    5) s1="✓ MACHINE"; s2="✓ IDENTITY"; s3="✓ SECURITY"; s4="✓ TIME"; s5="● THEME" ;;
    6) s1="✓ MACHINE"; s2="✓ IDENTITY"; s3="✓ SECURITY"; s4="✓ TIME"; s5="✓ THEME"; s6="● INSTALL" ;;
  esac

  gum style --foreground "$FRIDAY_MUTED" --align center "$s1   $s2   $s3   $s4   $s5   $s6"
  echo
}

draw_brand_banner
draw_rail 1

# 1. Discover Disks & Exclude ISO Boot Media
BOOT_MOUNT="/run/archiso/bootmnt"
BOOT_DEV=""
if findmnt -n -o SOURCE "$BOOT_MOUNT" >/dev/null 2>&1; then
  BOOT_DEV=$(findmnt -n -o SOURCE "$BOOT_MOUNT" | sed 's/[0-9]*$//;s/p[0-9]*$//')
fi

if [[ -n "$BOOT_DEV" ]]; then
  gum style --foreground "$FRIDAY_MUTED" --border rounded --border-foreground "$FRIDAY_BORDER" --padding "0 1" --width 72 \
    "LIVE BOOT MEDIA EXCLUDED: $BOOT_DEV (Protected Boot Medium)"
  echo
fi

CANDIDATE_DISKS=()
CANDIDATE_LABELS=()

while read -r name type size model; do
  dev_path="/dev/$name"
  if [[ -n "$BOOT_DEV" && "$dev_path" == "$BOOT_DEV"* ]]; then
    continue
  fi
  if [[ "$type" == "disk" && ! "$name" =~ ^(fd|loop|ram|sr) ]]; then
    CANDIDATE_DISKS+=("$dev_path")
    CANDIDATE_LABELS+=("$dev_path | $size | $model")
  fi
done < <(lsblk -d -n -o NAME,TYPE,SIZE,MODEL)

if (( ${#CANDIDATE_DISKS[@]} == 0 )); then
  gum style --foreground "$FRIDAY_ERROR" --bold "ERROR: No target installation disks found (excluding Live USB)."
  exit 1
fi

gum style --foreground "$FRIDAY_ACCENT" --bold "Select Target Installation Disk:"
CHOICE_LABEL=$(printf "%s\n" "${CANDIDATE_LABELS[@]}" | gum choose --cursor="❯ " --height=8)
TARGET_DISK=$(echo "$CHOICE_LABEL" | awk -F'|' '{print $1}' | xargs)

# Step 2: Identity
draw_brand_banner
draw_rail 2
gum style --foreground "$FRIDAY_SUCCESS" "✓ Target Disk Selected: $TARGET_DISK"
echo
gum style --foreground "$FRIDAY_ACCENT" --bold "Machine Identity Configuration:"
HOSTNAME=$(gum input --placeholder="friday" --prompt="System Hostname [friday]> " || echo "friday")
HOSTNAME="${HOSTNAME:-friday}"

USERNAME=$(gum input --placeholder="friday" --prompt="Admin Username [friday]> " || echo "friday")
USERNAME="${USERNAME:-friday}"

KEYBOARD=$(gum input --placeholder="us" --prompt="Keyboard Layout [us]> " || echo "us")
KEYBOARD="${KEYBOARD:-us}"

# Step 3: Security
draw_brand_banner
draw_rail 3
gum style --foreground "$FRIDAY_SUCCESS" "✓ Target Disk: $TARGET_DISK"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Identity:    $USERNAME@$HOSTNAME ($KEYBOARD)"
echo
gum style --foreground "$FRIDAY_ACCENT" --bold "Security Credentials:"
PASSWORD=$(gum input --password --prompt="Admin Password> ")
PASSWORD_CONFIRM=$(gum input --password --prompt="Confirm Password> ")

if [[ "$PASSWORD" != "$PASSWORD_CONFIRM" ]]; then
  gum style --foreground "$FRIDAY_ERROR" "ERROR: Passwords do not match!"
  exit 1
fi

# Step 4: Timezone
draw_brand_banner
draw_rail 4
gum style --foreground "$FRIDAY_SUCCESS" "✓ Target Disk: $TARGET_DISK"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Identity:    $USERNAME@$HOSTNAME ($KEYBOARD)"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Password:    ••••••••"
echo
gum style --foreground "$FRIDAY_ACCENT" --bold "Time & Region:"
TIMEZONE=$(gum input --placeholder="UTC" --prompt="Timezone [UTC]> " || echo "UTC")
TIMEZONE="${TIMEZONE:-UTC}"

# Step 5: Visual Theme Selection
draw_brand_banner
draw_rail 5
gum style --foreground "$FRIDAY_SUCCESS" "✓ Target Disk: $TARGET_DISK"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Identity:    $USERNAME@$HOSTNAME ($KEYBOARD)"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Password:    ••••••••"
gum style --foreground "$FRIDAY_SUCCESS" "✓ Timezone:    $TIMEZONE"
echo
gum style --foreground "$FRIDAY_ACCENT" --bold "Desktop Visual Identity & Theme Architecture:"
THEME_CHOICE=$(gum choose --cursor="❯ " --height=6 \
  "FRIDAY Dots-Hyprland (Material You / Illogical Impulse)" \
  "FRIDAY Tokyo Night (Default Cybernetic Dark)" \
  "FRIDAY Catppuccin Mocha" \
  "FRIDAY Nord Arctic")
THEME="${THEME_CHOICE:-FRIDAY Dots-Hyprland (Material You / Illogical Impulse)}"

echo
gum style --foreground "$FRIDAY_ACCENT" --bold "SDDM Display Manager Greeter Theme Architecture:"
SDDM_CHOICE=$(gum choose --cursor="❯ " --height=8 \
  "SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)" \
  "SilentSDDM Classic (Minimal Dark Smoky)" \
  "SilentSDDM Rei (Animated Cyberpunk)" \
  "SilentSDDM Ken (Animated Synthwave)" \
  "SilentSDDM Nord (Arctic Frost)" \
  "Omarchy Classic SDDM")
SDDM_THEME="${SDDM_CHOICE:-SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)}"

# Step 6: Final Review & Confirmation
draw_brand_banner
draw_rail 6

gum style \
  --foreground "$FRIDAY_ACCENT" \
  --border-foreground "$FRIDAY_BORDER" \
  --border rounded \
  --padding "1 2" \
  --width 72 \
  "SYSTEM INITIALIZATION SPECIFICATION" \
  "──────────────────────────────────────────────────────────" \
  "  Target Disk:  $TARGET_DISK" \
  "  Keyboard:     $KEYBOARD" \
  "  Hostname:     $HOSTNAME" \
  "  Admin User:   $USERNAME" \
  "  Timezone:     $TIMEZONE" \
  "  Desktop UI:   $THEME" \
  "  SDDM Greeter: $SDDM_THEME"

echo
gum style --foreground "$FRIDAY_WARNING" --bold "WARNING: ALL EXISTING DATA ON $TARGET_DISK WILL BE PERMANENTLY WIPED."
if gum confirm "Proceed with destructive installation onto $TARGET_DISK?"; then
  echo
  gum style --foreground "$FRIDAY_SUCCESS" "Specification approved. Initiating system assembly..."
  export TARGET_DISK KEYBOARD HOSTNAME USERNAME PASSWORD TIMEZONE THEME SDDM_THEME
  exec /root/installer
else
  gum style --foreground "$FRIDAY_ERROR" "Installation cancelled by user."
  exit 1
fi
