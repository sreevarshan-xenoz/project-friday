#!/usr/bin/env bash
# FRIDAY Live ISO interactive configurator.
# Collects the install specification, then hands off to /root/installer.
# Every step validates its input and loops on mistakes; the review screen can
# jump back to any step; leaving never strands tty1 on a blank screen.
set -uo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"
# shellcheck source=friday-tui.sh
source "$(dirname "$(readlink -f "$0")")/friday-tui.sh"
friday_console_theme

STEPS=(NETWORK DISK REGION IDENTITY SECURITY LOOK FEATURES AI REVIEW)

# Defaults (also what an unattended run would use).
TARGET_DISK="" TARGET_LABEL=""
HOSTNAME="friday" USERNAME="friday" PASSWORD=""
KEYBOARD="us" TIMEZONE="UTC"
THEME="FRIDAY Shell (Ember, made for FRIDAY)"
SHELL_STYLE="Ember (bar flush with the top edge)"
SESSION="Hyprland (tiling, the FRIDAY OS default)"
SDDM_THEME="SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)"
FRIDAY_AI_PROVIDER="" FRIDAY_AI_KEY=""
AUTOLOGIN="false"
ENCRYPT="true"
FRIDAY_AI_LABEL="OpenCode Zen free models (no key)"

screen() { # screen <step-index> [subtitle]
  friday_header "${2:-SETUP}"
  friday_rail "$1" "${STEPS[@]}"
}

# Never leave tty1 dead: always end in a menu.
leave_menu() {
  local why="${1:-}"
  while true; do
    friday_banner "SETUP PAUSED"
    [[ -n "$why" ]] && friday_say "$why"
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" "Start setup again" "Open a shell" "Reboot" "Power off")" in
      "Start setup again") exec "$0" ;;
      "Open a shell")
        friday_note "Type 'exit' to come back to setup."
        bash -l || true ;;
      "Reboot") systemctl reboot ;;
      "Power off") systemctl poweroff ;;
      *) ;;
    esac
  done
}

# ------------------------------------------------------------------ steps

step_welcome() {
  friday_banner
  friday_say "Hello. I'm FRIDAY."
  friday_say "I'll ask you a few questions, then build your system while you grab a coffee."
  friday_say "It usually takes 15 to 30 minutes, depending on your connection."
  echo
  gum confirm --affirmative="Let's begin" --negative="Not now" "Ready?" || leave_menu "Whenever you're ready."
  # FRIDAY OS boots with systemd-boot, which needs UEFI: say so now, before
  # any question, rather than after the disk has been erased.
  if [[ ! -d /sys/firmware/efi && -z "${FRIDAY_ASSUME_UEFI:-}" ]]; then
    leave_menu "This computer started in legacy BIOS mode, and FRIDAY OS needs UEFI. Turn on UEFI boot in the firmware settings, then start the USB again."
  fi
}

connect_wifi() {
  local dev ssid pass
  dev=$(basename "$(dirname "$(ls -d /sys/class/net/*/wireless 2>/dev/null | head -n1)")" 2>/dev/null)
  if [[ -z "$dev" || "$dev" == "." ]]; then
    friday_err "No Wi-Fi adapter found. Plug in an Ethernet cable instead."
    sleep 2
    return 1
  fi
  gum spin --spinner dot --title "Scanning for networks on $dev…" -- \
    bash -c "iwctl station '$dev' scan >/dev/null 2>&1; sleep 4"
  ssid=$( { iw dev "$dev" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p'
            iwctl station "$dev" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
              | awk 'NR>4 && NF>=3 {sub(/^[ >]+/,""); $(NF)=""; $(NF-1)=""; sub(/[ ]+$/,""); print}'
          } | grep -v '^$' | sort -u | gum filter --placeholder "Choose a network (type to search)" ) || return 1
  [[ -n "$ssid" ]] || return 1
  pass=$(gum input --password --placeholder "Password for $ssid (empty for open network)") || return 1
  if [[ -n "$pass" ]]; then
    gum spin --spinner dot --title "Connecting to $ssid…" -- \
      iwctl --passphrase "$pass" station "$dev" connect "$ssid"
  else
    gum spin --spinner dot --title "Connecting to $ssid…" -- iwctl station "$dev" connect "$ssid"
  fi
  sleep 3
}

step_network() {
  while true; do
    screen 1
    friday_head "Network"
    if gum spin --spinner dot --title "Checking the internet connection…" -- bash -c "$(declare -f friday_online); friday_online"; then
      friday_ok "Online. I'll download the latest packages during install."
      sleep 1
      return
    fi
    friday_warn "I can't reach the package mirrors, and I need them to install."
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" "Connect to Wi-Fi" "Check again (I plugged in a cable)" "Open a shell to fix it" "Quit setup")" in
      "Connect to Wi-Fi") connect_wifi || true ;;
      "Check again"*) ;;
      "Open a shell"*) friday_note "Type 'exit' when done."; bash -l || true ;;
      *) leave_menu "Setup needs a network connection." ;;
    esac
  done
}

step_disk() {
  screen 2
  local boot_dev="" name type size model fstypes
  # The disk the live system booted from: the parent of the partition mounted
  # at bootmnt, resolved through any /dev/disk/by-* link.
  local boot_src
  if boot_src=$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null) && [[ -n "$boot_src" ]]; then
    boot_src=$(readlink -f "$boot_src")
    boot_dev=$(lsblk -n -d -o PKNAME "$boot_src" 2>/dev/null | head -n1)
    boot_dev=${boot_dev:+/dev/$boot_dev}
    [[ -n "$boot_dev" ]] || boot_dev="$boot_src"
  fi
  local labels=()
  while read -r name type size model; do
    [[ "$type" == "disk" && ! "$name" =~ ^(fd|loop|ram|sr|zram) ]] || continue
    [[ -n "$boot_dev" && "/dev/$name" == "$boot_dev" ]] && continue
    fstypes=$(lsblk -n -o FSTYPE "/dev/$name" 2>/dev/null | grep -v '^$' | sort -u | paste -sd, -)
    labels+=("/dev/$name │ $size │ ${model:-unknown model}${fstypes:+ │ has: $fstypes}")
  done < <(lsblk -d -n -o NAME,TYPE,SIZE,MODEL)

  if (( ${#labels[@]} == 0 )); then
    leave_menu "I couldn't find a disk to install onto (the USB stick I booted from is excluded)."
  fi
  [[ -n "$boot_dev" ]] && friday_note "  Your boot USB ($boot_dev) is protected and not listed."
  friday_head "Where should FRIDAY live?"
  friday_note "  The whole disk will be erased."
  TARGET_LABEL=$(printf '%s\n' "${labels[@]}" | gum choose --cursor="$FRIDAY_CURSOR" --height=8) || leave_menu
  TARGET_DISK=$(awk -F'│' '{print $1}' <<<"$TARGET_LABEL" | xargs)
}

step_identity() {
  screen 4
  friday_head "Name your machine and yourself"
  local v
  while true; do
    v=$(gum input --value="$HOSTNAME" --prompt="Computer name › " --placeholder="friday") || leave_menu
    v=$(tr '[:upper:]' '[:lower:]' <<<"${v:-friday}")
    friday_valid_hostname "$v" && { HOSTNAME="$v"; break; }
    friday_err "Use lowercase letters, digits and hyphens (no spaces), up to 63 characters."
  done
  friday_ok "Computer name: $HOSTNAME"
  while true; do
    v=$(gum input --value="$USERNAME" --prompt="Your username › " --placeholder="friday") || leave_menu
    v="${v:-friday}"
    friday_valid_username "$v" && { USERNAME="$v"; break; }
    friday_err "Start with a lowercase letter; then lowercase letters, digits, - or _. System names like root are taken."
  done
  friday_ok "Username: $USERNAME"
}

step_security() {
  screen 5
  friday_head "Choose a password for $USERNAME"
  friday_note "  It's also used for sudo."
  local p1 p2
  while true; do
    p1=$(gum input --password --prompt="Password › ") || leave_menu
    if [[ -z "$p1" ]]; then friday_err "The password can't be empty."; continue; fi
    p2=$(gum input --password --prompt="Again › ") || leave_menu
    if [[ "$p1" != "$p2" ]]; then friday_err "Those didn't match. Let's try again."; continue; fi
    if (( ${#p1} < 6 )); then
      gum confirm --affirmative="Keep it" --negative="Choose another" "That's short (${#p1} characters). Keep it anyway?" || continue
    fi
    PASSWORD="$p1"
    break
  done
  friday_ok "Password set"
  echo
  if gum confirm --default=false --affirmative="Yes, skip it" --negative="No, ask for it" \
      "Skip the password screen when the computer starts?"; then
    AUTOLOGIN="true"
    friday_warn "Automatic login on: anyone who turns this computer on gets your desktop."
  else
    AUTOLOGIN="false"
    friday_ok "Password required at login"
  fi
  echo
  if gum confirm --default=true --affirmative="Encrypt" --negative="Don't encrypt" \
      "Encrypt the disk with this password? (asked at every start; recommended for laptops)"; then
    ENCRYPT="true"
    friday_ok "Disk will be encrypted (LUKS2)"
  else
    ENCRYPT="false"
    friday_warn "Disk not encrypted: anyone with the drive can read your files."
  fi
}

step_region() {
  screen 3
  friday_head "Region"
  local v
  friday_note "  Type to search, e.g. 'kolkata', 'berlin', 'new_york'."
  v=$(friday_timezones | gum filter --height=10 --placeholder="Timezone (current: $TIMEZONE)") || true
  if friday_valid_timezone "${v:-}"; then TIMEZONE="$v"; fi
  friday_ok "Timezone: $TIMEZONE"
  friday_note "  Keyboard layout, e.g. 'us', 'uk', 'de', 'fr'."
  v=$(friday_keymaps | gum filter --height=10 --placeholder="Keyboard (current: $KEYBOARD)") || true
  if friday_valid_keymap "${v:-}"; then KEYBOARD="$v"; fi
  # Type the passwords that follow with this layout: the disk-unlock prompt
  # and the login use it, so a password typed with another one wouldn't match.
  loadkeys "$KEYBOARD" >/dev/null 2>&1 || true
  friday_ok "Keyboard: $KEYBOARD"
}

step_look() {
  screen 6
  friday_head "Desktop"
  local v
  friday_note "  Colours. Change them any time in the controls drawer (Look) or with friday shell palette."
  v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=10 --selected="$THEME" \
    "FRIDAY Shell (Ember, made for FRIDAY)" \
    "FRIDAY Shell Frost (cool slate, ice blue)" \
    "FRIDAY Shell Moss (dark olive, lichen green)" \
    "FRIDAY Shell Dawn (light, warm paper)" \
    "FRIDAY Tokyo Night (Default Cybernetic Dark)" \
    "FRIDAY Catppuccin Mocha" \
    "FRIDAY Nord Arctic" \
    "end-4 Dots-Hyprland (Material You / Illogical Impulse)") && THEME="$v"
  friday_ok "$THEME"
  if [[ "$THEME" != *"Dots-Hyprland"* ]]; then
    echo
    friday_head "Window manager"
    friday_note "  Both are installed; pick the other one at the login screen any time."
    v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=4 --selected="$SESSION" \
      "Hyprland (tiling, the FRIDAY OS default)" \
      "niri (scrollable tiling: windows in an endless row)") && SESSION="$v"
    friday_ok "$SESSION"
    echo
    friday_head "Style"
    friday_note "  Where the bar sits and its shape; windows' gaps and corners follow it."
    v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=5 --selected="$SHELL_STYLE" \
      "Ember (bar flush with the top edge)" \
      "Island (floating pills along the top)" \
      "Dock (floating bar along the bottom)") && SHELL_STYLE="$v"
    friday_ok "$SHELL_STYLE"
  fi
  echo
  friday_head "Login screen"
  v=$(gum choose --cursor="$FRIDAY_CURSOR" --height=8 --selected="$SDDM_THEME" \
    "SilentSDDM FRIDAY Edition (Deep Ice & Purple / Material You)" \
    "SilentSDDM Classic (Minimal Dark Smoky)" \
    "SilentSDDM Rei (Animated Cyberpunk)" \
    "SilentSDDM Ken (Animated Synthwave)" \
    "SilentSDDM Nord (Arctic Frost)" \
    "Omarchy Classic SDDM") && SDDM_THEME="$v"
  friday_ok "$SDDM_THEME"
}

step_features() {
  screen 7
  friday_head "What may FRIDAY do?"
  friday_say "FRIDAY only acts when you ask. Pick what it may do; change any of it later."
  friday_note "  Press x to turn a line on or off, Enter to confirm. Closing a window and anything that"
  friday_note "  deletes or sends always asks you first, whatever you pick here."
  echo
  local a="Handle my windows and apps plus volume and music when I ask"
  local b="Run tasks I schedule (\"every morning at 8 ...\")"
  local c="Tell the AI which app a selected text came from"
  local d="Send a window's text instead of a screenshot (it can include text you can't see)"
  local picks
  picks=$(printf '%s\n' "$a" "$b" "$c" "$d" \
    | gum choose --no-limit --cursor="$FRIDAY_CURSOR" --height=6 \
        --selected="$a,$b,$c") || return 0
  FEAT_DESKTOP=false FEAT_TASKS=false FEAT_APPNAME=false FEAT_SCREENTEXT=false
  [[ $picks == *"$a"* ]] && FEAT_DESKTOP=true
  [[ $picks == *"$b"* ]] && FEAT_TASKS=true
  [[ $picks == *"$c"* ]] && FEAT_APPNAME=true
  [[ $picks == *"window's text"* ]] && FEAT_SCREENTEXT=true
  friday_ok "$(friday_features_label)"
}

# One line for the review screen.
friday_features_label() {
  local on=()
  [[ $FEAT_DESKTOP == true ]] && on+=("desktop control")
  [[ $FEAT_TASKS == true ]] && on+=("scheduled tasks")
  [[ $FEAT_APPNAME == true ]] && on+=("app name")
  [[ $FEAT_SCREENTEXT == true ]] && on+=("window text")
  if ((${#on[@]} == 0)); then echo "nothing (questions only)"; return; fi
  local out="${on[0]}" item
  for item in "${on[@]:1}"; do out+=", $item"; done
  echo "$out"
}

step_ai() {
  screen 8
  friday_head "Give FRIDAY a brain"
  friday_say "I think with a cloud language model. OpenCode Zen's free models work with no account."
  friday_note "  Prefer your own provider? Pick it and paste its key. Change it later with: friday setup-ai"
  friday_note "  Use Claude Code, Codex, Antigravity or Cline? Connect it after you log in (it signs in"
  friday_note "  in a browser): FRIDAY offers it when you first log in, or run: friday connect"
  friday_note "  Free models may keep what you send them, screenshots included; use your own key or account for private work."
  echo
  local choice key
  choice=$(gum choose --cursor="$FRIDAY_CURSOR" --height=8 \
    "OpenCode Zen (free, no key needed)" \
    "Google Gemini (vision, free tier)" \
    "Groq (fast, vision)" \
    "NVIDIA NIM (vision)" \
    "OpenRouter (many models, no screen context)" \
    "Cerebras (fast, no screen context)") || choice="OpenCode Zen"
  FRIDAY_AI_PROVIDER=""
  case "$choice" in
    "OpenCode Zen"*)  FRIDAY_AI_PROVIDER="opencode" ;;
    "Google Gemini"*) FRIDAY_AI_PROVIDER="gemini" ;;
    "Groq"*)          FRIDAY_AI_PROVIDER="groq" ;;
    "NVIDIA NIM"*)    FRIDAY_AI_PROVIDER="nvidia-nim" ;;
    "OpenRouter"*)    FRIDAY_AI_PROVIDER="openrouter" ;;
    "Cerebras"*)      FRIDAY_AI_PROVIDER="cerebras" ;;
  esac
  FRIDAY_AI_KEY=""
  FRIDAY_AI_LABEL="OpenCode Zen free models (no key)"
  local optional=false placeholder="paste it here (empty: use OpenCode Zen's free models)"
  if [[ "$FRIDAY_AI_PROVIDER" == opencode ]]; then
    optional=true placeholder="optional: OpenCode key for paid models (Enter to skip)"
  fi
  while true; do
    key=$(gum input --password --prompt="API key › " --placeholder="$placeholder") || key=""
    if [[ -z "$key" ]]; then
      # No key: OpenCode Zen's free models (the daemon's default).
      $optional || friday_note "  No key: using OpenCode Zen's free models instead."
      FRIDAY_AI_PROVIDER=""
      friday_ok "$FRIDAY_AI_LABEL"
      return 0
    fi
    if friday_valid_api_key "$key"; then
      FRIDAY_AI_KEY="$key"
      FRIDAY_AI_LABEL="${choice%% (*} (key ••••${key: -4})"
      friday_ok "$FRIDAY_AI_LABEL"
      return 0
    fi
    friday_err "That doesn't look like an API key (too short, or has spaces/symbols). Try again."
  done
}

review() {
  while true; do
    screen 9 "REVIEW"
    gum style --foreground "$FRIDAY_ACCENT" --border "$FRIDAY_BORDER_STYLE" --border-foreground "$FRIDAY_BORDER" \
      --margin "0 0 0 $FRIDAY_INDENT" --padding "1 2" --width "$FRIDAY_WIDTH" \
      "Disk        $TARGET_LABEL$([[ $ENCRYPT == true ]] && echo "  (encrypted)")" \
      "Computer    $HOSTNAME" \
      "User        $USERNAME   (password set, $([[ $AUTOLOGIN == true ]] && echo "automatic login" || echo "asked at login"))" \
      "Region      $TIMEZONE · keyboard $KEYBOARD" \
      "Desktop     $THEME$([[ $THEME != *Dots-Hyprland* ]] && echo " · ${SHELL_STYLE%% (*} · ${SESSION%% (*}")" \
      "Login       $SDDM_THEME" \
      "Allowed     $(friday_features_label)" \
      "AI          $FRIDAY_AI_LABEL"
    echo
    gum style --margin "0 0 0 $FRIDAY_INDENT" --foreground "$FRIDAY_WARNING" --bold "Installing erases everything on $TARGET_DISK."
    echo
    case "$(gum choose --cursor="$FRIDAY_CURSOR" \
        "Install FRIDAY OS" "Change disk" "Change names" "Change password" \
        "Change region" "Change desktop" "Change what FRIDAY may do" "Change AI" "Quit setup")" in
      "Install FRIDAY OS")
        gum confirm --default=false --affirmative="Erase and install" --negative="Back" \
          "Last check: erase $TARGET_DISK and install?" && return 0 ;;
      "Change disk") step_disk ;;
      "Change names") step_identity ;;
      "Change password") step_security ;;
      "Change region")
        local kb_before="$KEYBOARD"
        step_region
        if [[ "$KEYBOARD" != "$kb_before" ]]; then
          friday_note "  The keyboard changed, so type your password again with it."
          step_security
        fi ;;
      "Change desktop") step_look ;;
      "Change what FRIDAY may do") step_features ;;
      "Change AI") step_ai ;;
      *) leave_menu "Nothing was written to disk." ;;
    esac
  done
}

# ------------------------------------------------------------------ flow

step_welcome
step_network
step_disk
step_region
step_identity
step_security
step_look
step_features
step_ai
review

friday_banner
friday_say "Thanks, $USERNAME. I'll take it from here."
sleep 1
FRIDAY_HOSTNAME="$HOSTNAME"
export TARGET_DISK KEYBOARD HOSTNAME FRIDAY_HOSTNAME USERNAME PASSWORD TIMEZONE THEME SHELL_STYLE SESSION SDDM_THEME FRIDAY_AI_PROVIDER FRIDAY_AI_KEY AUTOLOGIN ENCRYPT FEAT_DESKTOP FEAT_TASKS FEAT_APPNAME FEAT_SCREENTEXT
export FRIDAY_INTERACTIVE=1
/root/installer || leave_menu "Something went wrong during the install. The full log is in /tmp/friday-installer.log."
leave_menu ""
