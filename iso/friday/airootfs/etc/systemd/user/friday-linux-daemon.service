[Unit]
Description=FRIDAY Linux Host Daemon
# Enabled globally (all users' default.target), but it serves the desktop
# user: never start it for root or system accounts. A root session (e.g. a
# root console login) would otherwise take 127.0.0.1:18432 first.
ConditionUser=!@system

[Service]
Type=notify
# Provider API keys + FRIDAY_CONTEXT_PROVIDER (written by the installer; optional).
EnvironmentFile=-%h/.config/friday/friday.env
ExecStart=/usr/bin/friday-linux-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
