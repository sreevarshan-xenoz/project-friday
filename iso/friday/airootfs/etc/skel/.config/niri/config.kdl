// FRIDAY OS on niri: a scrollable-tiling desktop with FRIDAY Shell.
// niri's documentation: https://niri-wm.github.io/niri/ (`niri validate` checks
// this file). Keys follow FRIDAY OS on Hyprland where niri has the same idea.

// FRIDAY's keys (Super+Y, Super+Alt+Y, Super+Ctrl+Y, Super+A, Super+N) and
// FRIDAY Shell, from the friday-git package.
include "/usr/share/friday/niri/friday.kdl"
// Window gaps, corners and the focus ring, matched to FRIDAY Shell's style and
// palette by `friday shell style|palette` (and the shell's Look picker).
include "../friday/niri-look.kdl"

input {
    keyboard {
        xkb {
            // Empty: the system layout (localectl set-x11-keymap). Or e.g.
            // layout "us,de"; options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    border { off; }
    shadow { off; }
}

// FRIDAY Shell draws the bar and notifications; apps draw no title bars.
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"
hotkey-overlay { skip-at-startup; }

spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
// The wallpaper: the current Omarchy theme's background (Omarchy's own shell
// draws it on Hyprland, and isn't started here).
spawn-at-startup "sh" "-c" "exec swaybg -m fill -i \"$HOME/.local/state/omarchy/current/background\""

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps.
    Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+Space hotkey-overlay-title="Apps" { spawn "friday" "shell" "launcher"; }
    Mod+Escape hotkey-overlay-title="Lock, log out, power" { spawn "friday" "shell" "session"; }
    Mod+Ctrl+L hotkey-overlay-title="Lock" { spawn "hyprlock"; }
    Mod+W repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Focus and move: columns left/right, windows up/down.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Workspaces (per monitor, made as needed).
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Sizes.
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Screenshots.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Volume, brightness, media (FRIDAY Shell shows the change).
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
