# The live session is only the text-mode setup (gum, jq) on tty1: setup
# downloads the desktop onto the new system (the installer's pacstrap list),
# so the desktop is not in the live image. Keeps the ISO under GitHub's 2 GiB
# release-asset limit.
gum
jq

# FRIDAY itself (daemon, CLI, user service): built by build-iso.sh from
# packaging/arch into the local [friday] repo, not from the Arch repos.
friday-git
