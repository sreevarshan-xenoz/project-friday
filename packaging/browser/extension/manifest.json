{
  "manifest_version": 3,
  "name": "FRIDAY",
  "version": "1.1",
  "description": "Lets FRIDAY on this computer read the tab you're on when you ask about it. Nothing is read until you ask; never private windows.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "browser@friday-os", "strict_min_version": "128.0" } }
}
