#compdef friday friday-os
# zsh completion for the FRIDAY CLI.

_friday() {
  local -a commands
  commands=(
    'ask:Ask FRIDAY (prompts if no text)'
    'goal:Dispatch an autonomous goal'
    'cancel:Cancel the goal FRIDAY is working on'
    'answers:Show past answers'
    'sent:Show what left this machine for AI providers'
    'undo:Put back the last thing FRIDAY changed'
    'status:Inspect daemon state and telemetry'
    'doctor:Check daemon, AI provider and desktop health'
    'report:Write a redacted bug report to read and share'
    'setup-ai:Set or change the AI provider key'
    'connect:Use an AI account you already have'
    'disconnect:Stop using a connected account'
    'private:Private mode with a local model only'
    'local-ai:A local model sized to this computer'
    'providers:How each AI provider is doing'
    'face:Face unlock for the lock screen'
    'voice:Hold Super+Y and speak'
    'screen-text:Ask about the screen with the window text, not a screenshot'
    'phone:Pair a phone with Pocketdesk'
    'helper:System helper for package updates and installs'
    'welcome:Show the first-login greeting again'
    'app:Open FRIDAY Settings'
    'app-context:Whether selected-text questions name the app they came from'
    'forget:Show what FRIDAY keeps, or wipe it'
    'actions:Show what FRIDAY did on your desktop'
    'tasks:Standing tasks (every morning ...): list, pause, delete, turn off'
    'desktop:Let FRIDAY control your windows, apps, volume and music'
    'keys:Add FRIDAY keys from a newer version to your key file'
    'context:Share screen context with the assistant'
    'daemon:Control the friday-linux-daemon service'
    'create-skill:Create a new skill template'
    'validate:Validate a skill manifest'
    'publish:Publish a validated skill'
    'shell:Run FRIDAY Shell or toggle one of its drawers'
    'theme:Switch the desktop theme'
    'bar:Configure the Quickshell bar'
    'update:Update the system'
    'menu:Launch the system control menu'
    'commands:List desktop substrate commands'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'friday command' commands
    return
  fi

  case "$words[2]" in
    ask)      _arguments '(-s --selection --screen -r --region -f --follow-up)'{-s,--selection}'[ask about the selected/copied text]' \
                '(-s --selection --screen -r --region -f --follow-up)--screen[ask about what is on screen]' \
                '(-s --selection --screen -r --region -f --follow-up)'{-r,--region}'[drag out an area of the screen and ask about it]' \
                '(-s --selection --screen -r --region -f --follow-up)'{-f,--follow-up}'[ask about the last answer]' \
                '--web[search the web for facts and cite sources]' \
                '(-n --new)'{-n,--new}'[start a new conversation]' \
                '--another[ask again, answered with more care by a different model]:model (provider/model):' '*:question:' ;;
    answers)  _arguments '--last[show only the last answer]' ;;
    sent)     _arguments '1:count:' ;;
    phone)    _values 'action' status on off ;;
    screen-text) _values 'action' status on off ;;
    forget)   _values 'what' answers sent memory actions all ;;
    actions)  _arguments '1:count:' ;;
    tasks)    _values 'action' list --json pause resume delete status on off ;;
    desktop)  _values 'action' status on off ;;
    keys)     _values 'action' update ;;
    connect|disconnect) _values 'account' claude codex agy cline hermes ;;
    private)  _values 'action' status on off ;;
    local-ai) _values 'action' summary presets install status order bench off ;;
    app-context) _values 'action' status on off ;;
    face)     _values 'action' status setup remove ;;
    voice)    _values 'action' status setup remove ;;
    helper)   _values 'action' status enable disable ;;
    setup-ai) _arguments '--keep-others[keep the other providers'"'"' keys]' '--only[use only this provider'"'"'s key]' '1:provider:(opencode gemini groq nvidia-nim openrouter cerebras runcrate axforge local)' ;;
    welcome)  _arguments '--force[show it even if already shown]' ;;
    daemon)   _values 'action' status start stop restart logs ;;
    shell)    _values 'action' start restart stop close ipc friday control calendar launcher session ;;
    context)  _values 'source' screen ;;
    validate|publish) _files ;;
  esac
}

_friday "$@"
