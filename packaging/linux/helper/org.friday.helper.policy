<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>FRIDAY</vendor>
  <vendor_url>https://github.com/sreevarshan-xenoz/project-friday</vendor_url>

  <!-- Only the person at an active local session can be asked: a background,
       inactive or remote caller gets no prompt and no answer but "no". -->

  <action id="org.friday.helper.update">
    <description>Update the system</description>
    <message>FRIDAY wants to update all the packages on this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.friday.helper.install">
    <description>Install a package</description>
    <message>FRIDAY wants to install the package $(package)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.friday.helper.remove">
    <description>Remove a package</description>
    <message>FRIDAY wants to remove the package $(package)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
