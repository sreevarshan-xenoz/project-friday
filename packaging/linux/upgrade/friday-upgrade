#!/bin/bash
# FRIDAY's safe upgrade (root; friday-upgrade.service, `friday upgrade now`):
# the whole system with pacman -Syu, FRIDAY included (it's a package).
#   1. Only when it's a good moment: on mains power, online, room on disk,
#      pacman not busy.
#   2. Before: the package list, a Btrfs snapshot when snapper is set up, and
#      each person's FRIDAY settings backed up.
#   3. The upgrade itself. Nothing running is restarted: programs pick up the
#      new versions when next started, a new kernel at the next restart.
#   4. After: FRIDAY's daemon, its CLI and the desktop must still start; if
#      one doesn't, the previous versions go back from pacman's cache.
# The outcome is in $STATE/last.json (read by `friday upgrade status`).
set -uo pipefail

STATE="${FRIDAY_UPGRADE_STATE:-/var/lib/friday/upgrade}"
CACHE="${FRIDAY_PACMAN_CACHE:-/var/cache/pacman/pkg}"
HOMES="${FRIDAY_UPGRADE_HOMES:-/home}"
SYS="${FRIDAY_SYS:-/sys}"
LOG="$STATE/upgrade.log"
# The outcome (last.json) is for everyone to read; the log, the package
# lists and the settings backups are root's only.
mkdir -p "$STATE" && chmod 755 "$STATE"
( umask 077; touch "$LOG" )
ts=$(date +%Y%m%d-%H%M%S)

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }
result() { # <outcome> <message> [reverted]
  jq -n --arg o "$1" --arg m "$2" --arg t "$(date -Is)" --argjson r "${3:-false}" --argjson k "${kernel:-false}" \
    '{outcome: $o, message: $m, at: $t, reverted: $r, restart_for_kernel: $k}' >"$STATE/last.json.tmp" \
    && chmod 644 "$STATE/last.json.tmp" && mv -f "$STATE/last.json.tmp" "$STATE/last.json"
  log "$1: $2"
}

# 1. A good moment?
on_battery() {
  local s seen=false
  for s in "$SYS"/class/power_supply/*/online; do
    [ -e "$s" ] || continue
    seen=true
    [ "$(cat "$s")" = 1 ] && return 1
  done
  $seen
}
if on_battery; then result skipped "on battery: waiting for mains power"; exit 0; fi
if [ -e /var/lib/pacman/db.lck ]; then result skipped "pacman is busy"; exit 0; fi
free_mb=$(df -Pm / | awk 'NR == 2 { print $4 }')
if [ "${free_mb:-0}" -lt 2048 ]; then result skipped "less than 2 GB free on /"; exit 0; fi
if ! timeout 10 pacman -Sy >>"$LOG" 2>&1; then result skipped "offline, or the mirrors didn't answer"; exit 0; fi
pending=$(pacman -Qu 2>/dev/null | wc -l)
if [ "$pending" -eq 0 ]; then result current "everything is up to date"; exit 0; fi

# 2. Before.
before="$STATE/before-$ts.txt"
( umask 077; pacman -Q >"$before" )
snapshot=""
if command -v snapper >/dev/null 2>&1 && [ "$(stat -f -c %T / 2>/dev/null)" = btrfs ]; then
  snapshot=$(snapper create -t pre -p -d "FRIDAY upgrade $ts" 2>>"$LOG" || true)
fi
backup="$STATE/settings-$ts.tar"
(
  umask 077
  cd "$HOMES" 2>/dev/null && tar -cf "$backup" --ignore-failed-read ./*/.config/friday 2>/dev/null || true
)
# Keep the newest three of each.
ls -1t "$STATE"/before-*.txt 2>/dev/null | tail -n +4 | xargs -r rm -f
ls -1t "$STATE"/settings-*.tar 2>/dev/null | tail -n +4 | xargs -r rm -f

# 3. The upgrade.
kernel=false
pacman -Qu 2>/dev/null | grep -qE '^linux(-lts|-zen|-hardened)? ' && kernel=true
if ! pacman -Su --noconfirm >>"$LOG" 2>&1; then
  failed_upgrade=true
else
  failed_upgrade=false
fi
[ -z "$snapshot" ] || snapper create -t post --pre-number "$snapshot" -d "FRIDAY upgrade $ts" >>"$LOG" 2>&1 || true

# 4. After: does what FRIDAY needs still start?
# (Loads: every library it needs is there. Nothing is started.)
healthy() {
  local bin path
  for bin in friday-linux-daemon friday-ctl Hyprland quickshell niri; do
    path=$(command -v "$bin" 2>/dev/null) || continue
    if ldd "$path" 2>&1 | grep -q 'not found'; then
      log "broken after the upgrade: $bin is missing a library"
      return 1
    fi
  done
  if path=$(command -v friday 2>/dev/null) && ! bash -n "$path" 2>>"$LOG"; then
    log "broken after the upgrade: the friday command doesn't parse"
    return 1
  fi
}
revert() {
  # Every package whose version changed goes back to the one in $before,
  # from pacman's cache.
  local name old files=()
  while read -r name old; do
    [ "$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)" = "$old" ] && continue
    f=$(find "$CACHE" -maxdepth 1 -name "$name-$old-*.pkg.tar.zst" ! -name '*.sig' 2>/dev/null | head -n1)
    if [ -n "$f" ]; then files+=("$f"); else log "no cached $name $old to go back to"; fi
  done <"$before"
  (( ${#files[@]} )) || return 1
  pacman -U --noconfirm "${files[@]}" >>"$LOG" 2>&1
}
if $failed_upgrade || ! healthy; then
  why="the upgrade failed"
  $failed_upgrade || why="something didn't start after the upgrade"
  if revert && healthy; then
    result reverted "$why; the previous versions are back" true
  else
    result broken "$why, and going back didn't fix it: see $LOG${snapshot:+ (snapshot $snapshot)}" false
    exit 1
  fi
  exit 0
fi
result upgraded "$pending packages upgraded"
