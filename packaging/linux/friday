# friday_fetch <url> <sha256> <dest>: download, check, then move into place.
friday_fetch() {
  local part="$3.part"
  mkdir -p "$(dirname "$3")"
  curl -fL --retry 3 -o "$part" "$1" || { rm -f "$part"; echo "download failed: $1"; return 1; }
  if ! echo "$2  $part" | sha256sum -c --status 2>/dev/null; then
    rm -f "$part"; echo "checksum mismatch for $(basename "$3")"; return 1
  fi
  mv "$part" "$3"
}

# friday_wait_http <url> <seconds>
friday_wait_http() {
  local i=0
  while (( i < $2 )); do
    curl -s -f -o /dev/null "$1" 2>/dev/null && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

friday_local_failed() {
  friday_local_conf_set state failed
  friday_local_conf_set reason "$1"
  echo "Local AI setup failed: $1" >&2
  notify-send -a FRIDAY -u normal "Local AI setup failed" "$1. Cloud answers meanwhile; try again: friday local-ai install" 2>/dev/null || true
}

# The model on Ollama: the package is already installed (the installer or
# friday setup-ai local), its service listens on 11434.
friday_local_install_ollama() {
  command -v ollama >/dev/null 2>&1 || { echo "Ollama isn't installed (friday setup-ai local installs it)"; return 1; }
  friday_wait_http "http://127.0.0.1:11434/" 60 || { echo "Ollama isn't running (sudo systemctl enable --now ollama)"; return 1; }
  ollama pull "$1" >&2 || { echo "ollama pull $1 failed"; return 1; }
  LOCAL_BASE_URL="http://127.0.0.1:11434/v1"
}

# The model on llama.cpp's release build, served by friday-llama.service.
friday_local_install_llamacpp() {
  local model="$1" gpu="$2" kind=cpu asset sha row repo rev file fsha msha args
  [[ $gpu != none ]] && kind=vulkan
  asset="llama-$FRIDAY_LLAMA_BUILD-bin-ubuntu-$([[ $kind == vulkan ]] && echo vulkan-)x64.tar.gz"
  sha=$(awk -F'|' -v k="$kind" '$1 == k { print $2 }' <<<"$FRIDAY_LLAMA_SHA")
  row=$(awk -F'|' -v id="$model" '$1 == id' <<<"$FRIDAY_LOCAL_GGUF")
  IFS='|' read -r _ repo rev file fsha msha <<<"$row"
  [[ -n "$file" ]] || { echo "no llama.cpp download for $model"; return 1; }
  local dl="$FRIDAY_LLAMA_DIR/downloads"
  friday_fetch "https://github.com/ggml-org/llama.cpp/releases/download/$FRIDAY_LLAMA_BUILD/$asset" "$sha" "$dl/$asset" || return 1
  tar -xzf "$dl/$asset" -C "$FRIDAY_LLAMA_DIR" --strip-components=1 || { echo "could not unpack $asset"; return 1; }
  rm -f "$dl/$asset"
  local hf="https://huggingface.co/$repo/resolve/$rev"
  friday_fetch "$hf/$file" "$fsha" "$FRIDAY_LLAMA_DIR/models/$file" || return 1
  # No thinking out loud: on a CPU it costs hundreds of tokens per answer.
  # Asleep after 5 idle minutes (the model leaves memory, as Ollama's does);
  # the next question wakes it in about a second.
  args="-m $FRIDAY_LLAMA_DIR/models/$file -c 8192 --reasoning off --sleep-idle-seconds 300"
  if [[ -n "$msha" ]]; then
    friday_fetch "$hf/mmproj-model-f16.gguf" "$msha" "$FRIDAY_LLAMA_DIR/models/${file%.gguf}-mmproj.gguf" || return 1
    args="$args --mmproj $FRIDAY_LLAMA_DIR/models/${file%.gguf}-mmproj.gguf"
  fi
  [[ $kind == vulkan ]] && args="$args --n-gpu-layers 99"
  (umask 077; echo "LLAMA_ARGS=$args" >"$(dirname "$FRIDAY_LOCAL_CONF")/llama.env")
  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user enable --now friday-llama.service >/dev/null 2>&1 || { echo "could not start friday-llama.service"; return 1; }
  if ! friday_wait_http "http://127.0.0.1:8080/health" 180; then
    systemctl --user disable --now friday-llama.service >/dev/null 2>&1 || true
    echo "the llama.cpp server didn't start (journalctl --user -u friday-llama)"; return 1
  fi
  LOCAL_BASE_URL="http://127.0.0.1:8080/v1"
}

# friday local-ai install [--engine ollama|llamacpp] [--budget MB] [--first-login]
friday_local_ai_install() {
  local engine budget first=false
  engine=$(friday_local_conf_get engine); budget=$(friday_local_conf_get budget_mb)
  while (( $# )); do
    case "$1" in
      --engine) engine="$2"; shift ;;
      --budget) budget="$2"; shift ;;
      --first-login) first=true ;;
      *) echo "usage: friday local-ai install [--engine ollama|llamacpp] [--budget MB]" >&2; return 2 ;;
    esac
    shift
  done
  if $first; then
    # Anything but ready: a reboot mid-download leaves "installing".
    [[ "$(friday_local_conf_get state)" != ready ]] || return 0
    # A user unit can't wait for network-online.target, so wait here (2 min).
    local i=0
    until curl -s -o /dev/null --max-time 5 https://github.com 2>/dev/null || (( ++i >= 24 )); do sleep 5; done
  fi
  [[ $engine == ollama || $engine == llamacpp ]] || { echo "choose an engine: --engine ollama|llamacpp" >&2; return 2; }
  [[ $budget =~ ^[0-9]+$ ]] || { echo "choose a budget: --budget MB (friday local-ai presets)" >&2; return 2; }
  friday_local_conf_set engine "$engine"
  friday_local_conf_set budget_mb "$budget"
  local model need dl vision gpu
  model=$(friday_local_ai_model "$budget")
  [[ -n "$model" ]] || { friday_local_failed "too little memory for local AI ($(friday_gb "$budget"))"; return 1; }
  read -r need dl vision <<<"$(friday_local_ai_info "$model")"
  gpu=$(friday_local_ai_detect | sed -n 's/^gpu=//p')
  friday_local_conf_set model "$model"
  friday_local_conf_set state installing
  friday_local_conf_set reason ""
  echo "Setting up $model on $engine ($(friday_gb "$dl") download)..."
  # The engine step prints only its failure reason on stdout (progress goes
  # to stderr) and sets LOCAL_BASE_URL, so it runs here, not in $( ).
  local LOCAL_BASE_URL="" errf
  errf=$(mktemp)
  if ! "friday_local_install_$engine" "$model" "$gpu" >"$errf"; then
    friday_local_failed "$(tail -n1 "$errf" || true)"; rm -f "$errf"; return 1
  fi
  rm -f "$errf"
  # How fast it answers here: Auto keeps a slow big model behind cloud.
  echo "Timing $model on this computer..."
  friday_local_conf_set speed_tps "$(friday_local_ai_bench "$LOCAL_BASE_URL" "$model")"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" local_first
  local_first=$(friday_local_ai_local_first "$model" "$(friday_local_conf_get order)" "$(friday_local_conf_get speed_tps)")
  (
    umask 077
    { grep -vE '^(LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION|FRIDAY_LOCAL_FIRST)=' "$env_file" 2>/dev/null || true
      echo "LLAMACPP_ENABLED=1"
      echo "LLAMACPP_BASE_URL=$LOCAL_BASE_URL"
      echo "LLAMACPP_MODEL=$model"
      echo "LLAMACPP_VISION=$vision"
      echo "FRIDAY_LOCAL_FIRST=$local_first"
    } >"$env_file.tmp"
    mv "$env_file.tmp" "$env_file"
  )
  friday_local_conf_set state ready
  systemctl --user restart friday-linux-daemon 2>/dev/null || true
  local sees="text only: screenshots go to your cloud provider" when="answers first"
  (( vision )) && sees="sees screenshots"
  (( local_first )) || when="backs up cloud"
  notify-send -a FRIDAY "Local AI is on" "$model on this computer ($sees, $when)" 2>/dev/null || true
  echo "Local AI is on: $model ($sees, $when). Change the order: friday local-ai order local|cloud|auto"
}

friday_local_ai_status() {
  if [[ ! -f "$FRIDAY_LOCAL_CONF" ]]; then echo "Local AI: not set up (friday setup-ai local)"; return 0; fi
  local state model engine reason
  state=$(friday_local_conf_get state); model=$(friday_local_conf_get model)
  engine=$(friday_local_conf_get engine); reason=$(friday_local_conf_get reason)
  case "$state" in
    ready) echo "Local AI: on, ${model:-?} on $engine"; friday_local_ai_order ;;
    installing) echo "Local AI: downloading ${model:-the model} for $engine" ;;
    pending) echo "Local AI: waits for the next login to download (or run: friday local-ai install)" ;;
    failed) echo "Local AI: setup failed: $reason (try again: friday local-ai install)" ;;
    *) echo "Local AI: ${state:-unknown}" ;;
  esac
}

# friday local-ai order [auto|local|cloud]: who answers first. Auto decides
# by the model's size (friday_local_ai_local_first).
friday_local_ai_order() {
  local want="${1:-}" order model first
  if [ ! -f "$FRIDAY_LOCAL_CONF" ]; then echo "Local AI isn't set up (friday setup-ai local)" >&2; return 1; fi
  model=$(friday_local_conf_get model)
  if [ -n "$want" ]; then
    case "$want" in auto|local|cloud) ;; *) echo "usage: friday local-ai order [auto|local|cloud]" >&2; return 2 ;; esac
    friday_local_conf_set order "$want"
    if [ "$(friday_local_conf_get state)" = ready ]; then
      friday_env_set FRIDAY_LOCAL_FIRST "$(friday_local_ai_local_first "$model" "$want" "$(friday_local_conf_get speed_tps)")"
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
    fi
  fi
  order=$(friday_local_conf_get order); order="${order:-auto}"
  local tps; tps=$(friday_local_conf_get speed_tps)
  first=$(friday_local_ai_local_first "$model" "$order" "$tps")
  if [ "$first" = 1 ]; then echo "Order: $order: ${model:-the local model} answers first; cloud covers what it can't."
  else echo "Order: $order: cloud answers first while online; ${model:-the local model} takes over when it can't."; fi
  [ -z "$tps" ] || echo "Speed: about $tps tokens a second here (friday local-ai bench measures again)."
}

# friday local-ai bench: time the local model again (after a driver or
# hardware change) and let Auto use the new speed.
friday_local_ai_bench_cmd() {
  [ "$(friday_local_conf_get state)" = ready ] || { echo "Local AI isn't on yet (friday local-ai status)" >&2; return 1; }
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" url model tps
  url=$(sed -n 's/^LLAMACPP_BASE_URL=//p' "$env_file" 2>/dev/null | tail -n1)
  model=$(friday_local_conf_get model)
  echo "Timing $model..."
  tps=$(friday_local_ai_bench "$url" "$model")
  [ -n "$tps" ] || { echo "It didn't answer; is it running? (friday local-ai status)" >&2; return 1; }
  friday_local_conf_set speed_tps "$tps"
  friday_env_set FRIDAY_LOCAL_FIRST "$(friday_local_ai_local_first "$model" "$(friday_local_conf_get order)" "$tps")"
  systemctl --user restart friday-linux-daemon 2>/dev/null || true
  friday_local_ai_order
}

# Back to cloud only: the local model stays on disk.
friday_local_ai_off() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  if [[ -f "$env_file" ]]; then
    (umask 077; grep -vE '^(LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION|FRIDAY_LOCAL_FIRST)=' "$env_file" >"$env_file.tmp" || true; mv "$env_file.tmp" "$env_file")
  fi
  systemctl --user disable --now friday-llama.service >/dev/null 2>&1 || true
  rm -f "$FRIDAY_LOCAL_CONF"
  systemctl --user restart friday-linux-daemon 2>/dev/null || true
  echo "Local AI is off. The model stays on disk (ollama rm, or $FRIDAY_LLAMA_DIR, to free the space)."
}

# The machine in one line, then a line per caveat.
friday_local_ai_summary() {
  local hw ram_mb gpu vram threads avx2 line
  hw=$(friday_local_ai_detect)
  ram_mb=$(sed -n 's/^ram_mb=//p' <<<"$hw"); gpu=$(sed -n 's/^gpu=//p' <<<"$hw")
  vram=$(sed -n 's/^vram_mb=//p' <<<"$hw"); threads=$(sed -n 's/^cpu_threads=//p' <<<"$hw")
  avx2=$(sed -n 's/^avx2=//p' <<<"$hw")
  line="$(friday_gb "$ram_mb") memory"
  case "$gpu" in
    nvidia) line="$line, NVIDIA GPU" ;;
    amd) line="$line, AMD GPU" ;;
    intel) line="$line, Intel graphics" ;;
  esac
  [[ $vram != unknown && $gpu != intel ]] && line="$line $(friday_gb "$vram")"
  echo "$line, $threads threads"
  if [[ $gpu == nvidia && $vram == unknown ]]; then
    echo "Its video memory can be read once the NVIDIA driver is installed; then friday setup-ai local offers a GPU preset."
  fi
  if [[ $gpu == none && $avx2 == no ]]; then
    echo "This computer is old for local AI: answers will be very slow."
  fi
}

# friday local-ai packages <engine>: the Arch packages it needs on this GPU.
# With no GPU driver both engines fall back to the CPU.
friday_local_ai_packages() {
  local gpu
  gpu=$(friday_local_ai_detect | sed -n 's/^gpu=//p')
  case "$1:$gpu" in
    ollama:nvidia)   echo ollama-cuda ;;
    ollama:none)     echo ollama ;;
    ollama:*)        echo ollama-vulkan ;;
    llamacpp:amd)    echo vulkan-icd-loader vulkan-radeon ;;
    llamacpp:intel)  echo vulkan-icd-loader vulkan-intel ;;
    llamacpp:nvidia) echo vulkan-icd-loader ;;
    llamacpp:none)   ;;
    *) echo "usage: friday local-ai packages <ollama|llamacpp>" >&2; return 2 ;;
  esac
}

# `friday setup-ai local [--engine E] [--preset ID]`: the installer's local AI
# steps, after install. Asks with gum when a choice isn't given.
friday_setup_local() {
  local engine="" preset=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --engine) engine="$2"; shift 2 ;;
      --preset) preset="$2"; shift 2 ;;
      *) echo "usage: friday setup-ai local [--engine ollama|llamacpp] [--preset light|balanced|most|gpu]" >&2; return 2 ;;
    esac
  done
  echo "Local AI runs on this computer: it works offline, but it's slower than cloud."
  echo "This computer: $(friday_local_ai_summary | head -n1)"
  friday_local_ai_summary | tail -n +2
  if [ -z "$engine" ]; then
    command -v gum >/dev/null || { echo "choose an engine: --engine ollama|llamacpp" >&2; return 2; }
    case "$(gum choose --cursor="❯ " "Ollama (simplest; from the Arch repos)" "llama.cpp (lighter; llama.cpp's official build)")" in
      llama.cpp*) engine=llamacpp ;; Ollama*) engine=ollama ;; *) return 1 ;;
    esac
  fi
  local presets id label budget model dl vision fast available note
  local -a options=() rows=()
  presets=$(friday_local_ai_presets)
  while IFS='|' read -r id label budget model dl vision fast available note; do
    [ -n "$id" ] || continue
    if [ -z "$model" ] || [ "$available" != 1 ]; then echo "  ${label%% (*}: $note"; continue; fi
    options+=("$id: $label: $model, $(friday_gb "$dl") download, $note")
    rows+=("$id|$budget")
  done <<<"$presets"
  [ ${#options[@]} -gt 0 ] || { echo "This computer can't run a local model well; FRIDAY keeps using cloud providers." >&2; return 1; }
  echo "The amount picks the model. It's in memory only while FRIDAY answers, and freed after 5 idle minutes."
  echo "Models above 4B answer first. Smaller ones back up cloud, so your questions go to a cloud model first;"
  echo "to keep everything on this computer: friday local-ai order local (or friday private on)."
  if [ -z "$preset" ]; then
    command -v gum >/dev/null || { printf '  %s\n' "${options[@]}"; echo "choose one: --preset <id>" >&2; return 2; }
    preset=$(printf '%s\n' "${options[@]}" | gum choose --cursor="❯ " --height=8) || return 1
    preset="${preset%%:*}"
  fi
  budget=$(printf '%s\n' "${rows[@]}" | awk -F'|' -v id="$preset" '$1 == id { print $2 }')
  [ -n "$budget" ] || { echo "no such preset here: $preset (friday local-ai presets)" >&2; return 2; }
  local pkgs missing=false
  pkgs=$(friday_local_ai_packages "$engine")
  if [ "$engine" = ollama ] && ! command -v ollama >/dev/null 2>&1; then missing=true; fi
  if [ -n "$pkgs" ] && { $missing || [ "$engine" = llamacpp ]; }; then
    # shellcheck disable=SC2086 # one package name per word
    sudo pacman -S --needed --noconfirm $pkgs || return 1
  fi
  if [ "$engine" = ollama ]; then sudo systemctl enable --now ollama || return 1; fi
  friday_local_conf_set state pending
  friday_local_ai_install --engine "$engine" --budget "$budget"
}

friday_local_ai() {
  local sub="${1:-presets}"
  case "$sub" in
    detect) friday_local_ai_detect ;;
    presets) friday_local_ai_presets ;;
    summary) friday_local_ai_summary ;;
    install) shift; friday_local_ai_install "$@" ;;
    status) friday_local_ai_status ;;
    off) friday_local_ai_off ;;
    packages) friday_local_ai_packages "${2:-}" ;;
    order) friday_local_ai_order "${2:-}" ;;
    bench) friday_local_ai_bench_cmd ;;
    *) echo "usage: friday local-ai [detect|presets|summary|install|status|order|bench|off|packages]" >&2; return 2 ;;
  esac
}

friday_private() {
  local sub="${1:-status}"
  case "$sub" in
    on)
      shift
      local model="${1:-}"
      local vision=1
      echo "Answers stay on this computer — nothing leaves this machine."
      echo "Slower than cloud models and uses your computer's CPU or GPU."
      echo "Downloads a model sized to this computer's memory (see: friday local-ai presets)."
      if [ -z "$model" ]; then
        # The Balanced preset: half the memory (friday local-ai presets).
        local ram_mb
        ram_mb=$(friday_local_ai_detect | sed -n 's/^ram_mb=//p')
        model=$(friday_local_ai_model $((ram_mb / 2)))
        if [ -z "$model" ]; then
          echo "This computer has too little memory for a local model ($(friday_gb "$ram_mb"))." >&2
          return 1
        fi
        vision=$(friday_local_ai_info "$model" | awk '{print $3}')
      else
        case "$model" in
          *gemma3*|*vision*|*llava*|*minicpm*|*moondream*) vision=1 ;;
          *) vision=0 ;;
        esac
      fi
      sudo pacman -S --needed --noconfirm ollama
      sudo systemctl enable --now ollama
      local i=0
      while [ "$i" -lt 20 ]; do
        if curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
          break
        fi
        sleep 1
        i=$((i + 1))
      done
      if ! curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
        echo "Timed out waiting for Ollama at http://127.0.0.1:11434" >&2
        return 1
      fi
      ollama pull "$model"
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      mkdir -p "$(dirname "$env_file")"
      (
        umask 077
        {
          grep -vE '^(FRIDAY_PRIVATE|LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION)=' "$env_file" 2>/dev/null || true
          echo "FRIDAY_PRIVATE=1"
          echo "LLAMACPP_ENABLED=1"
          echo "LLAMACPP_BASE_URL=http://127.0.0.1:11434/v1"
          echo "LLAMACPP_MODEL=$model"
          echo "LLAMACPP_VISION=$vision"
        } >"$env_file.tmp"
        chmod 0600 "$env_file.tmp"
        mv -f "$env_file.tmp" "$env_file"
      )
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Private mode is on: $model on this computer."
      ;;
    off)
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      local old_model="<model>"
      if [ -f "$env_file" ]; then
        old_model=$(sed -n 's/^LLAMACPP_MODEL=//p' "$env_file" 2>/dev/null | tail -n1)
        old_model="${old_model:-<model>}"
        (
          umask 077
          grep -vE '^(FRIDAY_PRIVATE|LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION)=' "$env_file" >"$env_file.tmp" 2>/dev/null || true
          chmod 0600 "$env_file.tmp"
          mv -f "$env_file.tmp" "$env_file"
        )
      fi
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Private mode is off."
      echo "Ollama stays installed (sudo pacman -Rns ollama to remove it, ollama rm $old_model to free space)."
      ;;
    status)
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      local is_on=false
      local model=""
      if [ -f "$env_file" ]; then
        if grep -qE '^FRIDAY_PRIVATE=(1|true)' "$env_file" 2>/dev/null; then
          is_on=true
        fi
        model=$(sed -n 's/^LLAMACPP_MODEL=//p' "$env_file" 2>/dev/null | tail -n1)
      fi
      local ollama_running=false
      if curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
        ollama_running=true
      fi
      if $is_on; then
        echo "Private mode: on"
        [ -n "$model" ] && echo "Model: $model"
      else
        echo "Private mode: off"
        [ -n "$model" ] && echo "Model: $model"
      fi
      if $ollama_running; then
        echo "Ollama: running"
      else
        echo "Ollama: not running"
      fi
      ;;
    *)
      echo "Usage: friday private [status|on [model]|off]" >&2
      return 1
      ;;
  esac
}

case "${1:-}" in
  ""|"-h"|"--help"|"help")
    show_help
    exit 0
    ;;
  ask)
    # Desktop entry point (SUPER+Y): prompt, run the goal, report the outcome
    # as a notification, and keep the full answer on disk.
    #   friday ask [text]               ask (prompts if no text)
    #   friday ask --selection [text]   ask about the selected/copied text (SUPER+ALT+Y)
    #   friday ask --screen [text]      ask about what's on screen (SUPER+CTRL+Y);
    #                                   its text (or a screenshot) goes to the AI provider, this once
    #   friday ask --region [text]      drag out an area of the screen and ask about
    #                                   just that (any monitor)
    #   friday ask --follow-up [text]   ask about the last answer (the answer pill's
    #                                   Follow up)
    #   friday ask --web [text]         ask with web search results and cited sources
    #   friday ask --new [text]         start a new conversation (asks within 15
    #                                   minutes of each other share one: friday-ctl)
    #   friday ask --another provider/model [text]
    #                                   ask again, answered with more care by a
    #                                   different model (the answer pill's
    #                                   Try another model)
    # With FRIDAY Shell running, the answer opens in its answer pill (which also
    # streams it); otherwise it arrives as a notification.
    shift
    use_selection=false use_screen=false use_region=false use_followup=false use_web=false use_new=false another="" details="" daemon_down=false
    rewrite="" sel_window="" source_label=""
    ask_args=()
    while [ $# -gt 0 ]; do
      case "${1:-}" in
        --selection|-s) use_selection=true; ask_args+=(--selection); shift ;;
        --screen) use_screen=true; ask_args+=(--screen); shift ;;
        --region|-r) use_screen=true; use_region=true; ask_args+=(--region); shift ;;
        --follow-up|-f) use_followup=true; ask_args+=(--follow-up); shift ;;
        --web) use_web=true; ask_args+=(--web); shift ;;
        --new|-n) use_new=true; shift ;;
        --another) another="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
        *) break ;;
      esac
    done
    goal="$*"
    # The window you're asking about (its selection or its screen): private?
    private_win=""
    if $use_selection || $use_screen; then private_win=$(friday_private_window); fi
    # The private window itself, so a later read of its text can't land on
    # another window focused meanwhile.
    priv_win=""
    if $use_screen && [ -n "$private_win" ]; then priv_win=$(timeout 2 hyprctl activewindow -j 2>/dev/null || true); fi
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    history_file="$state_dir/ask-history"
    notify() { notify-send -a FRIDAY -- "$@" 2>/dev/null || true; }
    # FRIDAY Shell's answer pill (services/Answer.qml); fails when it isn't running.
    pill() { command -v quickshell >/dev/null 2>&1 && timeout 3 bash "$0" shell ipc answer "$@" >/dev/null 2>&1; }
    # Looked up while the ask box is open, not before it (each can take a
    # few seconds): the project in front (a terminal's git repo, kept with
    # the answer so "continue building X" finds X's history) and whether
    # FRIDAY Shell's pill is there. ask_lookups waits for them.
    lookups=$(mktemp -d)
    # Gone however the ask ends (a closed box exits early).
    trap 'rm -rf "$lookups"' EXIT
    { timeout 2 friday-ctl workspace project >"$lookups/project" 2>/dev/null || true; } &
    lookup_pids=$!
    { pill state && : >"$lookups/pill"; } &
    lookup_pids+=" $!"
    # The app in front now (the box doesn't take that), for its instructions.
    if [ -s "$(friday_app_instructions_file)" ]; then
      { friday_app_class >"$lookups/app" 2>/dev/null || true; } &
      lookup_pids+=" $!"
    fi
    ask_project="" use_pill=false ask_app=""
    ask_lookups() {
      [ -d "$lookups" ] || return 0
      # shellcheck disable=SC2086
      wait $lookup_pids 2>/dev/null || true
      ask_project=$(cat "$lookups/project" 2>/dev/null || true)
      ask_app=$(cat "$lookups/app" 2>/dev/null || true)
      [ ! -e "$lookups/pill" ] || use_pill=true
      rm -rf "$lookups"
    }

    context=""
    if $use_followup; then
      context=$(sed '/^<details>/,$d' "$state_dir/last-answer.md" 2>/dev/null || true)
      if [ -z "${context//[[:space:]]/}" ]; then
        notify "FRIDAY" "There's no answer to follow up on yet. Ask something with Super+Y first."
        exit 0
      fi
      context="${context:0:6000}"
      # An answer made on this computer keeps its follow-up here too.
      # (In the header lines, not anywhere in the answer's own text.)
      head -n 8 "$state_dir/last-answer.md" 2>/dev/null | grep -qx '_On this computer · nothing was sent_' && followup_local=true
    fi

    if $use_selection; then
      # Primary selection (highlighted text) first, then the clipboard.
      source_label="Selected"
      context=$(timeout 2 wl-paste --primary --no-newline 2>/dev/null || true)
      if [ -z "${context//[[:space:]]/}" ]; then
        source_label="Clipboard"
        context=$(timeout 2 wl-paste --no-newline 2>/dev/null || true)
        # The clipboard often holds a just-copied password or token. Never
        # send something shaped like one (a single long token mixing letters
        # and digits) to a cloud model by accident.
        if friday_secret_shaped "$context"; then
          notify "FRIDAY" "The clipboard looks like a password or token, so I won't send it. Highlight the text you mean instead."
          exit 0
        fi
      fi
      if [ -z "${context//[[:space:]]/}" ]; then
        notify "FRIDAY" "Select or copy some text first, then press Super+Alt+Y."
        exit 0
      fi
      context="${context:0:4000}"
      app_context=$(friday_app_context)
      sel_window=$(timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null || true)
    fi

    region=""
    if $use_region; then
      # Esc while dragging cancels; nothing is captured or sent.
      region=$(slurp 2>/dev/null) || exit 0
      [ -n "$region" ] || exit 0
    fi

    if [ -z "$goal" ]; then
      if $use_region; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY ⬚ " --width=70 \
          --placeholder="Ask about the area you picked (a screenshot of it goes to your AI provider)" </dev/null) || exit 0
      elif $use_followup; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=70 \
          --placeholder="Follow up on: $(head -n 1 <<<"$context" | sed 's/^# //' | cut -c1-50)" </dev/null) || exit 0
      elif $use_screen; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY 👁 " --width=70 \
          --placeholder="Ask about your screen (its text, or a screenshot if it has too little, goes to your AI provider)" </dev/null) || exit 0
      elif $use_selection; then
        # Quick actions, then your own prompts (one per line in
        # ~/.config/friday/prompts); Shift+Enter sends what you typed instead.
        preview=$(tr '\n\t' '  ' <<<"$context" | cut -c1-40)
        goal=$({
          # Highlighted text can be rewritten in place (the selection is replaced).
          if [ "$source_label" = Selected ]; then
            printf '%s\n' "Rewrite: fix grammar and spelling" "Rewrite: make it shorter" \
              "Rewrite: make it more formal" "Rewrite: make it friendlier" "Rewrite: translate to English"
          fi
          printf '%s\n' "Summarize this" "Explain this simply" "Translate this to English" \
            "Fix the grammar and spelling; reply with only the corrected text"
          sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "${XDG_CONFIG_HOME:-$HOME/.config}/friday/prompts" 2>/dev/null || true
        } | fuzzel --dmenu --prompt="FRIDAY › " --width=70 --lines=8 \
          --placeholder="$source_label: \"$preview…\" · pick or type (Shift+Enter sends it)") || exit 0
      elif last_error=$(friday_last_error) && running=$(friday_kitty_running) \
          && suggestions=$(friday_app_suggestions) \
          && term=$([ -n "$last_error$running" ] || friday_term_record) \
          && { [ -s "$history_file" ] || [ -n "$last_error$running$suggestions$term" ]; }; then
        # Recent asks, newest first. Enter re-runs the highlighted one;
        # Shift+Enter sends exactly what was typed (fuzzel execute-input).
        # A kitty window whose last command failed offers to explain it first.
        explain=""
        if [ -n "$last_error" ]; then
          IFS=$'\t' read -r le_exit le_cmd le_cwd le_sock le_id <<<"$last_error"
          explain="Explain the error from: $(cut -c1-60 <<<"$le_cmd") (exit $le_exit)"
        fi
        # One still running can be watched instead (friday-ctl watch kitty).
        tell_me=""
        if [ -n "$running" ]; then
          IFS=$'\t' read -r run_cmd run_sock run_id <<<"$running"
          tell_me="Tell me when this finishes: $(cut -c1-60 <<<"$run_cmd")"
        fi
        # Any other terminal, through friday shell-hook: a failure from the
        # last ten minutes, or the command running now.
        term_pid="" term_private=""
        if [ -n "$term" ]; then
          # Checked now, while the terminal still has the focus.
          term_private=$(friday_private_window)
          IFS=$'\t' read -r t_state t_when t_exit t_cwd t_cmd t_pid t_class <<<"$term"
          [ -n "$term_private" ] || term_private=$(friday_private_folder "$t_cwd")
          if [ "$t_state" = done ] && [[ "$t_exit" =~ ^[0-9]+$ ]] && [ "$t_exit" != 0 ] && [ "$t_exit" != 130 ] \
              && (( $(date +%s) - ${t_when:-0} < 600 )); then
            explain="Explain the error from: $(cut -c1-60 <<<"$t_cmd") (exit $t_exit)"
          elif [ "$t_state" = running ]; then
            tell_me="Tell me when this finishes: $(cut -c1-60 <<<"$t_cmd")"
            term_pid="$t_pid"
          fi
        fi
        # Then what fits the app you're in (friday_app_suggestions).
        goal=$({ [ -z "$explain" ] || printf '%s\n' "$explain"; [ -z "$tell_me" ] || printf '%s\n' "$tell_me"
          [ -z "$suggestions" ] || cut -f1 <<<"$suggestions"
          cat "$history_file" 2>/dev/null || true; } \
          | fuzzel --dmenu --prompt="FRIDAY › " --width=60 --minimal-lines --lines=8 \
          --placeholder="Ask anything · Shift+Enter sends your text as typed") || exit 0
        if [ -n "$suggestions" ]; then
          picked=$(awk -F'\t' -v g="$goal" '$1 == g { print $2 "\t" $3; exit }' <<<"$suggestions")
          if [ -n "$picked" ]; then
            rm -rf "$lookups"
            FRIDAY_SUGGESTED=1 exec bash "$0" ask "$(cut -f1 <<<"$picked")" "$(cut -f2- <<<"$picked")"
          fi
        fi
        if [ -n "$tell_me" ] && [ "$goal" = "$tell_me" ] && [ -n "$term_pid" ]; then
          setsid bash "$0" term-watch "$term_pid" </dev/null >/dev/null 2>&1 &
          notify-send -a FRIDAY -- "FRIDAY" "I'll tell you when $(cut -c1-60 <<<"$t_cmd") finishes." 2>/dev/null || true
          exit 0
        fi
        if [ -n "$tell_me" ] && [ "$goal" = "$tell_me" ]; then
          setsid friday-ctl watch kitty "$run_sock" "$run_id" "$run_cmd" </dev/null >/dev/null 2>&1 &
          notify-send -a FRIDAY -- "FRIDAY" "I'll tell you when $(cut -c1-60 <<<"$run_cmd") finishes." 2>/dev/null || true
          exit 0
        fi
        if [ -n "$explain" ] && [ "$goal" = "$explain" ] && [ -z "$last_error" ]; then
          # Another terminal: its text from WezTerm, else FRIDAY looks at the
          # window (picking this is asking it to).
          out=""; [[ "${t_class,,}" == *wezterm* ]] && out=$(friday_term_text "$t_pid" | tail -n 150)
          private_win="$term_private"
          goal="Explain why this command failed and how to fix it"
          if [ -n "$out" ]; then
            context=$(printf 'Command: %s\nFolder: %s\nExit code: %s\nOutput:\n%s' "$t_cmd" "$t_cwd" "$t_exit" "$out")
            [ "${#context}" -le 8000 ] || context="${context: -8000}"
          else
            goal=$(printf '%s. Command: %s. Folder: %s. Exit code: %s. Its output is in the terminal window shown.' "$goal" "$t_cmd" "$t_cwd" "$t_exit")
            use_screen=true; ask_args+=(--screen)
          fi
          explaining_error=true
        elif [ -n "$explain" ] && [ "$goal" = "$explain" ]; then
          # Its output, from kitty (the last 150 lines).
          out=$(timeout 3 kitten @ --to "unix:$le_sock" get-text --match "id:$le_id" --extent last_cmd_output 2>/dev/null \
            | tail -n 150 | cut -c1-400 || true)
          goal="Explain why this command failed and how to fix it"
          context=$(printf 'Command: %s\nFolder: %s\nExit code: %s\nOutput:\n%s' "$le_cmd" "$le_cwd" "$le_exit" "${out:-(no output)}")
          # The end matters most (the error is usually last).
          [ "${#context}" -le 8000 ] || context="${context: -8000}"
          explaining_error=true
          # A private terminal window, or a command run in a private folder
          # (private-windows: /… or ~/…).
          private_win=$(friday_private_window)
          [ -n "$private_win" ] || private_win=$(friday_private_folder "$le_cwd")
        fi
      else
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=60 \
          --placeholder="Ask anything" </dev/null) || exit 0
      fi
    fi
    # Privacy rule: web search happens ONLY when explicitly asked (--web, or question prefixes)
    shopt -s nocasematch
    if [[ "$goal" =~ ^search[[:space:]]+the[[:space:]]+web[[:space:]]+for[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    elif [[ "$goal" =~ ^search[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    elif [[ "$goal" =~ ^look[[:space:]]+up[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    fi
    # Asking about the screen in words is asking to look at it, the same as
    # Super+Ctrl+Y: never answer "I can't see your screen" to that. Narrow on
    # purpose ("how do I change my screen brightness" is not a look).
    if ! $use_screen && ! $use_selection && ! $use_followup && ! $use_web &&
      [[ ! "$goal" =~ ^(how|why)[[:space:]]+(do|to|can|should|would|does) ]] &&
      [[ "$goal" =~ (on|at|in)[[:space:]]+(my|the|this)[[:space:]]+(screen|window|display)|what[[:space:]]+am[[:space:]]+i[[:space:]]+(looking|looking[[:space:]]+at)|what.s[[:space:]]+on[[:space:]]+(my[[:space:]]+)?screen|look[[:space:]]+at[[:space:]]+(my|this)[[:space:]]+screen ]]; then
      use_screen=true
      ask_args+=(--screen)
    fi
    shopt -u nocasematch
    [ -n "${goal// /}" ] || exit 0
    # Things this computer can answer or do itself go nowhere.
    local_answer=""
    if ! $use_selection && ! $use_screen && ! $use_followup && ! ${explaining_error:-false}; then
      local_answer=$(friday_local_command "$goal") || local_answer=""
    fi
    # "Where's …" / "show me …": a ring around it in the window you're in;
    # when FRIDAY can't see inside that app, the question is answered in words.
    if [ -z "$local_answer" ] && ! $use_selection && ! $use_screen && ! $use_followup \
        && [[ "${goal,,}" =~ ^(where(\'s|\ is|\ are|\ do\ i\ find|\ can\ i\ find)|show\ me)\ .+ ]] \
        && friday_show "$goal"; then
      exit 0
    fi
    ask_lookups
    # Questions, selected text and answers are private: only you can open
    # this directory (also fixes one made world-readable by an older version).
    mkdir -p "$state_dir" && chmod 700 "$state_dir"
    # Remember the question (not the pasted context): newest first, no dups, last 50.
    # (Not an explained error or a rewrite: they mean nothing without the
    # error or the selection. Nor a suggestion: it comes back by itself
    # whenever it fits the app.)
    if ! ${explaining_error:-false} && [[ "$goal" != "Rewrite: "* ]] && [ -z "${FRIDAY_SUGGESTED:-}" ]; then
      { printf '%s\n' "$goal"; grep -vxF -- "$goal" "$history_file" 2>/dev/null || true; } \
        | head -n 50 >"$history_file.tmp" && mv -f "$history_file.tmp" "$history_file"
    fi

    request="$goal"
    if $use_followup; then
      request=$(printf '%s\n\n[follow-up]\nThis follows up on my previous question and your answer:\n"""\n%s\n"""' "$goal" "$context")
    elif [[ "$goal" == "Rewrite: "* ]] && $use_selection && [ "$source_label" = Selected ]; then
      rewrite="${goal#Rewrite: }"
      request=$(printf 'Rewrite the text below: %s. Keep its language unless told to translate. Reply with only the rewritten text: no quotes, no notes, no introduction.\n\n[text to rewrite]\n"""\n%s\n"""' "$rewrite" "$context")
    elif [ -n "$context" ]; then
      request=$(printf '%s\n\nUse this text as context:\n"""\n%s\n"""' "$goal" "$context")
      [ -z "${app_context:-}" ] || request="$request"$'\n'"$app_context"
    elif ! $use_screen && { [ -s "${XDG_STATE_HOME:-$HOME/.local/state}/friday/recall.jsonl" ] \
          || compgen -G "${XDG_STATE_HOME:-$HOME/.local/state}/friday/recall/*.jsonl" >/dev/null; } && [ -z "$local_answer" ] \
        && systemctl --user is-active --quiet friday-recall.service 2>/dev/null \
        && [[ "${goal,,}" =~ ^(what\ was\ (that|the|it)|what\ did\ i\ (just\ )?(see|read)|where\ did\ i\ (see|read)|earlier|i\ (just\ )?saw)[[:space:][:punct:]] ]] \
        && recalled=$(timeout 3 friday-ctl recall search "$goal" 2>/dev/null) && [ -n "$recalled" ]; then
      # "What was that …?" with recall on: what was on screen earlier.
      request=$(printf '%s\n\n[recall]\nThis is text that was on my screen in the last few hours, kept on this computer. Answer from it and say which window it was in:\n"""\n%s\n"""' "$goal" "$recalled")
      from_recall=true
    elif ! $use_screen && [ -z "$local_answer" ] \
        && [[ "${goal,,}" =~ ^what(\'s|\ has|\ have)?\ changed(\ since\ .*|\ today|\ yesterday|\ this\ (morning|week)|\ (in|over)\ the\ (last|past)\ (hour|day|week)|\ recently)?[[:space:]?.!]*$ ]] \
        && changes=$(friday_what_changed "$goal" "${ask_project:-}") && [ -n "$changes" ]; then
      # "What changed since yesterday?": the project's commits and files and
      # the system's packages since then, read here.
      request=$(printf '%s\n\n[changes]\nWhat changed on this computer in that time, from git and the package log. Summarise it; say what is unfinished:\n"""\n%s\n"""' "$goal" "$changes")
    elif ! $use_screen && [ -z "$local_answer" ] && ws_report=$(friday_continue_restore "$goal"); then
      # "Continue building FRIDAY": its workspace is put back first; the
      # daemon adds where you stopped (the timeline).
      request=$(printf '%s\n\n[workspace]\nFRIDAY just put the windows of this project back:\n"""\n%s\n"""' "$goal" "$ws_report")
    elif ! $use_screen && [ -z "$local_answer" ]; then
      # A typed question: documentation on this computer that fits it well
      # (Arch wiki, tldr, man pages; friday-ctl docs prints nothing otherwise).
      docs=$(timeout 2 friday-ctl docs -- "$goal" 2>/dev/null || true)
      [ -z "$docs" ] || request=$(printf '%s\n\n[docs]\nThese excerpts from documentation on this computer may help. Use them only if they fit, and name the one you use (for example "Arch wiki: Pacman"):\n"""\n%s\n"""' "$goal" "$docs")
    fi
    # What the person asked FRIDAY to do in this app (friday app-instructions).
    # Never for a private window: neither the app nor the instruction goes.
    app_rule=""
    if [ -z "${rewrite:-}" ] && ! $use_screen && [ -z "$private_win" ] \
        && app_rule=$(friday_app_instructions "$ask_app") && [ -n "$app_rule" ] && [ -n "$(friday_private_window)" ]; then
      app_rule=""
    fi
    [ -z "$app_rule" ] || request=$(printf '%s\n\n[app instructions]\nIn %s, the person asked FRIDAY to follow this (their own setting):\n"""\n%s\n"""' "$request" "$ask_app" "$app_rule")

    ok=true
    ctl_rc=0
    # One notification that fills in as the answer streams (-p gives its id,
    # -r replaces it); the final answer replaces it too. friday-ctl --stream
    # prints the answer so far as {"partial": ...} lines.
    stream_ctl() {
      local outf ctl shown="" partial view
      outf=$(mktemp)
      "$@" --stream >"$outf" 2>&1 &
      ctl=$!
      while kill -0 "$ctl" 2>/dev/null; do
        sleep 0.4
        [ -n "$nid" ] || continue
        partial=$(grep '^{"partial"' "$outf" | tail -n 1 | jq -r '.partial // empty' 2>/dev/null || true)
        if [ -n "$partial" ] && [ "$partial" != "$shown" ]; then
          view="$partial"
          [ "${#view}" -le 280 ] || view="…${view: -279}"
          notify-send -a FRIDAY -r "$nid" -- "FRIDAY · $goal" "$view" 2>/dev/null || true
          shown="$partial"
        fi
      done
      ctl_rc=0
      wait "$ctl" || ctl_rc=$?
      [ "$ctl_rc" -eq 0 ] || ok=false
      out=$(cat "$outf"); rm -f "$outf"
    }

    show_answer() {
      ask_lookups
      local ans_ok="$1" summary_json="$2" raw_out="$3"
      local answer title details preview urgency actions meta=""
      local local_only=false
      [ "$(jq -r '.local // false' <<<"$summary_json" 2>/dev/null)" = true ] && meta="On this computer · nothing was sent" && local_only=true
      if $ans_ok; then
        answer=$(jq -r '.result // empty' <<<"$summary_json")
        [ -n "$answer" ] || answer="Done: $goal"
        title="FRIDAY ✓"
      else
        answer=$(jq -r '.error // .outcome // empty' <<<"$summary_json")
        [ -n "$answer" ] || answer="$raw_out"
        # Plain-language messages for the failures people actually hit; the raw
        # error stays in the saved answer for debugging.
        details="$answer"
        case "$answer$raw_out" in
          *FreeUsageLimitError*)
            answer="OpenCode Zen's free limit is used up for now. Try again later, or add your own key: friday setup-ai" ;;
          # friday-ctl's own errors only: a provider's "Connection refused"
          # (say, a local model server that isn't running) is not FRIDAY down.
          *"no token found"*|*"cannot reach daemon"*)
            answer="FRIDAY isn't running, so I couldn't ask. Start it and try again."
            daemon_down=true ;;
          *"timed out after"*)
            answer="This is taking longer than expected. FRIDAY may still be working on it: check the bar icon, or run friday answers --last later." ;;
          *"Couldn't reach your AI provider"*)
            case "$(friday_local_conf_get state)" in
              pending|installing)
                answer="Local AI is still downloading, and no cloud provider answered. Ask again once it's on (friday local-ai status)." ;;
              *) details=""
                 local still
                 still=$(friday_what_still_works)
                 [ -z "$still" ] || answer="$answer $still" ;;
            esac ;;
          *) details="" ;;
        esac
        title="FRIDAY ✗ $goal"
      fi

      # Full answer on disk; the notification shows a preview with an Open button.
      answer_file="$state_dir/last-answer.md"
      {
        printf '# %s\n\n_%s_\n\n' "$goal" "$(date '+%Y-%m-%d %H:%M')"
        # Kept on this computer: the timeline never sends these to a cloud model.
        ! $local_only || printf '_On this computer · nothing was sent_\n\n'
        [ -z "${ask_project:-}" ] || printf '_project: %s_\n\n' "$ask_project"
        # The timeline shows a failed ask as failed.
        case "$title" in "FRIDAY ✗"*) printf '_failed_\n\n' ;; esac
        # That there was text, never the text itself.
        if $use_followup; then printf '> (a follow-up)\n\n'
        elif [ -n "$context" ]; then printf '> (with the text you asked about; not kept)\n\n'; fi
        printf '%s\n' "$answer"
        [ -z "${details:-}" ] || printf '\n<details>\n\n```\n%s\n```\n' "$details"
      } >"$answer_file"
      # Each entry opens with a marker line, so a "---" inside an answer
      # never splits it (FRIDAY Shell's answer history reads these).
      # Past 2 MiB its older half (whole entries) becomes answers.1.md, the
      # one before going, so the history, the timeline and the shell read a
      # bounded file that still has hundreds of answers. Under a lock: two
      # answers at once neither interleave nor rotate twice.
      (umask 077
       exec 9>"$state_dir/answers.lock"
       flock -w 5 9 2>/dev/null || ! command -v flock >/dev/null || exit 0
       a="$state_dir/answers.md"
       size=$(stat -c %s "$a" 2>/dev/null || echo 0)
       if [ "$size" -gt 2097152 ]; then
         n=$(awk -v h=$((size / 2)) '{ b += length($0) + 1 } b > h && /^<!-- friday answer -->$/ { print NR; exit }' "$a")
         if [ -n "$n" ]; then
           head -n $((n - 1)) "$a" >"$a.old.tmp" && tail -n +"$n" "$a" >"$a.tmp" \
             && mv -f "$a.old.tmp" "$state_dir/answers.1.md" && mv -f "$a.tmp" "$a"
         else
           mv -f "$a" "$state_dir/answers.1.md"
         fi
       fi
       { printf '<!-- friday answer -->\n'; cat "$answer_file"; printf '\n---\n\n'; } >>"$a") || true
      # What friday wrong saves about this answer: how it was asked and
      # answered, never the question's or the answer's text.
      # An error is kept as its kind only: its text can echo the answer.
      local shape
      shape=$(jq -c 'if type == "object" then . else {} end' <<<"${summary_json:-{\}}" 2>/dev/null || true)
      [ -n "$shape" ] || shape='{}'
      jq -n --arg mode "${ask_args[0]:-plain}" --argjson ok "$ans_ok" --argjson local "$local_only" \
        --argjson q "${#goal}" --argjson a "${#answer}" --argjson s "$shape" \
        '{mode: ($mode | ltrimstr("--")), ok: $ok, local: $local, served_by: ($s.served_by // null),
          used: ($s.used // []), masked: ($s.masked // 0),
          error: ($s.error // null | if . == null then null else (tostring | ascii_downcase |
            if test("timed out") then "timeout"
            elif test("429|rate.?limit|usage limit") then "rate_limited"
            elif test("see images") then "no_vision"
            elif test("reach|connect|network") then "unreachable"
            elif test("confirm") then "needs_confirmation"
            elif test("all candidates failed") then "all_failed"
            else "other" end) end),
          question_chars: $q, answer_chars: $a}' >"$state_dir/last-ask.json.tmp" 2>/dev/null \
        && mv -f "$state_dir/last-ask.json.tmp" "$state_dir/last-ask.json" || rm -f "$state_dir/last-ask.json.tmp"

      # Spoken answers (friday voice speak on): the answer is read aloud while
      # the card shows it; a new answer, or friday say --stop, ends it.
      if $ans_ok && [ -e "$(friday_speak_flag)" ] && friday_speak_ready; then
        ( printf '%s' "$answer" | friday-ctl say - ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
      fi

      preview="$answer"
      [ "${#preview}" -le 220 ] || preview="${preview:0:217}…"
      [ -z "$meta" ] || preview="$preview\n$meta"
      local served_model=""
      if $ans_ok; then
        local is_private=false
        local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
        if [ "$(jq -r '.private // false' "$state_dir/state.json" 2>/dev/null || true)" = "true" ] \
           || { [ -r "$env_file" ] && grep -qE '^FRIDAY_PRIVATE=(1|true)' "$env_file" 2>/dev/null; }; then
          is_private=true
        fi
        local served_p served_ms
        served_p=$(jq -r '.served_by.provider // empty' <<<"$summary_json" 2>/dev/null || true)
        served_model=$(jq -r 'select(.served_by.provider != null) | .served_by.provider + "/" + (.served_by.model // "")' <<<"$summary_json" 2>/dev/null || true)
        served_ms=$(jq -r '.served_by.ms // empty' <<<"$summary_json" 2>/dev/null || true)
        if $is_private; then
          preview="$preview\nPrivate · on this computer"
          meta="Private · on this computer"
        elif [ -n "$served_p" ]; then
          local p_name
          case "$served_p" in
            opencode-zen) p_name="OpenCode Zen" ;;
            kilo) p_name="Kilo" ;;
            ovh) p_name="OVHcloud" ;;
            claude-code) p_name="Claude Code" ;;
            codex) p_name="Codex" ;;
            antigravity) p_name="Antigravity" ;;
            cline) p_name="Cline" ;;
            *) p_name="$served_p" ;;
          esac
          local sec="0.0"
          if [[ "$served_ms" =~ ^[0-9]+$ ]]; then
            local rounded=$(( (served_ms + 50) / 100 ))
            sec="$(( rounded / 10 )).$(( rounded % 10 ))"
          fi
          preview="$preview\nvia $p_name · ${sec} s"
          meta="via $p_name · ${sec} s"
        fi
        local masked_count
        masked_count=$(jq -r '.masked // empty' <<<"$summary_json" 2>/dev/null || true)
        if [[ "$masked_count" =~ ^[0-9]+$ ]] && [ "$masked_count" -gt 0 ]; then
          preview="$preview\n$masked_count secret(s) masked before sending"
          meta="${meta:+$meta · }$masked_count secret(s) masked before sending"
        fi
        if [ -n "${app_context:-}" ]; then
          preview="$preview\nIncluded the app name and window title"
          meta="${meta:+$meta · }Included the app name and window title"
        fi
        # What went into the answer besides the question: what this script
        # sent, then what the daemon added (its "used" list).
        local -a used_parts=()
        if $use_selection && [ -n "${context:-}" ]; then
          if [ "$source_label" = Clipboard ]; then used_parts+=("your clipboard"); else used_parts+=("your selection"); fi
        fi
        # A screen ask's own "used" (the window's text or a screenshot) comes
        # from the daemon; this is only for an older one that doesn't say.
        if $use_screen && [ -n "$(jq -r '.used[0]? // empty' <<<"$summary_json" 2>/dev/null)" ]; then :
        elif ${use_region:-false}; then used_parts+=("the area you picked")
        elif $use_screen; then used_parts+=("the window in front")
        elif [ -n "${tab:-}" ]; then used_parts+=("the page's text (browser extension)"); fi
        [ -z "${docs:-}" ] || used_parts+=("docs on this computer")
        [ -z "${ws_report:-}" ] || used_parts+=("the windows FRIDAY put back")
        [ -z "${app_rule:-}" ] || used_parts+=("your instructions for $ask_app")
        local u
        while IFS= read -r u; do [ -z "$u" ] || used_parts+=("$u"); done \
          < <(jq -r '.used[]? // empty' <<<"$summary_json" 2>/dev/null || true)
        if (( ${#used_parts[@]} )); then
          local used_line="Used: ${used_parts[0]}" i
          for (( i = 1; i < ${#used_parts[@]}; i++ )); do used_line+=", ${used_parts[$i]}"; done
          preview="$preview\n$used_line"
          meta="${meta:+$meta · }$used_line"
        fi
      fi
      # The pill shows the whole answer and its own buttons; a notification
      # only when it isn't there, or for "Start FRIDAY", which only a
      # notification offers.
      if $use_pill && [ "${daemon_down:-false}" != true ] \
        && pill present "$ans_ok" "$goal" "$answer" "$meta" "${ask_args[0]:-}" "${served_model:-}"; then
        return 0
      fi
      urgency=normal; $ans_ok || urgency=critical
      if $ans_ok; then
        actions=(-A copy="Copy" -A again="Ask again" -A open="Open full answer" -A wrong="That was wrong")
      else
        actions=(-A open="Open full answer")
        [ "${daemon_down:-false}" = true ] && actions=(-A start="Start FRIDAY")
      fi
      # Replace the streaming notification rather than add a second one.
      [ -z "${nid:-}" ] || actions+=(-r "$nid")
      (
        open_answer() {
          foot -T "FRIDAY · $goal" less -R "$answer_file" 2>/dev/null \
            || xdg-open "$answer_file" 2>/dev/null || true
        }
        action=$(notify-send -a FRIDAY -u "$urgency" "${actions[@]}" -- "$title" "$preview" 2>/dev/null || true)
        case "$action" in
          copy)
            if command -v wl-copy >/dev/null 2>&1; then
              printf '%s' "$answer" | wl-copy 2>/dev/null || true
            else
              open_answer
            fi ;;
          again)
            [ -x "$0" ] && exec "$0" ask "${ask_args[@]}" || exec bash "$0" ask "${ask_args[@]}" ;;
          open)
            open_answer ;;
          wrong)
            bash "$0" wrong ;;
          start)
            systemctl --user restart friday-linux-daemon 2>/dev/null \
              && notify-send -a FRIDAY "FRIDAY" "Started. Ask again with Super+Y." 2>/dev/null || true ;;
        esac
      ) </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null || true
    }

    if [ -n "$local_answer" ]; then
      show_answer true "$(jq -n --arg r "$local_answer" '{result: $r, local: true}')" ""
      exit 0
    fi

    # A private window: its text goes only to the local model, asked here
    # directly; a screenshot of it never leaves.
    # "never <name>" in private-windows: not even the local model reads it.
    if [[ "$private_win" == never:* ]]; then
      notify-send -a FRIDAY -- "FRIDAY" "FRIDAY doesn't read this window at all (your rule \"never ${private_win#never:}\" in ~/.config/friday/private-windows)." 2>/dev/null || true
      exit 0
    fi
    if [ -n "$private_win" ]; then
      if $use_screen; then
        # Its text to the local model only (read here, never a screenshot),
        # when there's a local model and the window has words to read.
        win_text=""
        if friday_local_ready && [ -n "$priv_win" ] \
            && win_text=$(timeout 15 friday-ctl window-text "$(jq -r '.class // ""' <<<"$priv_win")" "$(jq -r '.title // ""' <<<"$priv_win")" 2>/dev/null) \
            && [ -n "$win_text" ]; then
          request=$(printf '%s\n\n[window]\nThe text of the window in front (private, so it stays on this computer):\n"""\n%s\n"""' "$goal" "$win_text")
        else
          notify-send -a FRIDAY -- "FRIDAY" "This window looks private (\"$private_win\"), so no screenshot of it leaves this computer. With local AI set up (friday setup-ai local), its text is asked about here instead." 2>/dev/null || true
          exit 0
        fi
      fi
      if ! reply=$(friday_ask_local "$request"); then
        notify-send -a FRIDAY -- "FRIDAY" "This window looks private (\"$private_win\"), so I won't send its text to a cloud model. Set up local AI to ask about it here: friday setup-ai local" 2>/dev/null || true
        exit 0
      fi
      if [ -n "${rewrite:-}" ]; then
        friday_replace_selection "$(friday_rewrite_clean "$reply")" "${sel_window:-}" "" "the rewrite" "$context"
        exit 0
      fi
      show_answer true "$(jq -n --arg r "$reply" '{result: $r, local: true}')" ""
      exit 0
    fi

    if ${followup_local:-false}; then
      if ! reply=$(friday_ask_local "$request"); then
        notify-send -a FRIDAY -- "FRIDAY" "That answer was made on this computer, so its follow-up stays here too, and the local model isn't answering. Start it with: friday private on" 2>/dev/null || true
        exit 0
      fi
      show_answer true "$(jq -n --arg r "$reply" '{result: $r, local: true}')" ""
      exit 0
    fi

    # Recalled text goes to the local model first (with none set up, to the
    # cloud provider, as friday recall on said).
    if ${from_recall:-false} && reply=$(friday_ask_local "$request"); then
      show_answer true "$(jq -n --arg r "$reply" '{result: $r, local: true}')" ""
      exit 0
    fi

    # A browser in front with FRIDAY's extension: the tab's own text instead
    # of a screenshot (an area you dragged out is still a screenshot).
    if $use_screen && [ -z "${region:-}" ] && [[ "$(friday_app_class)" =~ firefox|chromium|chrome|brave|librewolf|zen|vivaldi|edge ]] \
        && tab=$(timeout 8 friday-ctl browser tab 2>/dev/null) && [ -n "$(jq -r '.text // empty' <<<"$tab" 2>/dev/null)" ] \
        && friday_tab_in_front "$tab"; then
      request=$(jq -r --arg q "$goal" '"\($q)\n\n[page]\nThe page in front (read from the browser when asked):\nTitle: \(.title)\nAddress: \(.url)\n" + (if (.selection // "") != "" then "Selected: \(.selection)\n" else "" end) + "Text:\n\"\"\"\n\(.text)\n\"\"\""' <<<"$tab")
      use_screen=false
    fi
    if $use_screen; then
      # Pressing the key and typing the question is the per-use consent;
      # the daemon's ContextGate still enforces it.
      nid=""
      $use_pill || nid=$(notify-send -a FRIDAY -p -- "FRIDAY" "Looking at your screen: $goal" 2>/dev/null || true)
      [[ "$nid" =~ ^[0-9]+$ ]] || nid=""
      stream_ctl friday-ctl context screen --yes --ask "$goal" ${region:+--region "$region"}
      summary=$(jq -s 'map(select(type == "object" and (has("partial") | not))) | last // {} | {result: .response, error: .error, used: .used}' <<<"$out" 2>/dev/null || echo '{}')
    else
      nid=""
      $use_pill || nid=$(notify-send -a FRIDAY -p -- "FRIDAY" "Working on: $goal" 2>/dev/null || true)
      [[ "$nid" =~ ^[0-9]+$ ]] || nid=""
      ctl_args=(goal --wait)
      $use_web && ctl_args+=(--web)
      $use_new && ctl_args+=(--new-conversation)
      [ -z "$another" ] || ctl_args+=(--thorough --avoid "$another")
      ctl_args+=("$request")
      stream_ctl friday-ctl "${ctl_args[@]}"
      # The final {outcome,result,error} object; keep every line of the answer.
      summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$out" 2>/dev/null || echo '{}')
    fi

    if [ -n "${rewrite:-}" ] && $ok; then
      rewritten=$(friday_rewrite_clean "$(jq -r '.result // empty' <<<"$summary" 2>/dev/null || true)")
      if [ -n "${rewritten//[[:space:]]/}" ]; then
        [ -z "$nid" ] || notify-send -a FRIDAY -r "$nid" -t 1500 -- "FRIDAY" "Rewritten: $rewrite" 2>/dev/null || true
        friday_replace_selection "$rewritten" "${sel_window:-}" "" "the rewrite" "$context"
        exit 0
      fi
    fi

    action_to_confirm=$(jq -r '.needs_confirmation.action // empty' <<<"$summary" 2>/dev/null || true)
    if [ "$ctl_rc" -eq 3 ] && [ -n "$action_to_confirm" ]; then
      (
        action=$(friday_confirm "$action_to_confirm" "${nid:-}")
        case "$action" in
          run)
            conf_ok=true
            conf_args=(goal --wait --confirm "$action_to_confirm")
            $use_web && conf_args+=(--web)
            conf_args+=("$request")
            conf_out=$(friday-ctl "${conf_args[@]}" 2>&1) || conf_ok=false
            conf_summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$conf_out" 2>/dev/null || echo '{}')
            show_answer "$conf_ok" "$conf_summary" "$conf_out"
            ;;
          cancel|*)
            ;;
        esac
      ) </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null || true
      exit 0
    fi

    show_answer "$ok" "$summary" "$out"
    ;;
  goal)
    shift
    exec friday-ctl goal "$@"
    ;;
  cancel)
    if out=$(friday-ctl cancel 2>&1); then
      echo "Cancelled the current goal."
      notify-send -a FRIDAY "FRIDAY" "Cancelled the current goal." 2>/dev/null || true
    elif [[ "$out" == *"cannot reach daemon"* ]]; then
      echo "friday: FRIDAY isn't running, so there is nothing to cancel. Start it with: friday daemon restart" >&2
      exit 1
    else
      echo "Nothing to cancel: no goal is running." >&2
      exit 1
    fi
    ;;
  doctor)
    shift
    friday_doctor "$@"
    ;;
  report)
    shift
    friday_report "$@"
    ;;
  setup-ai)
    shift
    friday_setup_ai "$@"
    ;;
