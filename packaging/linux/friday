  watch)
    # friday watch region (drag an area) | stop. The command in a kitty
    # window is watched from the Super+Y menu.
    case "${2:-region}" in
      stop) exec friday-ctl watch stop ;;
      region)
        command -v slurp >/dev/null 2>&1 && command -v grim >/dev/null 2>&1 \
          || { echo "friday watch needs slurp and grim" >&2; exit 1; }
        geom=$(slurp 2>/dev/null) || exit 0
        setsid friday-ctl watch region "$geom" </dev/null >/dev/null 2>&1 &
