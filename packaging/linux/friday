friday_features_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/friday/features-off"; }
# friday_feature_on <name>: on unless switched off.
friday_feature_on() { ! grep -qxF -- "$1" "$(friday_features_file)" 2>/dev/null; }
friday_feature() {
  local f name what
  f=$(friday_features_file)
  case "${1:-list}" in
    list)
      while IFS='|' read -r name what; do
        if friday_feature_on "$name"; then printf 'on   %-17s %s\n' "$name" "$what"; else printf 'off  %-17s %s\n' "$name" "$what"; fi
      done <<<"$FRIDAY_FEATURES" ;;
    *)
      name="$1"
      [[ "$name" =~ ^[a-z-]+$ ]] && grep -q "^$name|" <<<"$FRIDAY_FEATURES" 2>/dev/null \
        || { echo "friday: no feature called \"$name\" (friday feature list)" >&2; return 1; }
      case "${2:-status}" in
        status) if friday_feature_on "$name"; then echo "$name: on"; else echo "$name: off"; fi ;;
        on) [ ! -f "$f" ] || { grep -vxF -- "$name" "$f" >"$f.$$" || true; mv -f "$f.$$" "$f"; }; echo "$name: on" ;;
        off) mkdir -p "$(dirname "$f")"; friday_feature_on "$name" && echo "$name" >>"$f"; echo "$name: off" ;;
        *) echo "Usage: friday feature [list | <name> status|on|off]" >&2; return 1 ;;
      esac
      # The window borders follow the wallpaper's accent or the palette's.
      if [ "$name" = wallpaper-accent ] && [ "${2:-status}" != status ]; then shell_window_look; fi ;;
  esac
}

# Public free tiers (LAI-6): providers whose free tier may keep or train on
# what is sent. One listed in public-providers answers like any model, or only
# plain typed questions with free-tiers-everywhere off (the guard); "!id"
# there is one turned off, still kept from everything else.
# Turning one off never makes it an ordinary provider again.
friday_free_tiers() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/public-providers"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  local ids="openrouter groq cerebras gemini nvidia-nim apisfreellm" sub="${1:-list}" id="${2:-}" var state
  case "$sub" in
    list)
      echo "Public free models:"
      for id in $ids; do
        if grep -qxF -- "$id" "$file" 2>/dev/null; then state=on
        elif grep -qxF -- "!$id" "$file" 2>/dev/null; then state=off
        else state="not added"; fi
        printf '  %-11s %s\n' "$id" "$state"
      done
      friday_feature_on free-tiers || echo "The free-tiers switch is off: none of them is used (friday feature free-tiers on)."
      if friday_feature_on free-tiers-everywhere; then
        echo "They answer every ask like your other models (private mode still stays on this computer)."
        echo "To keep them to plain typed questions: friday feature free-tiers-everywhere off"
      else
        echo "Guard on: they answer only a typed question with nothing added (no screen, selection, memory or earlier turns)."
      fi
      return 0 ;;
    on|off) ;;
    *) echo "Usage: friday free-tiers [list | on <id> | off <id>]" >&2; return 1 ;;
  esac
  [[ -n "$id" && "$id" != *[[:space:]]* && " $ids " == *" $id "* ]] || { echo "friday: choose one of: $ids" >&2; return 1; }
  if [ "$sub" = on ]; then
    var=$(tr 'a-z-' 'A-Z_' <<<"$id")_API_KEY
    if [ "$id" != apisfreellm ] && ! grep -qE "^${var}=[^[:space:]]" "$env_file" 2>/dev/null; then
      echo "friday: $id needs its free key first: friday setup-ai --keep-others $id" >&2
      return 1
    fi
    printf '\e[31m%s may keep or train on what is sent to it: treat it as public.\e[0m\n' "$id"
    [ "$id" != apisfreellm ] || printf '\e[31m%s\e[0m\n' "apisfreellm.com needs no key and names no operator and no terms; it records each request's IP address and reads every prompt. Never send it anything private."
    if friday_feature_on free-tiers-everywhere; then
      echo "It answers every ask, the screen and selections too. To keep it to plain typed questions: friday feature free-tiers-everywhere off"
    else
      echo "Guard on: only plain typed questions go there, never the screen, a selection, the clipboard, memory or a private window."
    fi
    if [ "${3:-}" != --yes ]; then
      [ -t 0 ] || { echo "friday: add --yes to turn it on from a script" >&2; return 1; }
      read -r -p "Turn on $id? [y/N] " state
      [[ "$state" =~ ^[yY] ]] || { echo "Left off."; return 0; }
    fi
  fi
  mkdir -p "$(dirname "$file")"
  { grep -vxF -e "$id" -e "!$id" "$file" 2>/dev/null || true
    if [ "$sub" = on ]; then echo "$id"; else echo "!$id"; fi; } >"$file.tmp" && mv -f "$file.tmp" "$file"
  if [ "$sub" = on ]; then echo "$id: on"; else echo "$id: off"; fi
  systemctl --user try-restart friday-linux-daemon.service 2>/dev/null || true
}

# Whether an action can't be taken back: it deletes, formats, runs as root,
# uninstalls, kills, powers off, overwrites a system file, force-pushes or
# closes a window. "act" still asks before these.
friday_irreversible() {
  local a=" ${1,,} " cmds='(rm|rmdir|shred|dd|mkfs[.a-z0-9]*|wipefs|fdisk|parted|sudo|doas|pkexec|su|kill|killall|pkill|shutdown|reboot|poweroff|halt|truncate)'
  local first="(^|[[:space:];|&(\`])${cmds}[[:space:]]"
  local other='pacman +-r|yay +-r|systemctl +(stop|disable|mask|poweroff|reboot)|git +(push +.*(-f|--force)|reset +--hard|clean)|> */|chmod +-r|close_window|desktop ui_click'
  # Only outside quotes: a commit message that says "rmdir" is no rmdir.
  a=$(sed -E "s/\"[^\"]*\"//g; s/'[^']*'//g" <<<"$a")
  [[ "$a" =~ $first ]] || [[ "$a" =~ $other ]]
}

# PRV-11: whether an action is harmless enough to "Always allow": opening
# an app, a web link or a file, or copying text. The action runs through a
# shell, so: no control characters, one plain argument (or one quoted one
# with nothing the shell expands), a web link (http or https), a file by
# its absolute path that is (after links) neither a program nor a .desktop
# file, an installed app by its own name (a system desktop entry whose file
# and program are that name, not a shell or interpreter, not a terminal
# app), or plain words to copy. Anything else is asked about every time.
friday_harmless_action() {
  local a=$1 verb arg rest f w quoted=false
  [[ "$a" =~ [[:cntrl:]] ]] && return 1
  friday_irreversible "$a" && return 1
  read -r verb arg rest <<<"$a"
  case "$verb" in
    xdg-open|gio|kde-open|wl-copy) ;;
    bash|sh|zsh|dash|fish|ksh|python|python3|perl|ruby|node|php|lua|env|java|jshell|vim|nvim|vi|nano|emacs|xterm|foot|kitty|alacritty|ghostty|wezterm|konsole|gnome-terminal) return 1 ;;
    *)
      # An installed app by its own name, nothing after it.
      [ -z "$arg" ] && [[ "$verb" =~ ^[a-z0-9][a-z0-9._+-]*$ ]] || return 1
      f=/usr/share/applications/$verb.desktop
      [ -f "$f" ] || return 1
      grep -qi '^Terminal=true' "$f" && return 1
      w=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$f" | head -n1)
      [ "${w##*/}" = "$verb" ]
      return ;;
  esac
  if [ "$verb" = gio ]; then [ "$arg" = open ] || return 1; read -r _ _ arg rest <<<"$a"; fi
  # Copying: plain words, none of them an option.
  if [ "$verb" = wl-copy ]; then
    [ -n "$arg" ] || return 1
    case "${a#wl-copy}" in *[\"\'\`\$\;\|\&\<\>\(\)\{\}\[\]\\\*\?\~\!\#]*) return 1 ;; esac
    for w in $arg $rest; do [[ "$w" != -* ]] || return 1; done
    return 0
  fi
  [ -n "$arg" ] && [ -z "$rest" ] || return 1
  if [[ "$arg" =~ ^\'([^\']*)\'$ ]]; then arg=${BASH_REMATCH[1]}; quoted=true
  elif [[ "$arg" =~ ^\"([^\"\$\`\\]*)\"$ ]]; then arg=${BASH_REMATCH[1]}; quoted=true
  else case "$arg" in *[\"\'\`\$\;\|\&\<\>\(\)\{\}\[\]\\\*\?]*) return 1 ;; esac; fi
  [[ "$arg" != -* ]] || return 1
  [[ "$arg" =~ ^https?://[^[:space:]]+$ ]] && return 0
  # A file: by its absolute path ("~/" only unquoted, where the shell expands it).
  if [[ "$arg" == "~/"* ]]; then $quoted && return 1; f="$HOME/${arg#\~/}"
  elif [[ "$arg" == /* ]]; then f=$arg
  else return 1; fi
  f=$(realpath -e -- "$f" 2>/dev/null) || return 1
  [ -f "$f" ] && [ ! -x "$f" ] && [[ "$f" != *.desktop ]]
}

# "Always allow" (PRV-11; switch always-allow): exact actions, each kept 30
# days, run without asking while they stay harmless and the ask carries no
# quoted text. `friday always-allow [list|clear|forget <n>]`.
friday_always_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/friday/always-allow"; }
friday_always_allowed() {
  local a=$1 now ts act
  friday_feature_on always-allow && friday_harmless_action "$a" || return 1
  now=$(date +%s)
  while IFS=$'\t' read -r ts act; do
    [[ "$ts" =~ ^[0-9]+$ ]] && [ "$act" = "$a" ] && [ $(( now - ts )) -lt 2592000 ] && return 0
  done <"$(friday_always_file)" 2>/dev/null
  return 1
}
friday_always_remember() {
  local f; f=$(friday_always_file)
  mkdir -p "$(dirname "$f")"
  (umask 077
   { A="$1" awk -F'\t' '$2 != ENVIRON["A"]' "$f" 2>/dev/null || true
     printf '%s\t%s\n' "$(date +%s)" "$1"; } >"$f.tmp" && mv -f "$f.tmp" "$f")
}
friday_always_allow() {
  local f n=0 ts act now
  f=$(friday_always_file); now=$(date +%s)
  case "${1:-list}" in
    list)
      [ -s "$f" ] || { echo "Nothing is always allowed. The Always allow button on a harmless action (open an app, a link or a file; copy) adds one."; return 0; }
      # Numbered by line, as forget takes them.
      while IFS=$'\t' read -r ts act; do
        n=$((n+1))
        [[ "$ts" =~ ^[0-9]+$ ]] || continue
        if [ $(( now - ts )) -lt 2592000 ]; then printf '%d  %s  (%d days left)\n' "$n" "$act" $(( (2592000 - now + ts) / 86400 ))
        else printf '%d  %s  (expired, will ask)\n' "$n" "$act"; fi
      done <"$f" ;;
    forget)
      [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] && [ -n "$(sed -n "${2}p" "$f" 2>/dev/null)" ] \
        || { echo "Usage: friday always-allow forget <number from friday always-allow list>" >&2; return 1; }
      (umask 077; awk -v n="$2" 'NR != n' "$f" >"$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f") || return 1
      echo "Forgotten: it asks again." ;;
    clear) rm -f "$f"; echo "Nothing is always allowed now; everything asks again." ;;
    *) echo "Usage: friday always-allow [list|clear|forget <n>]" >&2; return 1 ;;
  esac
}

# Whether "act" may run an action without asking ($1 = the action, $2 =
# "true" when it came from quoted text: a selection, a page, a window's
# text, which may carry instructions). Only plain actions: a list of things
# that can't be undone always has gaps (bash -c "rm ...", /bin/rm, find
# -delete, curl | sh), so anything with shell syntax, quotes, an interpreter,
# a command run through another, a copy/move that can overwrite, or a
# program given by path asks too.
friday_act_may_run() {
  local a=$1 first
  [ "${2:-false}" = true ] && return 1
  friday_irreversible "$a" && return 1
  case "$a" in *[\"\'\`\$\;\|\&\<\>\(\)\{\}\\\*\?\~\!\#]*) return 1 ;; esac
  [[ "$a" == *$'\n'* ]] && return 1
  read -r first _ <<<"$a"
  case "$first" in
    # A program by path, or a VAR=value in front (LD_PRELOAD=..., BASH_ENV=...).
    */*|*=*) return 1 ;;
    bash|sh|zsh|dash|fish|ksh|python|python3|perl|ruby|node|php|lua|eval|exec|source|xargs|env|command|builtin|nohup|setsid|timeout|nice|ionice|stdbuf|watch|find|curl|wget|ssh|scp|rsync|mv|cp|ln|install|chmod|chown|tee|crontab|at|systemd-run|flatpak-spawn|busybox) return 1 ;;
  esac
  return 0
}

# `friday autonomy [status|ask-all|ask-risky|act]`: how much FRIDAY may do on
# its own. ask-risky (the default) asks before commands, file writes, app
# launches and anything that can't be undone; ask-all asks before every
# desktop action too (moving a window, the volume); act runs what it would
# have asked about and says what it did afterwards.
friday_autonomy_mode() {
  local m
  m=$(sed -n 's/^FRIDAY_AUTONOMY=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" 2>/dev/null | tail -n1)
  case "$m" in ask-all|act) echo "$m" ;; *) echo ask-risky ;; esac
}
friday_autonomy() {
  case "${1:-status}" in
    status)
      case "$(friday_autonomy_mode)" in
        ask-all) echo "Autonomy: ask-all (FRIDAY asks before every action, a window move or the volume too)" ;;
        act) echo "Autonomy: act (FRIDAY does what it would have asked about, then says what it did; it still asks before anything that can't be taken back, like deleting, root or closing a window)" ;;
        *) echo "Autonomy: ask-risky (FRIDAY asks before commands, file writes, app launches and anything that can't be undone)" ;;
      esac ;;
    ask-all|ask-risky|act)
      friday_env_set FRIDAY_AUTONOMY "$1"
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      friday_autonomy status ;;
    *) echo "Usage: friday autonomy [status|ask-all|ask-risky|act]" >&2; return 1 ;;
  esac
}

# friday_env_set <KEY> <value>: replace one line in friday.env (0600).
friday_env_set() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  mkdir -p "$(dirname "$env_file")"
  ( umask 077; { grep -v "^$1=" "$env_file" 2>/dev/null || true; echo "$1=$2"; } >"$env_file.tmp" && mv "$env_file.tmp" "$env_file" )
}

# `friday secrets [status|keychain|file]`: API keys in the desktop's keyring
# (Secret Service, through secret-tool) instead of friday.env, or back. The
# file then holds NAME=keyring: and the daemon reads the value at start.
friday_secrets() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" name val moved=0
  local names
  names=$(grep -oE '^[A-Z0-9_]+_(API_KEY|TOKEN|SECRET)=' "$env_file" 2>/dev/null | tr -d = || true)
  case "${1:-status}" in
    status)
      if [ -z "$names" ]; then echo "No API keys are set."; return 0; fi
      while IFS= read -r name; do
        if grep -qx "$name=keyring:" "$env_file"; then echo "$name: in the keyring"; else echo "$name: in friday.env"; fi
      done <<<"$names"
      echo "Move them: friday secrets keychain (back: friday secrets file)" ;;
    keychain)
      command -v secret-tool >/dev/null 2>&1 \
        || { echo "friday secrets: needs secret-tool (libsecret) and a keyring such as GNOME Keyring or KWallet." >&2; return 1; }
      while IFS= read -r name; do
        [ -n "$name" ] || continue
        val=$(grep -E "^$name=" "$env_file" | tail -n1 | cut -d= -f2- | tr -d '\r')
        # As systemd reads it: without surrounding quotes or trailing spaces.
        val="${val%"${val##*[![:space:]]}"}"
        if [[ "$val" == \"*\" || "$val" == \'*\' ]]; then val="${val:1:${#val}-2}"; fi
        [ -n "$val" ] && [ "$val" != "keyring:" ] || continue
        # Only once the keyring gives it back is the file changed.
        if printf '%s' "$val" | secret-tool store --label="FRIDAY $name" service friday name "$name" 2>/dev/null \
            && [ "$(secret-tool lookup service friday name "$name" 2>/dev/null)" = "$val" ]; then
          friday_env_set "$name" "keyring:"; moved=$((moved + 1))
        else
          echo "Couldn't put $name in the keyring (is it unlocked?); it stays in friday.env." >&2
        fi
      done <<<"$names"
      [ "$moved" -eq 0 ] || systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Moved $moved key(s) to the keyring. If the keyring is locked when FRIDAY starts, those providers wait until you unlock it and restart FRIDAY." ;;
    file)
      while IFS= read -r name; do
        [ -n "$name" ] && grep -qx "$name=keyring:" "$env_file" || continue
        if val=$(secret-tool lookup service friday name "$name" 2>/dev/null) && [ -n "$val" ]; then
          friday_env_set "$name" "$val"
          secret-tool clear service friday name "$name" 2>/dev/null || true
          moved=$((moved + 1))
        else
          echo "The keyring didn't give $name (is it unlocked?); it stays there." >&2
        fi
      done <<<"$names"
      [ "$moved" -eq 0 ] || systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Moved $moved key(s) back to friday.env." ;;
    *) echo "Usage: friday secrets [status|keychain|file]" >&2; return 2 ;;
  esac
}

friday_gb() { awk -v m="$1" 'BEGIN { g = m / 1024; if (g == int(g)) printf "%d GB", g; else printf "%.1f GB", g }'; }

# One line per preset: id|label|budget_mb|model|download_mb|vision|fast|available|note
friday_local_ai_presets() {
  local engine="${1:-}" hw ram_mb discrete vram disk
  hw=$(friday_local_ai_detect)
  ram_mb=$(sed -n 's/^ram_mb=//p' <<<"$hw")
  discrete=$(sed -n 's/^gpu_discrete=//p' <<<"$hw"); vram=$(sed -n 's/^vram_mb=//p' <<<"$hw")
  disk=$(sed -n 's/^disk_free_mb=//p' <<<"$hw")
  local -a ids=() labels=() budgets=() fast=()
  if [[ $discrete == yes && $vram != unknown ]] && (( vram > 512 )); then
    ids+=(gpu); budgets+=($((vram - 512))); fast+=(1)
    labels+=("GPU (up to $(friday_gb $((vram - 512))) of video memory)")
  fi
  local pct name i
  for name in light:25:Light balanced:50:Balanced most:75:Most; do
    IFS=: read -r i pct label <<<"$name"
    ids+=("$i"); budgets+=($((ram_mb * pct / 100))); fast+=(0)
    labels+=("$label (up to $(friday_gb $((ram_mb * pct / 100))) of memory, on the processor)")
  done
  local model need dl vision available note
  for i in "${!ids[@]}"; do
    model=$(friday_local_ai_model "${budgets[$i]}" "$engine")
    if [[ -z "$model" ]]; then
      echo "${ids[$i]}|${labels[$i]}|${budgets[$i]}||0|0|${fast[$i]}|0|too little memory for local AI; use a cloud provider"
      continue
    fi
    read -r need dl vision <<<"$(friday_local_ai_info "$model")"
    available=1
    if (( vision )); then note="sees screenshots"; else note="text only: can't see screenshots"; fi
    note="needs about $(friday_gb "$need") while answering, $note"
    if [ "$(friday_local_ai_local_first "$model" auto)" = 1 ]; then note="$note, answers first"
    else note="$note, backs up cloud (cloud answers first while online)"; fi
    if (( dl + 1024 > ${disk:-0} )); then
      available=0 note="needs $(friday_gb $((dl + 1024))) of disk, $(friday_gb "${disk:-0}") free"
    fi
    echo "${ids[$i]}|${labels[$i]}|${budgets[$i]}|$model|$dl|$vision|${fast[$i]}|$available|$note"
  done
}

