# The app and window title the selected text came from, as one line for the
# model ("" when off, or when Hyprland can't say). Called before the ask box
# opens, while that window still has focus. `friday app-context off` stops it.
friday_app_context() {
  [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/friday/no-app-context" ] || return 0
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local win cls title
  win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  cls=$(jq -r '.class // empty' <<<"$win" 2>/dev/null) || return 0
  [ -n "$cls" ] || return 0
  title=$(jq -r '.title // empty' <<<"$win" 2>/dev/null | tr -d '"\n' | cut -c1-120)
  if [ -n "$title" ]; then
    printf 'The text came from the app "%s" (window title: "%s").' "$cls" "$title"
  else
    printf 'The text came from the app "%s".' "$cls"
  fi
}

friday_app_context_cmd() {
  local flag="${XDG_CONFIG_HOME:-$HOME/.config}/friday/no-app-context"
  case "${1:-status}" in
    on)  rm -f "$flag"; echo "On: a question about selected text says which app it came from (name and window title)." ;;
    off) mkdir -p "$(dirname "$flag")" && : >"$flag"; echo "Off: selected text is sent without the app name or window title." ;;
    status)
      if [ -e "$flag" ]; then echo "Off: selected text is sent without the app name or window title."
      else echo "On: a question about selected text says which app it came from (name and window title). Turn off: friday app-context off"; fi ;;
    *) echo "usage: friday app-context [on|off|status]" >&2; return 2 ;;
  esac
}

# What FRIDAY keeps on this computer, and a way to wipe it. Counts only: the
# contents are never printed here.
friday_forget() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  local mem_dir=""
  [ -r "$env_file" ] && mem_dir=$(sed -n 's/^FRIDAY_MEMORY_DIR=//p' "$env_file" | tail -n 1 | tr -d '"'"'")
  if [ -z "$mem_dir" ]; then
    mem_dir="$state_dir/memory"
    [ -e "$mem_dir/episodes.jsonl" ] || ! [ -e "$HOME/friday-data/episodes.jsonl" ] || mem_dir="$HOME/friday-data"
  fi
  local what="" yes=false arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=true ;;
      answers|sent|memory|actions|all) what="$arg" ;;
      *) echo "usage: friday forget [answers|sent|memory|actions|all] [--yes]" >&2; return 2 ;;
    esac
  done
  local n_answers n_asks n_sent n_mem n_actions
  n_actions=$(wc -l <"$state_dir/actions.jsonl" 2>/dev/null || true)
  n_answers=$(grep -c '^<!-- friday answer -->' "$state_dir/answers.md" 2>/dev/null || true)
  n_asks=$(wc -l <"$state_dir/ask-history" 2>/dev/null || true)
  n_sent=$(wc -l <"$state_dir/egress.jsonl" 2>/dev/null || true)
  n_mem=$(wc -l <"$mem_dir/episodes.jsonl" 2>/dev/null || true)
  if [ -z "$what" ]; then
    echo "FRIDAY keeps this on your computer:"
    echo "  answers  ${n_answers:-0} saved answers, ${n_asks:-0} remembered questions   ($state_dir)"
    echo "  sent     ${n_sent:-0} entries in the log of what was sent to AI providers"
    echo "  memory   ${n_mem:-0} things FRIDAY remembered between questions   ($mem_dir)"
    echo "  actions  ${n_actions:-0} things FRIDAY did on your desktop (friday actions)"
    echo "Wipe some:  friday forget answers|sent|memory|actions|all   (add --yes to skip the question)"
    return 0
  fi
  if ! $yes; then
    if [ ! -t 0 ]; then echo "Say yes with --yes: friday forget $what --yes" >&2; return 2; fi
    local reply
    read -r -p "Delete FRIDAY's $what? This can't be undone. [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Nothing deleted."; return 0; }
  fi
  if [ "$what" = answers ] || [ "$what" = all ]; then
    rm -f "$state_dir/answers.md" "$state_dir/last-answer.md" "$state_dir/ask-history"
    echo "Deleted ${n_answers:-0} saved answers and ${n_asks:-0} remembered questions."
  fi
  if [ "$what" = sent ] || [ "$what" = all ]; then
    rm -f "$state_dir/egress.jsonl"
    echo "Deleted ${n_sent:-0} entries from the log of what was sent."
  fi
  if [ "$what" = actions ] || [ "$what" = all ]; then
    rm -f "$state_dir/actions.jsonl"
    echo "Deleted ${n_actions:-0} entries from the log of desktop actions."
  fi
  if [ "$what" = memory ] || [ "$what" = all ]; then
    # The daemon holds the journal open, so it stops while it is deleted.
    local was_up=false
    if systemctl --user is-active --quiet friday-linux-daemon 2>/dev/null; then
      was_up=true; systemctl --user stop friday-linux-daemon 2>/dev/null || true
    fi
    rm -f "$mem_dir/episodes.jsonl"
    if $was_up; then systemctl --user start friday-linux-daemon 2>/dev/null || true; fi
    echo "Deleted ${n_mem:-0} remembered things."
  fi
  return 0
}

# What FRIDAY did on your desktop (actions.jsonl), newest last. Which
# action, with what, whether it worked: never what was on your screen.
friday_actions() {
  local n="${1:-20}"
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/friday/actions.jsonl"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "usage: friday actions [N]" >&2; return 2; }
  if [ ! -s "$f" ]; then
    echo "FRIDAY hasn't done anything on your desktop yet."
    echo "Try: friday ask \"put firefox on workspace 2\""
    return 0
  fi
  tail -n "$n" "$f" | jq -r '[(.ts | sub("\\.[0-9]+"; "") | sub("T"; " ") | sub("Z"; "")),
    (if .ok then "ok    " else "failed" end), .verb, (.params | tojson), "(" + .risk + ")"] | join("  ")' 2>/dev/null \
    || tail -n "$n" "$f"
}

# Standing tasks ("every morning at 8 tell me the weather"): the file the
# daemon runs them from. Made by asking; managed here.
friday_tasks() {
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/friday/standing.json"
  local cmd="${1:-list}" id="${2:-}"
  case "$cmd" in
    list|--json)
      if [ "$cmd" = "--json" ]; then
        [ -s "$f" ] && jq -c '.tasks // []' "$f" 2>/dev/null || echo '[]'
        return 0
      fi
      if [ ! -s "$f" ] || [ "$(jq '.tasks | length' "$f" 2>/dev/null || echo 0)" = 0 ]; then
        echo "No standing tasks yet."
        echo "Try: friday ask \"every morning at 8 tell me the weather\""
        return 0
      fi
      jq -r '.tasks[] | [.id,
        (if .trigger.kind == "daily" then
           "every " + (if .trigger.weekdays_only then "weekday" else "day" end) + " at " +
           ("0" + (.trigger.hour | tostring))[-2:] + ":" + ("0" + (.trigger.minute | tostring))[-2:]
         elif .trigger.kind == "every" then
           (if .trigger.minutes % 60 == 0 then "every " + ((.trigger.minutes / 60) | tostring) + " h"
            else "every " + (.trigger.minutes | tostring) + " min" end)
         else "battery under " + (.trigger.percent | tostring) + "%" end),
        .goal, (if .paused then "(paused)" else "" end)] | join("  ")' "$f" 2>/dev/null \
        | sed 's/[[:space:]]*$//' \
        || { echo "FRIDAY couldn't read $f" >&2; return 1; }
      ;;
    pause|resume|delete)
      [[ "$id" =~ ^t[0-9]+$ ]] || { echo "usage: friday tasks $cmd <id>   (ids are in: friday tasks)" >&2; return 2; }
      [ -s "$f" ] && jq -e --arg id "$id" '.tasks | any(.id == $id)' "$f" >/dev/null 2>&1 \
        || { echo "No standing task $id. See: friday tasks" >&2; return 1; }
      local edit
      case "$cmd" in
        pause)  edit='.tasks |= map(if .id == $id then .paused = true else . end)' ;;
        resume) edit='.tasks |= map(if .id == $id then .paused = false else . end)' ;;
        delete) edit='.tasks |= map(select(.id != $id))' ;;
      esac
      local tmp="$f.tmp.$$"
      ( umask 077; jq --arg id "$id" "$edit" "$f" >"$tmp" ) && mv -f "$tmp" "$f" \
        || { rm -f "$tmp"; echo "FRIDAY couldn't change $f" >&2; return 1; }
      echo "Standing task $id: $cmd done."
      ;;
    *)
      echo "usage: friday tasks [list|--json|pause <id>|resume <id>|delete <id>]" >&2
      return 2
      ;;
  esac
}

friday_sent() {
  local n="${1:-20}"
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
  local f="$state_dir/egress.jsonl"
  if [ ! -f "$f" ] || [ ! -s "$f" ]; then
    echo "Nothing has been sent yet."
    return 0
  fi

  local now_sec cutoff_sec total=0 screenshots=0 masked_sum=0
  now_sec=$(date +%s)
  cutoff_sec=$(( now_sec - 7 * 86400 ))
  declare -A prov_counts

  while IFS=$'\t' read -r ts provider model text_chars image_bytes masked outcome; do
    [ -z "$ts" ] && continue
    local p_name ts_sec
    p_name=$(friday_sent_map_provider "$provider")
    ts_sec=$(date -d "$ts" +%s 2>/dev/null || echo 0)
    if [ "$ts_sec" -ge "$cutoff_sec" ]; then
      total=$(( total + 1 ))
      prov_counts["$p_name"]=$(( ${prov_counts["$p_name"]:-0} + 1 ))
      if [ "${image_bytes:-0}" -gt 0 ]; then
        screenshots=$(( screenshots + 1 ))
      fi
      masked_sum=$(( masked_sum + ${masked:-0} ))
    fi
  done < <(jq -r '[.ts // "", .provider // "", .model // "", (.text_chars // 0), (.image_bytes // 0), (.masked // 0), .outcome // ""] | @tsv' "$f" 2>/dev/null)

  local table_rows=""
  while IFS=$'\t' read -r ts provider model text_chars image_bytes masked outcome kinds; do
    [ -z "$ts" ] && continue
    local p_name local_time chars_fmt ib what
    p_name=$(friday_sent_map_provider "$provider")
    local_time=$(date -d "$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")
    chars_fmt=$(friday_sent_format_num "${text_chars:-0}")
    ib="${image_bytes:-0}"
    if [[ "$kinds" == *"search"* ]]; then
      what="search $chars_fmt chars"
    elif [ "$ib" -ge 1024 ]; then
      local kb=$(( (ib + 512) / 1024 ))
      what="text $chars_fmt chars + screenshot $(friday_sent_format_num "$kb") KB"
    elif [ "$ib" -gt 0 ]; then
      what="text $chars_fmt chars + screenshot $(friday_sent_format_num "$ib") B"
    else
      what="text $chars_fmt chars"
    fi
    table_rows+="$(printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$local_time" "$p_name" "$model" "$what" "${masked:-0}" "$outcome")"$'\n'
  done < <(tail -n "$n" "$f" | jq -r '[.ts // "", .provider // "", .model // "", (.text_chars // 0), (.image_bytes // 0), (.masked // 0), .outcome // "", ((.kinds // []) | join(","))] | @tsv' 2>/dev/null)

  if [ -n "$table_rows" ]; then
    {
      printf 'TIME\tPROVIDER\tMODEL\tWHAT\tMASKED\tOUTCOME\n'
      printf '%s' "$table_rows"
    } | column -t -s $'\t'
    echo
  fi

  if [ "$total" -gt 0 ]; then
    local prov_list=()
    for p in "${!prov_counts[@]}"; do
      prov_list+=("${prov_counts[$p]} $p")
    done
    IFS=$'\n' sorted_provs=($(sort -rn <<<"${prov_list[*]}"))
    unset IFS
    local prov_str=""
    for sp in "${sorted_provs[@]}"; do
      [ -z "$sp" ] && continue
      if [ -n "$prov_str" ]; then
        prov_str="$prov_str, $sp"
      else
        prov_str="$sp"
      fi
    done

    local req_word="requests"
    [ "$total" -eq 1 ] && req_word="request"
    local summary="$total $req_word in the last 7 days: $prov_str"
    if [ "$screenshots" -gt 0 ]; then
      summary="$summary; $screenshots with a screenshot"
    fi
    if [ "$masked_sum" -gt 0 ]; then
      local sec_word="secrets"
      [ "$masked_sum" -eq 1 ] && sec_word="secret"
      summary="$summary; $masked_sum $sec_word masked"
    fi
    echo "$summary"
  else
    echo "0 requests in the last 7 days."
  fi
}

friday_private() {
  local sub="${1:-status}"
  case "$sub" in
    on)
      shift
      local model="${1:-}"
      local vision=1
      echo "Answers stay on this computer — nothing leaves this machine."
      echo "Slower than cloud models and uses your computer's CPU or GPU."
      echo "Needs ~3–5 GB of disk space for the local model."
      if [ -z "$model" ]; then
        local total_kb=0
        if [ -r /proc/meminfo ]; then
          total_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
        fi
        if [ "$total_kb" -gt 0 ] && [ "$total_kb" -lt 8000000 ]; then
          model="qwen3:1.7b"
          vision=0
        else
          model="gemma3:4b"
          vision=1
        fi
      else
        case "$model" in
          *gemma3*|*vision*|*llava*|*minicpm*|*moondream*) vision=1 ;;
          *) vision=0 ;;
        esac
      fi
      sudo pacman -S --needed --noconfirm ollama
      sudo systemctl enable --now ollama
      local i=0
      while [ "$i" -lt 20 ]; do
        if curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
          break
        fi
        sleep 1
        i=$((i + 1))
      done
      if ! curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
        echo "Timed out waiting for Ollama at http://127.0.0.1:11434" >&2
        return 1
      fi
      ollama pull "$model"
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      mkdir -p "$(dirname "$env_file")"
      (
        umask 077
        {
          grep -vE '^(FRIDAY_PRIVATE|LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION)=' "$env_file" 2>/dev/null || true
          echo "FRIDAY_PRIVATE=1"
          echo "LLAMACPP_ENABLED=1"
          echo "LLAMACPP_BASE_URL=http://127.0.0.1:11434/v1"
          echo "LLAMACPP_MODEL=$model"
          echo "LLAMACPP_VISION=$vision"
        } >"$env_file.tmp"
        chmod 0600 "$env_file.tmp"
        mv -f "$env_file.tmp" "$env_file"
      )
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Private mode is on: $model on this computer."
      ;;
    off)
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      local old_model="<model>"
      if [ -f "$env_file" ]; then
        old_model=$(sed -n 's/^LLAMACPP_MODEL=//p' "$env_file" 2>/dev/null | tail -n1)
        old_model="${old_model:-<model>}"
        (
          umask 077
          grep -vE '^(FRIDAY_PRIVATE|LLAMACPP_ENABLED|LLAMACPP_BASE_URL|LLAMACPP_MODEL|LLAMACPP_VISION)=' "$env_file" >"$env_file.tmp" 2>/dev/null || true
          chmod 0600 "$env_file.tmp"
          mv -f "$env_file.tmp" "$env_file"
        )
      fi
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      echo "Private mode is off."
      echo "Ollama stays installed (sudo pacman -Rns ollama to remove it, ollama rm $old_model to free space)."
      ;;
    status)
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      local is_on=false
      local model=""
      if [ -f "$env_file" ]; then
        if grep -qE '^FRIDAY_PRIVATE=(1|true)' "$env_file" 2>/dev/null; then
          is_on=true
        fi
        model=$(sed -n 's/^LLAMACPP_MODEL=//p' "$env_file" 2>/dev/null | tail -n1)
      fi
      local ollama_running=false
      if curl -s -f -o /dev/null "http://127.0.0.1:11434/" 2>/dev/null; then
        ollama_running=true
      fi
      if $is_on; then
        echo "Private mode: on"
        [ -n "$model" ] && echo "Model: $model"
      else
        echo "Private mode: off"
        [ -n "$model" ] && echo "Model: $model"
      fi
      if $ollama_running; then
        echo "Ollama: running"
      else
        echo "Ollama: not running"
      fi
      ;;
    *)
      echo "Usage: friday private [status|on [model]|off]" >&2
      return 1
      ;;
  esac
}

case "${1:-}" in
  ""|"-h"|"--help"|"help")
    show_help
    exit 0
    ;;
  ask)
    # Desktop entry point (SUPER+Y): prompt, run the goal, report the outcome
    # as a notification, and keep the full answer on disk.
    #   friday ask [text]               ask (prompts if no text)
    #   friday ask --selection [text]   ask about the selected/copied text (SUPER+ALT+Y)
    #   friday ask --screen [text]      ask about what's on screen (SUPER+CTRL+Y);
    #                                   a screenshot goes to the AI provider, this once
    #   friday ask --region [text]      drag out an area of the screen and ask about
    #                                   just that (any monitor)
    #   friday ask --follow-up [text]   ask about the last answer (the answer pill's
    #                                   Follow up)
    #   friday ask --web [text]         ask with web search results and cited sources
    #   friday ask --another provider/model [text]
    #                                   ask again, answered with more care by a
    #                                   different model (the answer pill's
    #                                   Try another model)
    # With FRIDAY Shell running, the answer opens in its answer pill (which also
    # streams it); otherwise it arrives as a notification.
    shift
    use_selection=false use_screen=false use_region=false use_followup=false use_web=false another="" details="" daemon_down=false
    ask_args=()
    while [ $# -gt 0 ]; do
      case "${1:-}" in
        --selection|-s) use_selection=true; ask_args+=(--selection); shift ;;
        --screen) use_screen=true; ask_args+=(--screen); shift ;;
        --region|-r) use_screen=true; use_region=true; ask_args+=(--region); shift ;;
        --follow-up|-f) use_followup=true; ask_args+=(--follow-up); shift ;;
        --web) use_web=true; ask_args+=(--web); shift ;;
        --another) another="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
        *) break ;;
      esac
    done
    goal="$*"
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    history_file="$state_dir/ask-history"
    notify() { notify-send -a FRIDAY -- "$@" 2>/dev/null || true; }
    # FRIDAY Shell's answer pill (services/Answer.qml); fails when it isn't running.
    pill() { command -v quickshell >/dev/null 2>&1 && timeout 3 bash "$0" shell ipc answer "$@" >/dev/null 2>&1; }
    use_pill=false
    pill state && use_pill=true

    context=""
    if $use_followup; then
      context=$(sed '/^<details>/,$d' "$state_dir/last-answer.md" 2>/dev/null || true)
      if [ -z "${context//[[:space:]]/}" ]; then
        notify "FRIDAY" "There's no answer to follow up on yet. Ask something with Super+Y first."
        exit 0
      fi
      context="${context:0:6000}"
    fi

    if $use_selection; then
      # Primary selection (highlighted text) first, then the clipboard.
      source_label="Selected"
      context=$(timeout 2 wl-paste --primary --no-newline 2>/dev/null || true)
      if [ -z "${context//[[:space:]]/}" ]; then
        source_label="Clipboard"
        context=$(timeout 2 wl-paste --no-newline 2>/dev/null || true)
        # The clipboard often holds a just-copied password or token. Never
        # send something shaped like one (a single long token mixing letters
        # and digits) to a cloud model by accident.
        if [[ "$context" =~ ^[^[:space:]]{12,}$ && "$context" =~ [A-Za-z] && "$context" =~ [0-9] ]]; then
          notify "FRIDAY" "The clipboard looks like a password or token, so I won't send it. Highlight the text you mean instead."
          exit 0
        fi
      fi
      if [ -z "${context//[[:space:]]/}" ]; then
        notify "FRIDAY" "Select or copy some text first, then press Super+Alt+Y."
        exit 0
      fi
      context="${context:0:4000}"
      app_context=$(friday_app_context)
    fi

    region=""
    if $use_region; then
      # Esc while dragging cancels; nothing is captured or sent.
      region=$(slurp 2>/dev/null) || exit 0
      [ -n "$region" ] || exit 0
    fi

    if [ -z "$goal" ]; then
      if $use_region; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY ⬚ " --width=70 \
          --placeholder="Ask about the area you picked (a screenshot of it goes to your AI provider)" </dev/null) || exit 0
      elif $use_followup; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=70 \
          --placeholder="Follow up on: $(head -n 1 <<<"$context" | sed 's/^# //' | cut -c1-50)" </dev/null) || exit 0
      elif $use_screen; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY 👁 " --width=70 \
          --placeholder="Ask about your screen (a screenshot goes to your AI provider)" </dev/null) || exit 0
      elif $use_selection; then
        # Quick actions, then your own prompts (one per line in
        # ~/.config/friday/prompts); Shift+Enter sends what you typed instead.
        preview=$(tr '\n\t' '  ' <<<"$context" | cut -c1-40)
        goal=$({
          printf '%s\n' "Summarize this" "Explain this simply" "Translate this to English" \
            "Fix the grammar and spelling; reply with only the corrected text"
          sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "${XDG_CONFIG_HOME:-$HOME/.config}/friday/prompts" 2>/dev/null || true
        } | fuzzel --dmenu --prompt="FRIDAY › " --width=70 --lines=8 \
          --placeholder="$source_label: \"$preview…\" · pick or type (Shift+Enter sends it)") || exit 0
      elif [ -s "$history_file" ]; then
        # Recent asks, newest first. Enter re-runs the highlighted one;
        # Shift+Enter sends exactly what was typed (fuzzel execute-input).
        goal=$(fuzzel --dmenu --prompt="FRIDAY › " --width=60 --minimal-lines --lines=8 \
          --placeholder="Ask anything · Shift+Enter sends your text as typed" \
          <"$history_file") || exit 0
      else
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=60 \
          --placeholder="Ask anything" </dev/null) || exit 0
      fi
    fi
    # Privacy rule: web search happens ONLY when explicitly asked (--web, or question prefixes)
    shopt -s nocasematch
    if [[ "$goal" =~ ^search[[:space:]]+the[[:space:]]+web[[:space:]]+for[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    elif [[ "$goal" =~ ^search[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    elif [[ "$goal" =~ ^look[[:space:]]+up[[:space:]]+(.*)$ ]]; then
      use_web=true
      goal="${BASH_REMATCH[1]}"
    fi
    # Asking about the screen in words is asking to look at it, the same as
    # Super+Ctrl+Y: never answer "I can't see your screen" to that. Narrow on
    # purpose ("how do I change my screen brightness" is not a look).
    if ! $use_screen && ! $use_selection && ! $use_followup && ! $use_web &&
      [[ ! "$goal" =~ ^(how|why)[[:space:]]+(do|to|can|should|would|does) ]] &&
      [[ "$goal" =~ (on|at|in)[[:space:]]+(my|the|this)[[:space:]]+(screen|window|display)|what[[:space:]]+am[[:space:]]+i[[:space:]]+(looking|looking[[:space:]]+at)|what.s[[:space:]]+on[[:space:]]+(my[[:space:]]+)?screen|look[[:space:]]+at[[:space:]]+(my|this)[[:space:]]+screen ]]; then
      use_screen=true
      ask_args+=(--screen)
    fi
    shopt -u nocasematch
    [ -n "${goal// /}" ] || exit 0
    # Things this computer can answer or do itself go nowhere.
    local_answer=""
    if ! $use_selection && ! $use_screen && ! $use_followup; then
      local_answer=$(friday_local_command "$goal") || local_answer=""
    fi
    # Questions, selected text and answers are private: only you can open
    # this directory (also fixes one made world-readable by an older version).
    mkdir -p "$state_dir" && chmod 700 "$state_dir"
    # Remember the question (not the pasted context): newest first, no dups, last 50.
    { printf '%s\n' "$goal"; grep -vxF -- "$goal" "$history_file" 2>/dev/null || true; } \
      | head -n 50 >"$history_file.tmp" && mv -f "$history_file.tmp" "$history_file"

    request="$goal"
    if $use_followup; then
      request=$(printf '%s\n\nThis follows up on my previous question and your answer:\n"""\n%s\n"""' "$goal" "$context")
    elif [ -n "$context" ]; then
      request=$(printf '%s\n\nUse this text as context:\n"""\n%s\n"""' "$goal" "$context")
      [ -z "${app_context:-}" ] || request="$request"$'\n'"$app_context"
    fi

    ok=true
    ctl_rc=0
    # One notification that fills in as the answer streams (-p gives its id,
    # -r replaces it); the final answer replaces it too. friday-ctl --stream
    # prints the answer so far as {"partial": ...} lines.
    stream_ctl() {
      local outf ctl shown="" partial view
      outf=$(mktemp)
      "$@" --stream >"$outf" 2>&1 &
      ctl=$!
      while kill -0 "$ctl" 2>/dev/null; do
        sleep 0.4
        [ -n "$nid" ] || continue
        partial=$(grep '^{"partial"' "$outf" | tail -n 1 | jq -r '.partial // empty' 2>/dev/null || true)
        if [ -n "$partial" ] && [ "$partial" != "$shown" ]; then
          view="$partial"
          [ "${#view}" -le 280 ] || view="…${view: -279}"
          notify-send -a FRIDAY -r "$nid" -- "FRIDAY · $goal" "$view" 2>/dev/null || true
          shown="$partial"
        fi
      done
      ctl_rc=0
      wait "$ctl" || ctl_rc=$?
      [ "$ctl_rc" -eq 0 ] || ok=false
      out=$(cat "$outf"); rm -f "$outf"
    }

    show_answer() {
      local ans_ok="$1" summary_json="$2" raw_out="$3"
      local answer title details preview urgency actions meta=""
      [ "$(jq -r '.local // false' <<<"$summary_json" 2>/dev/null)" = true ] && meta="On this computer · nothing was sent"
      if $ans_ok; then
        answer=$(jq -r '.result // empty' <<<"$summary_json")
        [ -n "$answer" ] || answer="Done: $goal"
        title="FRIDAY ✓"
      else
        answer=$(jq -r '.error // .outcome // empty' <<<"$summary_json")
        [ -n "$answer" ] || answer="$raw_out"
        # Plain-language messages for the failures people actually hit; the raw
        # error stays in the saved answer for debugging.
        details="$answer"
        case "$answer$raw_out" in
          *FreeUsageLimitError*)
            answer="OpenCode Zen's free limit is used up for now. Try again later, or add your own key: friday setup-ai" ;;
          # friday-ctl's own errors only: a provider's "Connection refused"
          # (say, a local model server that isn't running) is not FRIDAY down.
          *"no token found"*|*"cannot reach daemon"*)
            answer="FRIDAY isn't running, so I couldn't ask. Start it and try again."
            daemon_down=true ;;
          *"timed out after"*)
            answer="This is taking longer than expected. FRIDAY may still be working on it: check the bar icon, or run friday answers --last later." ;;
          *) details="" ;;
        esac
        title="FRIDAY ✗ $goal"
      fi

      # Full answer on disk; the notification shows a preview with an Open button.
      answer_file="$state_dir/last-answer.md"
      {
        printf '# %s\n\n_%s_\n\n' "$goal" "$(date '+%Y-%m-%d %H:%M')"
        [ -n "$context" ] && printf '> %s\n\n' "$(head -c 300 <<<"$context" | tr '\n' ' ')"
        printf '%s\n' "$answer"
        [ -z "${details:-}" ] || printf '\n<details>\n\n```\n%s\n```\n' "$details"
      } >"$answer_file"
      # Each entry opens with a marker line, so a "---" inside an answer
      # never splits it (FRIDAY Shell's answer history reads these).
      { printf '<!-- friday answer -->\n'; cat "$answer_file"; printf '\n---\n\n'; } >>"$state_dir/answers.md"

      # Spoken answers (friday voice speak on): the answer is read aloud while
      # the card shows it; a new answer, or friday say --stop, ends it.
      if $ans_ok && [ -e "$(friday_speak_flag)" ] && friday_speak_ready; then
        ( printf '%s' "$answer" | friday-ctl say - ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
      fi

      preview="$answer"
      [ "${#preview}" -le 220 ] || preview="${preview:0:217}…"
      [ -z "$meta" ] || preview="$preview\n$meta"
      local served_model=""
      if $ans_ok; then
        local is_private=false
        local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
        if [ "$(jq -r '.private // false' "$state_dir/state.json" 2>/dev/null || true)" = "true" ] \
           || { [ -r "$env_file" ] && grep -qE '^FRIDAY_PRIVATE=(1|true)' "$env_file" 2>/dev/null; }; then
          is_private=true
        fi
        local served_p served_ms
        served_p=$(jq -r '.served_by.provider // empty' <<<"$summary_json" 2>/dev/null || true)
        served_model=$(jq -r 'select(.served_by.provider != null) | .served_by.provider + "/" + (.served_by.model // "")' <<<"$summary_json" 2>/dev/null || true)
        served_ms=$(jq -r '.served_by.ms // empty' <<<"$summary_json" 2>/dev/null || true)
        if $is_private; then
          preview="$preview\nPrivate · on this computer"
          meta="Private · on this computer"
        elif [ -n "$served_p" ]; then
          local p_name
          case "$served_p" in
            opencode-zen) p_name="OpenCode Zen" ;;
            kilo) p_name="Kilo" ;;
            claude-code) p_name="Claude Code" ;;
            codex) p_name="Codex" ;;
            antigravity) p_name="Antigravity" ;;
            cline) p_name="Cline" ;;
            *) p_name="$served_p" ;;
          esac
          local sec="0.0"
          if [[ "$served_ms" =~ ^[0-9]+$ ]]; then
            local rounded=$(( (served_ms + 50) / 100 ))
            sec="$(( rounded / 10 )).$(( rounded % 10 ))"
          fi
          preview="$preview\nvia $p_name · ${sec} s"
          meta="via $p_name · ${sec} s"
        fi
        local masked_count
        masked_count=$(jq -r '.masked // empty' <<<"$summary_json" 2>/dev/null || true)
        if [[ "$masked_count" =~ ^[0-9]+$ ]] && [ "$masked_count" -gt 0 ]; then
          preview="$preview\n$masked_count secret(s) masked before sending"
          meta="${meta:+$meta · }$masked_count secret(s) masked before sending"
        fi
        if [ -n "${app_context:-}" ]; then
          preview="$preview\nIncluded the app name and window title"
          meta="${meta:+$meta · }Included the app name and window title"
        fi
      fi
      # The pill shows the whole answer and its own buttons; a notification
      # only when it isn't there, or for "Start FRIDAY", which only a
      # notification offers.
      if $use_pill && [ "${daemon_down:-false}" != true ] \
        && pill present "$ans_ok" "$goal" "$answer" "$meta" "${ask_args[0]:-}" "${served_model:-}"; then
        return 0
      fi
      urgency=normal; $ans_ok || urgency=critical
      if $ans_ok; then
        actions=(-A copy="Copy" -A again="Ask again" -A open="Open full answer")
      else
        actions=(-A open="Open full answer")
        [ "${daemon_down:-false}" = true ] && actions=(-A start="Start FRIDAY")
      fi
      # Replace the streaming notification rather than add a second one.
      [ -z "${nid:-}" ] || actions+=(-r "$nid")
      (
        open_answer() {
          foot -T "FRIDAY · $goal" less -R "$answer_file" 2>/dev/null \
            || xdg-open "$answer_file" 2>/dev/null || true
        }
        action=$(notify-send -a FRIDAY -u "$urgency" "${actions[@]}" -- "$title" "$preview" 2>/dev/null || true)
        case "$action" in
          copy)
            if command -v wl-copy >/dev/null 2>&1; then
              printf '%s' "$answer" | wl-copy 2>/dev/null || true
            else
              open_answer
            fi ;;
          again)
            [ -x "$0" ] && exec "$0" ask "${ask_args[@]}" || exec bash "$0" ask "${ask_args[@]}" ;;
          open)
            open_answer ;;
          start)
            systemctl --user restart friday-linux-daemon 2>/dev/null \
              && notify-send -a FRIDAY "FRIDAY" "Started. Ask again with Super+Y." 2>/dev/null || true ;;
        esac
      ) </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null || true
    }

    if [ -n "$local_answer" ]; then
      show_answer true "$(jq -n --arg r "$local_answer" '{result: $r, local: true}')" ""
      exit 0
    fi

    if $use_screen; then
      # Pressing the key and typing the question is the per-use consent;
      # the daemon's ContextGate still enforces it.
      nid=""
      $use_pill || nid=$(notify-send -a FRIDAY -p -- "FRIDAY" "Looking at your screen: $goal" 2>/dev/null || true)
      [[ "$nid" =~ ^[0-9]+$ ]] || nid=""
      stream_ctl friday-ctl context screen --yes --ask "$goal" ${region:+--region "$region"}
      summary=$(jq -s 'map(select(type == "object" and (has("partial") | not))) | last // {} | {result: .response, error: .error}' <<<"$out" 2>/dev/null || echo '{}')
    else
      nid=""
      $use_pill || nid=$(notify-send -a FRIDAY -p -- "FRIDAY" "Working on: $goal" 2>/dev/null || true)
      [[ "$nid" =~ ^[0-9]+$ ]] || nid=""
      ctl_args=(goal --wait)
      $use_web && ctl_args+=(--web)
      [ -z "$another" ] || ctl_args+=(--thorough --avoid "$another")
      ctl_args+=("$request")
      stream_ctl friday-ctl "${ctl_args[@]}"
      # The final {outcome,result,error} object; keep every line of the answer.
      summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$out" 2>/dev/null || echo '{}')
    fi

    action_to_confirm=$(jq -r '.needs_confirmation.action // empty' <<<"$summary" 2>/dev/null || true)
    if [ "$ctl_rc" -eq 3 ] && [ -n "$action_to_confirm" ]; then
      (
        action=$(friday_confirm "$action_to_confirm" "${nid:-}")
        case "$action" in
          run)
            conf_ok=true
            conf_args=(goal --wait --confirm "$action_to_confirm")
            $use_web && conf_args+=(--web)
            conf_args+=("$request")
            conf_out=$(friday-ctl "${conf_args[@]}" 2>&1) || conf_ok=false
            conf_summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$conf_out" 2>/dev/null || echo '{}')
            show_answer "$conf_ok" "$conf_summary" "$conf_out"
            ;;
          cancel|*)
            ;;
        esac
      ) </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null || true
      exit 0
    fi

    show_answer "$ok" "$summary" "$out"
    ;;
  goal)
    shift
    exec friday-ctl goal "$@"
    ;;
  cancel)
    if friday-ctl cancel >/dev/null 2>&1; then
      echo "Cancelled the current goal."
      notify-send -a FRIDAY "FRIDAY" "Cancelled the current goal." 2>/dev/null || true
    else
      echo "Nothing to cancel: no goal is running." >&2
      exit 1
    fi
    ;;
  doctor)
    friday_doctor
    ;;
  report)
    shift
    friday_report "$@"
    ;;
  setup-ai)
    shift
    friday_setup_ai "$@"
    ;;
  connect)
    shift
    friday_connect "$@"
    ;;
  disconnect)
    shift
    friday_disconnect "$@"
    ;;
  private)
    shift
    friday_private "$@"
    ;;
  tour)
    FRIDAY_WELCOME_DELAY=0 friday_welcome --force
    ;;
  welcome)
    shift
    friday_welcome "$@"
    ;;
  voice)
    shift
    if [ "${1:-}" = speak ]; then shift; friday_voice_speak "$@"; else friday_voice "$@"; fi
    ;;
  say)
    shift
    exec friday-ctl say "$@"
    ;;
  hold)
    shift
    friday_hold "$@"
    ;;
  face)
    shift
    friday_face "$@"
    ;;
  phone)
    shift
    friday_phone "$@"
    ;;
  screen-text)
    shift
    friday_screen_text "$@"
    ;;
  helper)
    shift
    friday_helper "$@"
    ;;
  answers)
    d="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    f="$d/answers.md"; [ "${2:-}" = "--last" ] && f="$d/last-answer.md"
    if [ ! -s "$f" ]; then echo "No answers yet. Try: friday ask \"what's using my disk?\""; exit 0; fi
    if [ -t 1 ]; then exec less -R +G "$f"; else cat "$f"; fi
    ;;
  sent)
    shift
    friday_sent "$@"
    ;;
  actions)
    shift
    friday_actions "$@"
    ;;
  tasks)
    shift
    friday_tasks "$@"
    ;;
  app-context)
    shift
    friday_app_context_cmd "$@"
    ;;
  forget)
    shift
    friday_forget "$@"
    ;;
  status|system-info)
    shift
    exec friday-ctl system-info "$@"
    ;;
  context)
    shift
    exec friday-ctl context "$@"
    ;;
  shell)
    # FRIDAY Shell. A copy in ~/.config/friday/shell (or $FRIDAY_SHELL_DIR)
    # takes precedence over the packaged one, for people who want to edit it.
    shift
    dir="${FRIDAY_SHELL_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell}"
    [ -f "$dir/shell.qml" ] || dir=/usr/share/friday/shell
    [ -f "$dir/shell.qml" ] || { echo "friday: FRIDAY Shell not found ($dir)" >&2; exit 1; }
    command -v quickshell >/dev/null 2>&1 || { echo "friday: quickshell is not installed" >&2; exit 1; }
    pidfile="${XDG_RUNTIME_DIR:-/tmp}/friday-shell-$(id -u).pid"
    supervisor=""
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then supervisor=$(cat "$pidfile"); fi
    case "${1:-start}" in
      start)
        if [ -n "$supervisor" ]; then echo "FRIDAY Shell is already running (pid $supervisor)"; exit 0; fi
        shell_supervise "$dir" "$pidfile" ;;
      restart)
        if [ -n "$supervisor" ]; then
          # The supervisor starts it again; the flag says this exit is wanted.
          : >"$pidfile.restart"
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
        else
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
          setsid -f "$0" shell start >/dev/null 2>&1 </dev/null
        fi ;;
      stop)
        if [ -n "$supervisor" ]; then kill -TERM "$supervisor"; else exec quickshell kill -p "$dir"; fi ;;
      style|palette)
        # The look, as the control drawer's Look picker sets it: merged into
        # shell.json, which the shell applies live.
        key=$1; shift
        if [ "$key" = style ]; then opts="ember island dock"; else opts="ember frost moss dawn omarchy"; fi
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        cur=$(jq -r --arg k "$key" '.[$k] // empty' "$conf" 2>/dev/null || true)
        [ "$cur" = friday ] && cur=ember
        if [ -z "${1:-}" ] || [ "$1" = list ]; then
          for o in $opts; do if [ "$o" = "${cur:-ember}" ]; then echo "* $o"; else echo "  $o"; fi; done
          exit 0
        fi
        case " $opts " in
          *" $1 "*) ;;
          *) echo "friday: no $key '$1' (choose one of: $opts)" >&2; exit 1 ;;
        esac
        mkdir -p "$(dirname "$conf")"
        if ! jq --arg k "$key" --arg v "$1" '.[$k] = $v' "$conf" >"$conf.tmp" 2>/dev/null; then
          jq -n --arg k "$key" --arg v "$1" '{($k): $v}' >"$conf.tmp"
        fi
        mv -f "$conf.tmp" "$conf"
        shell_window_look
        echo "FRIDAY Shell $key: $1" ;;
      close)   exec quickshell -p "$dir" ipc call shell close ;;
      ipc)     shift; exec quickshell -p "$dir" ipc call "$@" ;;
      friday|control|calendar|launcher|session)
               exec quickshell -p "$dir" ipc call shell toggle "$1" ;;
      *) echo "Usage: friday shell [start|restart|stop|close|friday|control|calendar|launcher|session|style [name]|palette [name]|ipc <target> <fn> [args]]" >&2; exit 1 ;;
    esac
    ;;
  daemon)
    shift
    sub="${1:-status}"
    case "$sub" in
      status)  exec systemctl --user status friday-linux-daemon ;;
      restart) exec systemctl --user restart friday-linux-daemon ;;
      stop)    exec systemctl --user stop friday-linux-daemon ;;
      start)   exec systemctl --user start friday-linux-daemon ;;
      logs)    exec journalctl --user -u friday-linux-daemon -f ;;
      *) echo "Usage: friday daemon <status|restart|start|stop|logs>" ; exit 1 ;;
    esac
    ;;
  create-skill|validate|publish)
    if [ -x /usr/lib/friday/friday-skill-forge ]; then
      exec /usr/lib/friday/friday-skill-forge "$@"
    elif [ -x /usr/bin/friday-skill-forge ]; then
      exec /usr/bin/friday-skill-forge "$@"
    elif [ -x "$(dirname "$0")/friday-skill-forge" ]; then
      exec "$(dirname "$0")/friday-skill-forge" "$@"
    else
      echo "friday: skill-forge component not found" >&2
      exit 1
    fi
    ;;
  *)
    # Route to Omarchy substrate commands
    if command -v omarchy >/dev/null 2>&1; then
      exec omarchy "$@"
    elif [ -x /usr/share/omarchy/bin/omarchy ]; then
      exec /usr/share/omarchy/bin/omarchy "$@"
    elif [ -x "$(dirname "$0")/../share/omarchy/bin/omarchy" ]; then
      exec "$(dirname "$0")/../share/omarchy/bin/omarchy" "$@"
    else
      echo "friday: unrecognized command '$1' and omarchy substrate not found" >&2
      exit 1
    fi
    ;;
esac
