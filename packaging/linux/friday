friday_sent_format_num() {
  echo "$1" | sed -E ':a;s/([0-9])([0-9]{3}(\b|,))/\1,\2/;ta'
}

# The focused kitty window's last command, when it failed. kitty reports the
# command, its exit code and its output itself (shell integration and remote
# control, both on in FRIDAY OS's kitty.conf). Prints
# "<exit>\t<command>\t<folder>\t<socket>\t<window id>", or nothing.
# The remote-control socket of the focused kitty window, or nothing.
friday_kitty_sock() {
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && command -v kitten >/dev/null 2>&1 || return 0
  local win pid sock
  win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  [ "$(jq -r '.class // empty' <<<"$win" 2>/dev/null)" = kitty ] || return 0
  pid=$(jq -r '.pid // empty' <<<"$win" 2>/dev/null)
  for sock in "${XDG_RUNTIME_DIR:-/tmp}/omarchy-kitty-$pid" "${XDG_RUNTIME_DIR:-/tmp}/kitty-$pid"; do
    [ -S "$sock" ] && break
  done
  [ -n "$pid" ] && [ -S "$sock" ] && printf '%s' "$sock"
  return 0
}

# The command running now in the focused kitty window: "command\tsocket\tid".
friday_kitty_running() {
  local sock; sock=$(friday_kitty_sock)
  [ -n "$sock" ] || return 0
  timeout 3 kitten @ --to "unix:$sock" ls 2>/dev/null | jq -r --arg s "$sock" '
    [.[] | select(.is_focused) | .tabs[] | select(.is_focused) | .windows[] | select(.is_focused)][0]
    | select(. != null and (.at_prompt | not) and (.last_reported_cmdline // "") != "")
    | [(.last_reported_cmdline | gsub("[\t\n]"; " ")), $s, .id] | @tsv' 2>/dev/null || true
}

friday_last_error() {
  local sock; sock=$(friday_kitty_sock)
  [ -n "$sock" ] || return 0
  timeout 3 kitten @ --to "unix:$sock" ls 2>/dev/null | jq -r --arg s "$sock" '
    [.[] | select(.is_focused) | .tabs[] | select(.is_focused) | .windows[] | select(.is_focused)][0]
    | select(. != null and .at_prompt and .last_cmd_exit_status != 0 and .last_cmd_exit_status != 130
             and (.last_reported_cmdline // "") != "")
    | [.last_cmd_exit_status, (.last_reported_cmdline | gsub("[\t\n]"; " ")), .cwd, $s, .id] | @tsv' 2>/dev/null || true
}

# `friday shell-hook [zsh|bash]`: lines for your shell's rc file, so "Explain
# the error" and "Tell me when this finishes" work in any terminal (kitty
# reports this itself). Each shell keeps one line in
# $XDG_RUNTIME_DIR/friday-term/<its pid>: running|done, when, the exit code,
# the folder and the command. Never the command's output.
friday_shell_hook() {
  case "${1:-zsh}" in
    zsh) cat <<'EOF'
zmodload zsh/datetime 2>/dev/null
typeset -g _friday_tf="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/friday/run}/friday-term/$$" _friday_cmd="" _friday_dir=""
_friday_term() { mkdir -p -m 700 "${_friday_tf:h}" 2>/dev/null; print -r -- "$1"$'\t'"${EPOCHSECONDS:-0}"$'\t'"$2"$'\t'"$_friday_dir"$'\t'"$_friday_cmd" >| "$_friday_tf" 2>/dev/null; }
_friday_preexec() { _friday_cmd=${1//[$'\t\n']/ } _friday_dir=$PWD; _friday_term running -; }
_friday_precmd() { local s=$?; [[ -n $_friday_cmd ]] && _friday_term done $s; _friday_cmd=""; return 0; }
_friday_zshexit() { rm -f "$_friday_tf"; }
autoload -Uz add-zsh-hook
add-zsh-hook preexec _friday_preexec
add-zsh-hook precmd _friday_precmd
add-zsh-hook zshexit _friday_zshexit
# First, so it sees the command's exit status before any other hook runs.
precmd_functions=(_friday_precmd ${precmd_functions:#_friday_precmd})
EOF
      ;;
    bash) cat <<'EOF'
# The DEBUG trap records the first command after a prompt that isn't one of
# PROMPT_COMMAND's own (starship and the like). With bash-preexec, its hooks
# are used instead.
_friday_tf="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/friday/run}/friday-term/$$" _friday_cmd="" _friday_dir="" _friday_ready=""
_friday_term() { mkdir -p -m 700 "${_friday_tf%/*}" 2>/dev/null; printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$(date +%s)" "$2" "$_friday_dir" "$_friday_cmd" >| "$_friday_tf" 2>/dev/null; }
_friday_start() { local n c; read -r n c <<<"$(HISTTIMEFORMAT= history 1)"; _friday_cmd=${1:-$c}; _friday_cmd=${_friday_cmd//[$'\t\n']/ } _friday_dir=$PWD; _friday_term running -; }
_friday_debug() { [[ -n $_friday_ready ]] || return 0; local p="${PROMPT_COMMAND[*]}" b="$BASH_COMMAND"; [[ ${p//[[:space:]]/} != *"${b//[[:space:]]/}"* ]] || return 0; _friday_ready=""; _friday_start; }
_friday_prompt() { local s=$?; [[ -n $_friday_cmd ]] && _friday_term done $s; _friday_cmd="" _friday_ready=1; return $s; }
if declare -F __bp_install >/dev/null 2>&1 || [[ -n ${bash_preexec_imported:-} ]]; then
  preexec_functions+=(_friday_start); precmd_functions=(_friday_prompt "${precmd_functions[@]}")
elif [[ -z $(trap -p DEBUG) ]]; then
  trap '_friday_debug' DEBUG
  if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    PROMPT_COMMAND=(_friday_prompt "${PROMPT_COMMAND[@]}")
  else
    PROMPT_COMMAND="_friday_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
  fi
fi
EOF
      ;;
    *) echo "Usage: friday shell-hook [zsh|bash]  (then: eval \"\$(friday shell-hook zsh)\" in ~/.zshrc)" >&2; return 1 ;;
  esac
}

# The shell-hook line of the shell in the focused window (any terminal but
# kitty): the newest one among the window's processes. Prints
# "state\twhen\texit\tfolder\tcommand\tshell pid\twindow class", or nothing.
friday_term_record() {
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local dir="$(friday_run)/friday-term" win pid cls pids p f best=""
  [ -d "$dir" ] || return 0
  win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  pid=$(jq -r '.pid // empty' <<<"$win" 2>/dev/null) cls=$(jq -r '.class // empty' <<<"$win" 2>/dev/null)
  [[ "$pid" =~ ^[0-9]+$ && "$cls" != kitty ]] || return 0
  # Every process under the window's: its shells are in there.
  pids=$(ps -eo pid=,ppid= 2>/dev/null | awk -v root="$pid" '{ kids[$2] = kids[$2] " " $1 }
    END { q = root; while (q != "") { split(q, a, " "); q = ""; for (i in a) { print a[i]; q = q " " kids[a[i]] } } }')
  for p in $pids; do
    f="$dir/$p"
    [ -f "$f" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best="$f"; fi
  done
  [ -n "$best" ] && printf '%s\t%s\t%s\n' "$(head -n1 "$best")" "${best##*/}" "$cls"
  return 0
}

# friday_term_text <shell pid>: the last lines of that shell's WezTerm pane
# (found by its terminal), or nothing (other terminals have no way to read them).
friday_term_text() {
  command -v wezterm >/dev/null 2>&1 || return 0
  local tty pane
  tty=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ')
  [ -n "$tty" ] && [ "$tty" != "?" ] || return 0
  pane=$(timeout 3 wezterm cli list --format json 2>/dev/null | jq -r --arg t "/dev/$tty" 'map(select(.tty_name == $t)) | .[0].pane_id // empty' 2>/dev/null || true)
  [[ "$pane" =~ ^[0-9]+$ ]] || return 0
  timeout 3 wezterm cli get-text --pane-id "$pane" --start-line -150 2>/dev/null | cut -c1-400 || true
}

# friday term-watch <pid>: wait for that shell's running command to finish
# (up to a day), then say how it went.
friday_term_watch() {
  local f="$(friday_run)/friday-term/$1" line state when code cmd start="" i
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  for ((i = 0; i < 43200; i++)); do
    # The shell closed (or was killed): nothing more will come.
    kill -0 "$1" 2>/dev/null || return 0
    line=$(head -n1 "$f" 2>/dev/null) || return 0
    IFS=$'\t' read -r state when code _ cmd <<<"$line"
    [ -n "$start" ] || start="$when"
    # Another command started while we slept: the watched one is over.
    if [ "$state" = running ] && [ "$when" != "$start" ]; then
      notify-send -a FRIDAY -- "FRIDAY" "Finished." 2>/dev/null || true
      return 0
    fi
    if [ "$state" = done ]; then
      case "$code" in
        0) notify-send -a FRIDAY -- "FRIDAY" "Finished: ${cmd:0:80}" 2>/dev/null || true ;;
        130) notify-send -a FRIDAY -- "FRIDAY" "Stopped: ${cmd:0:80}" 2>/dev/null || true ;;
        *) notify-send -a FRIDAY -u critical -- "FRIDAY" "Failed (exit $code): ${cmd:0:80}. Super+Y explains it." 2>/dev/null || true ;;
      esac
      return 0
    fi
    sleep 2
  done
}

# A rewrite's text as the model may wrap it: drop a code fence or quotes
# around the whole answer.
friday_rewrite_clean() {
  local t="$1"
  if [[ "$t" == '```'* && "$t" == *'```' ]]; then t=$(sed '1d;$d' <<<"$t"); fi
  if [[ ${#t} -ge 2 && "$t" == '"'*'"' && "${t:1:${#t}-2}" != *'"'* ]]; then t="${t:1:${#t}-2}"; fi
  printf '%s' "$t"
}

# friday_replace_selection <text> <window address> [terminals]: put the
# rewrite where the selection was. Pastes (Ctrl+V, sent by Hyprland as
# Omarchy's universal paste does) only into the same window, still focused;
# into a terminal only with "terminals" (Shift+Insert there; a terminal's
# selection isn't editable, but its prompt is). Otherwise the text is left on
# the clipboard. The clipboard is put back afterwards when it held text.
# [undo label] [original text]: a paste with Ctrl+V can be undone with
# `friday undo` (as "<label>").
friday_replace_selection() {
  local text="$1" addr="$2" win now terminal=false old="" had_text=false mods=CTRL key=V
  win=$(timeout 2 hyprctl activewindow -j 2>/dev/null || true)
  now=$(jq -r '.address // empty' <<<"$win" 2>/dev/null || true)
  jq -e '(.tags // []) | any(sub("\\*$"; "") == "terminal")' <<<"$win" >/dev/null 2>&1 && terminal=true
  if timeout 2 wl-paste --list-types 2>/dev/null | grep -q '^text/plain'; then
    old=$(timeout 2 wl-paste --no-newline 2>/dev/null || true); had_text=true
  fi
  printf '%s' "$text" | wl-copy
  if $terminal && [ "${3:-}" = terminals ]; then terminal=false mods=SHIFT key=Insert; fi
  if [ -n "$addr" ] && [ "$now" = "$addr" ] && ! $terminal; then
    sleep 0.15
    timeout 2 hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"down\" })" >/dev/null 2>&1 || true
    sleep 0.05
    timeout 2 hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"up\" })" >/dev/null 2>&1 || true
    # The app reads the clipboard after the paste; put yours back a moment later.
    if $had_text; then ( sleep 1; printf '%s' "$old" | wl-copy ) >/dev/null 2>&1 & fi
    # Ctrl+Z undoes a Ctrl+V; in a terminal it would stop the running program.
    if [ "$mods" = CTRL ] && [ -n "${4:-}" ]; then friday_undo_add "$4" text "$addr" "${5:-}"; fi
    return 0
  fi
  notify-send -a FRIDAY -- "FRIDAY" "The rewrite is on your clipboard: paste it with Ctrl+V." 2>/dev/null || true
}

# `friday paste-as` (Super+Alt+V): the clipboard's text, transformed, pasted
# where you are. The clipboard itself keeps the original.
# With a text argument (a clip from friday clips), that text instead, and
# "As it is" first.
# Whether text is shaped like a password or token: one long run with no
# spaces, mixing letters and digits. A URL (…://…), a path (/…, ~/…, ./…,
# C:\…) or a dotted file name isn't, unless one of its parts is such a run
# of 16 or more (a key in a URL, a JWT). Anything else with a slash (base64,
# an AWS secret) still is. Same rule as the Windows tray (Asking.LooksLikeSecret).
# friday_memory_proposal <question>: what the question says about you, worth
# remembering, as "you use fish" / "your editor is helix"; nothing when it
# says nothing like that (or it looks like a secret).
friday_memory_proposal() {
  local q=" ${1,,} " what="" verb="" w words=() stop=" and but so how what why can could to for with on in at when where which is "
  if [[ "$q" =~ [^a-z\'](i\ use|i\'m\ using|i\ am\ using|i\ prefer|i\ work\ with|i\'m\ on|i\ am\ on|i\ run)\ ([a-z0-9][^,.?!\;:]*) ]]; then
    verb="${BASH_REMATCH[1]}" what="${BASH_REMATCH[2]}"
    case "$verb" in "i'm using"|"i am using") verb="i use" ;; "i'm on"|"i am on") verb="i'm on" ;; esac
  elif [[ "$q" =~ [^a-z]my\ (shell|editor|distro|os|terminal|browser|language|ide|laptop|keyboard\ layout|name)\ is\ ([a-z0-9][^,.?!\;:]*) ]]; then
    verb="my ${BASH_REMATCH[1]} is" what="${BASH_REMATCH[2]}"
  else
    return 1
  fi
  # At most three words, up to the first one that starts the question.
  local -a all
  read -ra all <<<"$what"
  for w in "${all[@]}"; do
    [[ "$stop" == *" $w "* ]] && break
    words+=("$w"); [ "${#words[@]}" -lt 3 ] || break
  done
  what="${words[*]:-}"
  # "I use it for work", "I run into errors" name nothing.
  case "${words[0]:-}" in ""|it|this|that|these|those|them|a|an|the|into|across|out|up|over) return 1 ;; esac
  # Nothing shaped like a key or token, word by word.
  for w in "${words[@]}"; do ! friday_secret_shaped "$w" || return 1; done
  case "$verb" in
    "i use") echo "you use $what" ;; "i prefer") echo "you prefer $what" ;;
    "i work with") echo "you work with $what" ;; "i'm on") echo "you're on $what" ;;
    "i run") echo "you run $what" ;; *) echo "your ${verb#my } $what" ;;
  esac
}

# friday_vague_this <question>: whether a question leans on "this" or "that"
# with nothing saying what it is ("explain this", "what does that mean", "is
# this right?"). "This page", "this error in rust" or an @mention name it.
friday_vague_this() {
  local q="${1,,}"
  [ "${#q}" -le 80 ] && [[ "$q" != *@* ]] || return 1
  [[ "$q" =~ (^|[^a-z])(this|that|these|those)[[:space:]]*(mean|means|say|says|do|does|for[[:space:]]+me|please)?[[:space:]]*[?.!]*$ ]] \
    || [[ "$q" =~ ^(is|are)[[:space:]]+(this|that|these|those)[[:space:]]+(right|correct|ok|okay|true|safe|good|real|legit|a[[:space:]]+scam)[[:space:]]*[?.!]*$ ]] \
    || [[ "$q" =~ ^(translate|summari[sz]e|explain|rewrite|fix|check|proofread|shorten|simplify)[[:space:]]+(this|that|these|those|it)([^a-z]|$) ]]
}

friday_secret_shaped() {
  local t="${1:-}" part
  [[ "$t" =~ ^[^[:space:]]{12,}$ && "$t" =~ [A-Za-z] && "$t" =~ [0-9] ]] || return 1
  [[ "$t" == *://* || "$t" =~ ^(/|~/|\./|\.\./|[A-Za-z]:[\\/]) || "$t" =~ ^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$ ]] || return 0
  local -a parts
  IFS=$'/\\.:?=&#' read -ra parts <<<"$t"
  for part in "${parts[@]}"; do
    [[ ${#part} -ge 16 && "$part" =~ [A-Za-z] && "$part" =~ [0-9] ]] && return 0
  done
  return 1
}

friday_paste_as() {
  local clip win addr pick how request out summary text first=""
  if [ $# -gt 0 ]; then clip="$1" first="As it is"
  else clip=$(timeout 2 wl-paste --no-newline 2>/dev/null || true); fi
  if [ -z "${clip//[[:space:]]/}" ]; then
    notify-send -a FRIDAY -- "FRIDAY" "Copy some text first, then press Super+Alt+V." 2>/dev/null || true
    return 0
  fi
  # Never send something shaped like a password or token (as ask --selection).
  if friday_secret_shaped "$clip"; then
    notify-send -a FRIDAY -- "FRIDAY" "The clipboard looks like a password or token, so I won't send it." 2>/dev/null || true
    return 0
  fi
  clip="${clip:0:4000}"
  addr=$(timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null || true)
  pick=$(printf '%s\n' ${first:+"$first"} "As a bullet list" "As JSON" "As a Markdown table" "Cleaned up (spacing, line breaks, typos)" \
      "Shorter" "More formal" "Translated to English" \
    | fuzzel --dmenu --prompt="Paste › " --width=60 --lines=7 \
      --placeholder="\"$(tr '\n\t' '  ' <<<"$clip" | cut -c1-40)…\" · pick or type how") || return 0
  [ -n "${pick// /}" ] || return 0
  if [ -n "$first" ] && [ "$pick" = "$first" ]; then friday_replace_selection "$1" "$addr" terminals; return 0; fi
  how="$pick"
  case "$pick" in
    "As JSON") how="as JSON (only the JSON)" ;;
    "Cleaned up"*) how="cleaned up: fix spacing, line breaks and typos, change nothing else" ;;
  esac
  request=$(printf 'Rewrite the text below %s. Keep its language unless told to translate. Reply with only the result: no quotes, no notes, no introduction.\n\n[text to rewrite]\n"""\n%s\n"""' "$how" "$clip")
  out=$(friday-ctl goal --wait - <<<"$request" 2>&1) || true
  summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$out" 2>/dev/null || echo '{}')
  text=$(friday_rewrite_clean "$(jq -r 'select(.outcome == "completed") | .result // empty' <<<"$summary" 2>/dev/null || true)")
  if [ -z "${text//[[:space:]]/}" ]; then
    notify-send -a FRIDAY -u critical -- "FRIDAY" "Couldn't paste that: $(jq -r '.error // "no answer"' <<<"$summary" 2>/dev/null | cut -c1-160)" 2>/dev/null || true
    return 1
  fi
  friday_replace_selection "$text" "$addr" terminals "the paste"
}

# `friday clips [status|on|off|pick]` (Super+Ctrl+V picks): the last 200
# texts you copied, kept on this computer (friday-clips user service). Never
# from a private window, never what a password manager marks as a password,
# never something shaped like a password or token. Off forgets them all.
friday_clips() {
  local file="${XDG_STATE_HOME:-$HOME/.local/state}/friday/clips.jsonl" text line
  case "${1:-status}" in
    status)
      if systemctl --user is-enabled --quiet friday-clips.service 2>/dev/null; then
        echo "Clips: on (the last 200 texts you copied; Super+Ctrl+V). Turn off: friday clips off"
      else
        echo "Clips: off. Turn on: friday clips on"
      fi ;;
    on)
      if [ "${2:-}" != "--yes" ]; then
        cat <<'EOF2'
With clips on, FRIDAY keeps the last 200 texts you copy, on this computer only,
so Super+Ctrl+V can paste any of them again, as it is or rewritten. Never from
private windows (password managers, private browsing, banks, and your own list in
~/.config/friday/private-windows), never what a password manager marks as a
password, never anything shaped like a password or token. Turning clips off
forgets them all.
EOF2
        local a
        read -r -p "Turn it on? [y/N] " a || a=n
        [[ "$a" =~ ^[Yy] ]] || { echo "Nothing changed."; return 0; }
      fi
      systemctl --user enable --now friday-clips.service >/dev/null 2>&1 \
        || { echo "Couldn't start clips (systemctl --user enable --now friday-clips.service)." >&2; return 1; }
      echo "Clips: on" ;;
    off)
      systemctl --user disable --now friday-clips.service >/dev/null 2>&1 || true
      rm -f "$file" "$file.tmp"
      echo "Clips: off, and every kept clip is forgotten." ;;
    add)
      # One clipboard change on stdin (wl-paste --watch, from the service).
      text=$(head -c 20000)
      [ -n "${text//[[:space:]]/}" ] || return 0
      # wl-paste --watch marks what a password manager copied as sensitive.
      [ "${CLIPBOARD_STATE:-}" = sensitive ] && return 0
      timeout 2 wl-paste --list-types 2>/dev/null | grep -qi 'passwordmanagerhint' && return 0
      friday_secret_shaped "$text" && return 0
      # A window that can't be read might be a private one: keep nothing.
      if command -v hyprctl >/dev/null 2>&1; then timeout 2 hyprctl activewindow -j >/dev/null 2>&1 || return 0; fi
      [ -z "$(friday_private_window)" ] || return 0
      mkdir -p "$(dirname "$file")"
      line=$(jq -cn --arg t "$text" --argjson ts "$(date +%s)" '{ts: $ts, text: $t}')
      (
        umask 077
        { jq -c --arg t "$text" 'select(.text != $t)' "$file" 2>/dev/null || true
          printf '%s\n' "$line"; } | tail -n 200 >"$file.tmp"
        mv -f "$file.tmp" "$file"
      ) ;;
    pick) friday_clips_pick ;;
    *) echo "Usage: friday clips [status|on|off|pick]" >&2; return 1 ;;
  esac
}

# `friday clipguard [watch|check]` (CTX-14, switch clipboard-clear): a
# password or key left on the clipboard is cleared after 2 minutes, clips on
# or off. `watch` (FRIDAY OS starts it at login) runs `check` on each
# clipboard change. A copy a password manager marks as sensitive, or one
# shaped like a password or token, starts a timer that keeps only its hash,
# in memory; if the clipboard still holds the same text 2 minutes later, it
# is cleared. Anything copied since is left alone.
friday_clipguard() {
  local text sum types
  case "${1:-watch}" in
    watch)
      command -v wl-paste >/dev/null 2>&1 || { echo "friday: clipguard needs wl-clipboard" >&2; return 1; }
      exec wl-paste --type text --watch "$0" clipguard check ;;
    check)
      text=$(head -c 20000)
      friday_feature_on clipboard-clear || return 0
      [ -n "${text//[[:space:]]/}" ] || return 0
      # (Read first: grep -q quitting early mustn't fail the pipe under pipefail.)
      types=$(timeout 2 wl-paste --list-types 2>/dev/null || true)
      if [ "${CLIPBOARD_STATE:-}" != sensitive ] && ! friday_secret_shaped "$text" \
        && ! grep -qi 'passwordmanagerhint' <<<"$types"; then
        return 0
      fi
      sum=$(printf '%s' "$text" | sha256sum | cut -d' ' -f1)
      text=""
      (
        sleep "${FRIDAY_CLIPGUARD_SECONDS:-120}"
        # Switched off meanwhile: leave it.
        friday_feature_on clipboard-clear || exit 0
        # Read and hashed the same way as above, so the sums compare.
        now=$(timeout 2 wl-paste --no-newline --type text 2>/dev/null || true)
        if [ -n "$now" ] && [ "$(printf '%s' "$now" | sha256sum | cut -d' ' -f1)" = "$sum" ]; then
          wl-copy --clear 2>/dev/null || true
        fi
      ) </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null || true ;;
    *) echo "Usage: friday clipguard [watch|check]" >&2; return 1 ;;
  esac
}

# How many seconds ago the clipboard text <text> was copied, from the clips
# log; nothing (status 1) when clips are off or don't have it as the newest.
friday_clip_age() {
  local clips="${XDG_STATE_HOME:-$HOME/.local/state}/friday/clips.jsonl" ts
  [ -s "$clips" ] || return 1
  ts=$(tail -n 1 "$clips" | jq -r --arg t "$1" 'select(.text == $t) | .ts' 2>/dev/null) || return 1
  [[ "$ts" =~ ^[0-9]+$ ]] || return 1
  echo $(( $(date +%s) - ts ))
}

# The Super+Ctrl+V picker: snippets first (type ;name), then clips, newest
# first. A snippet is pasted as it is; a clip can also be rewritten.
friday_clips_pick() {
  local clips="${XDG_STATE_HOME:-$HOME/.local/state}/friday/clips.jsonl"
  local snippets="${XDG_CONFIG_HOME:-$HOME/.config}/friday/snippets.jsonl" rows pick key text addr
  rows=$( { jq -r '";\(.name)  \(.text | gsub("\\s+"; " ") | .[0:80])"' "$snippets" 2>/dev/null || true
    tac "$clips" 2>/dev/null | jq -r '"\(input_line_number)  \(.text | gsub("\\s+"; " ") | .[0:80])"' 2>/dev/null || true; } )
  if [ -z "$rows" ]; then
    notify-send -a FRIDAY -- "FRIDAY" "No clips or snippets yet. friday clips on keeps what you copy; friday snippet add <name> saves a snippet." 2>/dev/null || true
    return 0
  fi
  addr=$(timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null || true)
  pick=$(printf '%s\n' "$rows" | fuzzel --dmenu --prompt="Clips › " --width=70 --lines=12 \
    --placeholder="type to search, ;name for a snippet") || return 0
  key="${pick%%  *}"
  if [[ "$key" == \;* ]]; then
    text=$(jq -r --arg n "${key#;}" 'select(.name == $n) | .text' "$snippets" 2>/dev/null | head -c 20000)
    [ -n "$text" ] && friday_replace_selection "$text" "$addr" terminals
    return 0
  fi
  [[ "$key" =~ ^[0-9]+$ ]] || return 0
  text=$(tac "$clips" 2>/dev/null | sed -n "${key}p" | jq -r '.text' 2>/dev/null)
  [ -n "$text" ] && friday_paste_as "$text"
}

# `friday snippet add <name> [text] | rm <name> | list`: text you paste often,
# by name (Super+Ctrl+V, then ;name). With no text, the clipboard's.
friday_snippet() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/snippets.jsonl" name="${2:-}" text
  case "${1:-list}" in
    add)
      [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "Usage: friday snippet add <name: letters, digits, - or _> [text]" >&2; return 1; }
      if [ $# -gt 2 ]; then text="${*:3}"; else text=$(timeout 2 wl-paste --no-newline 2>/dev/null || true); fi
      [ -n "${text//[[:space:]]/}" ] || { echo "No text: give it after the name, or copy it first." >&2; return 1; }
      mkdir -p "$(dirname "$file")"
      (
        umask 077
        { jq -c --arg n "$name" 'select(.name != $n)' "$file" 2>/dev/null || true
          jq -cn --arg n "$name" --arg t "$text" '{name: $n, text: $t}'; } >"$file.tmp"
        mv -f "$file.tmp" "$file"
      )
      echo "Saved ;$name. Super+Ctrl+V, then type ;$name." ;;
    rm)
      jq -e --arg n "$name" 'select(.name == $n)' "$file" >/dev/null 2>&1 || { echo "No snippet called $name." >&2; return 1; }
      (umask 077; jq -c --arg n "$name" 'select(.name != $n)' "$file" >"$file.tmp" && mv -f "$file.tmp" "$file")
      echo "Removed ;$name." ;;
    list)
      jq -r '";\(.name)  \(.text | gsub("\\s+"; " ") | .[0:60])"' "$file" 2>/dev/null | grep . || echo "No snippets yet. friday snippet add <name> [text]" ;;
    *) echo "Usage: friday snippet add <name> [text] | rm <name> | list" >&2; return 1 ;;
  esac
}

# Suggestions for the focused app, shown first in the Super+Y ask box:
# "<label>\t<ask flag>\t<question>" lines. Picking one asks in that mode,
# so the usual consent applies (a page is read only when you pick it).
friday_app_suggestions() {
  friday_feature_on suggestions || return 0
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local cls sel
  cls=$(timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty' 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
  [ -n "$cls" ] || return 0
  case "$cls" in
    *firefox*|*chromium*|*chrome*|*brave*|*librewolf*|zen|zen-*|*vivaldi*|*qutebrowser*|*zathura*|*okular*|*evince*|*papers*|*foliate*)
      printf 'Summarize this page\t--screen\tSummarize this page\n' ;;
    *thunderbird*|*geary*|*evolution*)
      printf 'Summarize this email\t--screen\tSummarize this email\n'
      printf 'Draft a reply\t--screen\tDraft a short reply to this email, in my voice, ready to paste\n' ;;
    *slack*|*discord*|*vesktop*|*telegram*|*signal*|*element*|*whatsapp*|*fractal*|*teams*)
      printf 'Draft a reply\t--screen\tDraft a short reply to the last message here, ready to paste\n'
      printf 'Catch me up\t--screen\tSummarize what this conversation is about and what is asked of me\n' ;;
  esac
  sel=$(timeout 1 wl-paste --primary --no-newline 2>/dev/null | head -c 200 || true)
  [ -n "${sel//[[:space:]]/}" ] || return 0
  case "$cls" in
    code|code-oss|*codium*|*zed*|jetbrains-*|*neovide*|*kate*|*texteditor*|*gedit*|*sublime*)
      printf 'Explain the selected code\t--selection\tExplain this code: what it does and anything wrong with it\n' ;;
    *) printf 'Explain the selected text\t--selection\tExplain this simply\n' ;;
  esac
}

# Windows whose text never goes to a cloud model: matched (case doesn't
# matter) against the focused window's app and title. Add your own, one per
# line, in ~/.config/friday/private-windows; "!bank" there drops a default.
FRIDAY_PRIVATE_WINDOWS="keepassxc
bitwarden
1password
enpass
proton pass
org.gnome.world.secrets
seahorse
private browsing
incognito
inprivate
bank
paypal"

# Mail and chat apps: their text is mostly someone else's words, so FRIDAY
# says where it goes before sending it (or answers with the local model).
# Add your own, one per line, in ~/.config/friday/sensitive-windows; "!slack"
# there drops a default.
FRIDAY_SENSITIVE_WINDOWS="thunderbird
evolution
geary
outlook
signal
telegram
discord
vesktop
slack
whatsapp
element
fractal
teams"

# friday_sensitive_window [window JSON]: the line that makes that window (or
# the one in front) a mail or chat app, or nothing. The built-in names match
# the app only ("element" in a page title is no chat app); your own lines
# match the app or the title.
friday_sensitive_window() {
  friday_feature_on sensitive-warn || return 0
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local win="${1:-}" app all pat src own="${XDG_CONFIG_HOME:-$HOME/.config}/friday/sensitive-windows" drop
  [ -n "$win" ] || win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  app=$(jq -r '.class // ""' <<<"$win" 2>/dev/null | tr '[:upper:]' '[:lower:]') || return 0
  all=$(jq -r '"\(.class // "") \(.title // "")"' <<<"$win" 2>/dev/null | tr '[:upper:]' '[:lower:]') || return 0
  drop=$(sed -n 's/^[[:space:]]*!//p' "$own" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
  while IFS=$'\t' read -r src pat; do
    pat=$(tr '[:upper:]' '[:lower:]' <<<"$pat" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -n "$pat" && "$pat" != \#* && "$pat" != !* ]] || continue
    grep -qxF -- "$pat" <<<"$drop" && continue
    if [ "$src" = own ]; then [[ "$all" == *"$pat"* ]] || continue
    else [[ "$app" == *"$pat"* ]] || continue; fi
    printf '%s' "$pat"; return 0
  done < <(sed 's/^/built-in\t/' <<<"$FRIDAY_SENSITIVE_WINDOWS"; sed 's/^/own\t/' "$own" 2>/dev/null || true)
}

# friday_private_window: what made the focused window private, or nothing.
# The last 20 dictations, kept on this computer so words typed into the
# wrong window can be had again (friday dictations). Never what was typed
# into a private window.
friday_dictations_file() { echo "${XDG_STATE_HOME:-$HOME/.local/state}/friday/dictations.jsonl"; }
friday_dictation_keep() { # <text> [the window where it started, as JSON]
  friday_feature_on dictation-history || return 0
  # Neither where it started nor where it goes may be a private window.
  [ -z "$(friday_private_window)" ] || return 0
  [ -z "${2:-}" ] || [ -z "$(friday_private_window "$2")" ] || return 0
  local f app line
  f=$(friday_dictations_file)
  app=$(timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty' 2>/dev/null || true)
  line=$(jq -cn --arg t "$1" --arg a "$app" --argjson ts "$(date +%s)" '{ts: $ts, app: $a, text: $t}') || return 0
  (
    umask 077
    mkdir -p "$(dirname "$f")"
    { cat "$f" 2>/dev/null || true; printf '%s\n' "$line"; } | tail -n 20 >"$f.tmp"
    mv -f "$f.tmp" "$f"
  )
}
# The kept dictations, newest first, one JSON array (a damaged line skipped,
# so the numbers shown are the numbers copy takes).
friday_dictations_newest() {
  tac "$(friday_dictations_file)" 2>/dev/null | jq -Rs '[split("\n")[] | fromjson? | select(type == "object" and (.text | type) == "string")]' 2>/dev/null || echo '[]'
}
friday_dictations() { # [list | copy [n] | clear]
  local f n text all
  f=$(friday_dictations_file)
  case "${1:-list}" in
    list)
      friday_feature_on dictation-history || { echo "Dictation history is turned off (friday feature dictation-history on)."; return 0; }
      all=$(friday_dictations_newest)
      [ "$(jq length <<<"$all")" -gt 0 ] || { echo "No dictations kept yet. Voice typing (Super+Shift+Y) keeps the last 20 here."; return 0; }
      jq -r 'to_entries[] | "\(.key + 1)  \(.value.ts // 0 | strflocaltime("%H:%M on %d %b"))  \(if (.value.app // "") == "" then "" else "[\(.value.app)] " end)\(.value.text | gsub("\\s+"; " ") | .[0:90])"' <<<"$all"
      echo "friday dictations copy <n> puts one on the clipboard." ;;
    copy)
      n="${2:-1}"
      [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] || { echo "usage: friday dictations copy <n>   (numbers are in: friday dictations)" >&2; return 2; }
      text=$(friday_dictations_newest | jq -r --argjson n "$n" '.[$n - 1].text // empty')
      [ -n "$text" ] || { echo "There's no dictation $n." >&2; return 1; }
      printf '%s' "$text" | wl-copy 2>/dev/null || { echo "Couldn't reach the clipboard (wl-copy)." >&2; return 1; }
      echo "Dictation $n is on the clipboard: paste it with Ctrl+V." ;;
    clear) rm -f "$f"; echo "Forgot every kept dictation." ;;
    *) echo "Usage: friday dictations [list | copy [n] | clear]" >&2; return 2 ;;
  esac
}

friday_private_window() { # [window JSON, else the one in front now]
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local win="${1:-}" hay pat own="${XDG_CONFIG_HOME:-$HOME/.config}/friday/private-windows" drop never
  [ -n "$win" ] || win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  hay=$(jq -r '"\(.class // "") \(.title // "")"' <<<"$win" 2>/dev/null | tr '[:upper:]' '[:lower:]') || return 0
  drop=$(sed -n 's/^[[:space:]]*!//p' "$own" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
  while IFS= read -r pat; do
    pat=$(tr '[:upper:]' '[:lower:]' <<<"$pat" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -n "$pat" && "$pat" != \#* && "$pat" != !* ]] || continue
    never=""
    if [[ "$pat" == "never "* ]]; then never="never:"; pat="${pat#never }"; pat="${pat#"${pat%%[![:space:]]*}"}"; fi
    # Folder lines are about commands (friday_private_folder), not windows.
    [[ -n "$pat" && "$pat" != /* && "$pat" != "~/"* ]] || continue
    grep -qxF -- "$pat" <<<"$drop" && continue
    if [[ "$hay" == *"$pat"* ]]; then printf '%s%s' "$never" "$pat"; return 0; fi
  done < <(cat "$own" 2>/dev/null | grep -i '^[[:space:]]*never ' || true; printf '%s\n' "$FRIDAY_PRIVATE_WINDOWS"; cat "$own" 2>/dev/null || true)
}

# friday_private_folder <folder>: the private-windows line (a folder: /… or
# ~/…) that folder is in, or nothing. Commands run there are private.
friday_private_folder() {
  local dir="${1%/}" own="${XDG_CONFIG_HOME:-$HOME/.config}/friday/private-windows" line path never real
  [ -n "$1" ] || return 0
  while IFS= read -r line; do
    line=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' <<<"$line")
    never=""
    if [[ "$line" == "never "* ]]; then never="never:"; line=$(sed 's/^never[[:space:]]*//' <<<"$line"); fi
    case "$line" in /*|"~/"*) ;; *) continue ;; esac
    path="${line/#\~/$HOME}"; path="${path%/}"
    # "/" alone: every folder. A listed folder that's a symlink counts as
    # where it leads too.
    real=$(realpath -m -- "${path:-/}" 2>/dev/null || echo "$path"); real="${real%/}"
    if [ -z "$path" ] || [ "$dir" = "$path" ] || [[ "$dir" == "$path"/* ]] \
        || [ "$dir" = "$real" ] || [[ "$dir" == "$real"/* ]]; then printf '%s%s' "$never" "$line"; return 0; fi
  done < <(cat "$own" 2>/dev/null || true)
}

# "What changed …": since when (since <a day or date>, today, yesterday,
# this week, the last hour, else since the last answer, else a day), then
# the project's commits and uncommitted files (when $2 is a git folder not
# in a private folder) and packages installed, upgraded or removed, as plain
# lines. Nothing when nothing changed.
friday_what_changed() {
  local q="${1,,}" project="$2" since="" iso epoch out="" log commits files pkgs rest
  if [[ "$q" =~ \ since\ (.+)$ ]]; then
    rest="${BASH_REMATCH[1]%%[?.!]*}"
    case "$rest" in
      monday|tuesday|wednesday|thursday|friday|saturday|sunday) since="last $rest 00:00" ;;
      *"last ask"*|*"last answer"*|*"i asked"*) ;;
      *) date -d "$rest" >/dev/null 2>&1 && since="$rest" ;;
    esac
  fi
  if [ -z "$since" ]; then
    case "$q" in
      *"last hour"*|*"past hour"*) since="1 hour ago" ;;
      *today*|*"this morning"*) since="today 00:00" ;;
      *yesterday*) since="yesterday 00:00" ;;
      *week*) since="7 days ago" ;;
      *)
        log="${XDG_STATE_HOME:-$HOME/.local/state}/friday/last-answer.md"
        if [ -f "$log" ]; then since="@$(stat -c %Y "$log")"; else since="1 day ago"; fi ;;
    esac
  fi
  epoch=$(date -d "$since" +%s 2>/dev/null) || return 0
  iso=$(date -d "@$epoch" '+%Y-%m-%dT%H:%M:%S')
  if [ -n "$project" ] && [ -z "$(friday_private_folder "$project")" ] \
      && git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
    commits=$(timeout 3 git -C "$project" log --since="@$epoch" --format='%h %ad %s' --date=format:'%a %H:%M' -n 30 2>/dev/null || true)
    files=$(timeout 3 git -C "$project" status --short 2>/dev/null | head -n 30 || true)
    out+="Project $(basename -- "$project"), commits since $iso:"$'\n'"${commits:-(none)}"$'\n'
    [ -z "$files" ] || out+="Not committed yet:"$'\n'"$files"$'\n'
  fi
  # pacman.log stamps carry their own offset: compared as moments, not text.
  pkgs=$(gawk -v t="$epoch" '$2 == "[ALPM]" && $3 ~ /^(installed|upgraded|removed|downgraded)$/ {
      if (!match($1, /^\[([0-9]+)-([0-9]+)-([0-9]+)T([0-9]+):([0-9]+):([0-9]+)([+-])([0-9][0-9])([0-9][0-9])\]$/, m)) next
      at = mktime(m[1] " " m[2] " " m[3] " " m[4] " " m[5] " " m[6], 1) - (m[7] "1") * (m[8] * 3600 + m[9] * 60)
      if (at < t) next
      sub(/^\[[^]]*\] \[ALPM\] /, ""); print }' \
    "${FRIDAY_PACMAN_LOG:-/var/log/pacman.log}" 2>/dev/null | tail -n 40 || true)
  [ -z "$pkgs" ] || out+="Packages since $iso:"$'\n'"$pkgs"$'\n'
  printf '%s' "$out"
}

# What this computer runs, in a line or two: distro, kernel, desktop, and the
# installed version of each package the question names (at most 3).
friday_machine_facts() {
  local q="${1,,}" distro kernel desk="" w pkgs="" n=0 v
  distro=$(sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null | head -n1 || true)
  kernel=$(uname -r 2>/dev/null || true)
  # The desktop that's running (its socket), not whichever is installed.
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    desk=$(timeout 1 hyprctl version 2>/dev/null | grep -m1 -oE '^Hyprland [0-9.]+' || true)
  elif [ -n "${NIRI_SOCKET:-}" ]; then
    desk=$(timeout 1 niri --version 2>/dev/null | grep -m1 -oE '^niri [0-9.]+' || true)
  fi
  if command -v pacman >/dev/null 2>&1; then
    for w in $(grep -oE '[a-z0-9][a-z0-9.+_-]{2,}' <<<"$q" | sort -u | head -n 12); do
      v=$(timeout 1 pacman -Q -- "$w" 2>/dev/null) && [ -n "$v" ] || continue
      pkgs+="${pkgs:+, }$v"; n=$((n + 1)); [ "$n" -lt 3 ] || break
    done
  fi
  printf '%s' "${distro:+$distro; }${kernel:+kernel $kernel; }${desk:+$desk; }${pkgs:+installed: $pkgs}" | sed 's/; *$//'
}

# Whether a local model on this computer is set up (friday setup-ai local),
# not whether it's up.
friday_local_ready() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" base
  base=$(sed -n 's/^LLAMACPP_BASE_URL=//p' "$env_file" 2>/dev/null | tail -n1) || base=""
  grep -qx 'LLAMACPP_ENABLED=1' "$env_file" 2>/dev/null && [[ "$base" != *@* ]] \
    && [[ "$base" == http://127.0.0.1:* || "$base" == http://localhost:* ]]
}

# friday_ask_local <prompt> [seconds]: the local model's answer, asked
# directly on this computer (not through the daemon, so nothing can fall back
# to the cloud). Fails when no local model is set up, or after <seconds>
# (180 by default).
friday_ask_local() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" base model body
  grep -qx 'LLAMACPP_ENABLED=1' "$env_file" 2>/dev/null || return 2
  base=$(sed -n 's/^LLAMACPP_BASE_URL=//p' "$env_file" | tail -n1)
  model=$(sed -n 's/^LLAMACPP_MODEL=//p' "$env_file" | tail -n1)
  [[ "$base" != *@* ]] && [[ "$base" == http://127.0.0.1:* || "$base" == http://localhost:* ]] || return 2
  body=$(jq -nc --arg m "$model" --arg p "$1" '{model: $m, messages: [{role: "user", content: $p}]}')
  timeout "${2:-180}" curl -s -H 'Content-Type: application/json' -d "$body" "$base/chat/completions" 2>/dev/null \
    | jq -er '.choices[0].message.content | select(. != null and . != "")' 2>/dev/null
}

# Whether a question is short and general enough for the local model: a
# question of up to 14 words that names nothing on this computer, nothing
# current and no action ("who wrote Dune", "what is a monad"). The rest goes
# to the daemon, which can look things up.
friday_easy_ask() {
  local q=" ${1,,} " general='^ (what|who|whose|which|when|where|why|how|define|meaning|translate|is|are|was|were|does|do|did|can) ' mine
  mine="[^a-z](my|me|mine|i|i'm|i've|we|our|us|you|your|this|that|these|here|computer|laptop|pc|system|file|files|folder|disk|drive|battery|wifi|bluetooth|network|ip|gateway|dns|hostname|port|cpu|gpu|ram|memory|usage|temperature|fan|kernel|driver|log|logs|process|service|package|packages|window|screen|app|apps|tab|open|close|install|installed|uninstall|run|running|start|stop|restart|reboot|shutdown|mute|kill|delete|remove|set|turn|play|send|update|remind|today|tonight|now|latest|news|weather|price|current|currently|yesterday|tomorrow)[^a-z]"
  [ "$(wc -w <<<"$1")" -le 14 ] && [[ "$q" =~ $general ]] && ! [[ "$q" =~ $mine ]] && [[ "$1" != *[\`{}\<\>/]* ]]
}

# What works right now, in a few quick looks (a second or so in all):
# "online" (unless NetworkManager says there's no network at all or, without
# it, there's no default route: a VPN or a captive portal still counts) and
# "local" (a local model answers). One word a line, only for those that are.
# Shared by a failed ask's message and friday doctor.
friday_what_works() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env" base nm
  nm=$(timeout 1 nmcli -t networking connectivity 2>/dev/null) || nm=""
  case "$nm" in
    none) ;;
    full|limited|portal) echo online ;;
    *) [ -n "$(timeout 1 ip route show default 2>/dev/null)" ] && echo online ;;
  esac
  base=$(sed -n 's/^LLAMACPP_BASE_URL=//p' "$env_file" 2>/dev/null | tail -n1) || base=""
  if grep -qx 'LLAMACPP_ENABLED=1' "$env_file" 2>/dev/null && [[ "$base" != *@* ]] \
      && [[ "$base" == http://127.0.0.1:* || "$base" == http://localhost:* ]] \
      && timeout 1 curl -fs --noproxy '*' "$base/models" >/dev/null 2>&1; then
    echo local
  fi
  return 0
}

# The sentence a failed ask adds: what's down, and what still works.
friday_what_still_works() {
  local works
  works=$(friday_what_works)
  if ! grep -qx online <<<"$works"; then
    if grep -qx local <<<"$works"; then
      echo "You're offline: your local model still answers (friday private on keeps every ask there), and window, app and routine commands still work."
    else
      echo "You're offline, and no local model is set up, so nothing can answer. Window, app and routine commands still work; friday setup-ai local adds a model that works offline."
    fi
  fi
}

# The app and window title the selected text came from, as one line for the
# model ("" when off, or when Hyprland can't say). Called before the ask box
# opens, while that window still has focus. `friday app-context off` stops it.
# `friday app-instructions [list | set <app> <instruction> | rm <app>]`: how
# FRIDAY should answer in an app ("kitty: answer with commands only"), one
# "app: instruction" per line in app-instructions in FRIDAY's config folder.
# The app is matched against the focused window's class.
friday_app_instructions_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/friday/app-instructions"; }
friday_app_instructions_same() { # <a> <b>: the same app (any case, .exe or not, or a reverse-DNS id's last part)
  local a="${1,,}" b="${2,,}"
  a="${a%.exe}"; b="${b%.exe}"
  [ -n "$a" ] && [ -n "$b" ] && { [ "$a" = "$b" ] || [ "${a##*.}" = "$b" ] || [ "$a" = "${b##*.}" ]; }
}
friday_app_instructions() { # <app class>: its instruction, if any
  local app="$1" line name f
  f=$(friday_app_instructions_file)
  [ -n "$app" ] && [ -f "$f" ] || return 1
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    name="${line%%:*}"; name="${name//[[:space:]]/}"
    friday_app_instructions_same "$app" "$name" && { sed 's/^[^:]*:[[:space:]]*//' <<<"$line" | cut -c1-300; return 0; }
  done <"$f"
  return 1
}
friday_app_instructions_drop() { # <file> <app>: the file without that app's line
  local line name
  [ -f "$1" ] || return 0
  while IFS= read -r line; do
    name="${line%%:*}"; name="${name//[[:space:]]/}"
    [[ "$line" != *:* || "$line" =~ ^[[:space:]]*# ]] || ! friday_app_instructions_same "$name" "$2" || continue
    printf '%s\n' "$line"
  done <"$1"
}
friday_app_instructions_cmd() {
  local f; f=$(friday_app_instructions_file)
  case "${1:-list}" in
    list) if [ -s "$f" ] && grep -q '^[[:space:]]*[^#[:space:]]' "$f"; then grep -v '^[[:space:]]*#' "$f" || true
          else echo "No app instructions yet. Add one: friday app-instructions set kitty \"answer with commands only\""; fi ;;
    set|rm)
      [ -n "${2:-}" ] && { [ "$1" = rm ] || [ -n "${3:-}" ]; } || { echo "Usage: friday app-instructions set <app> <instruction> | rm <app>" >&2; return 1; }
      [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "friday: an app is named like its window class (kitty, firefox, org.gnome.Nautilus)" >&2; return 1; }
      mkdir -p "$(dirname "$f")"
      if [ "$1" = set ]; then
        { friday_app_instructions_drop "$f" "$2"; printf '%s: %s\n' "$2" "$(tr '\n\r' '  ' <<<"${*:3}" | sed 's/[[:space:]]*$//')"; } >"$f.tmp" && mv -f "$f.tmp" "$f"
        echo "In $2, FRIDAY will: ${*:3}"
      else
        [ ! -f "$f" ] || { friday_app_instructions_drop "$f" "$2" >"$f.tmp" && mv -f "$f.tmp" "$f"; }
        echo "No instructions for $2 now."
      fi ;;
    *) echo "Usage: friday app-instructions [list|set <app> <instruction>|rm <app>]" >&2; return 1 ;;
  esac
}

friday_app_context() {
  [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/friday/no-app-context" ] || return 0
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local win cls title
  win=$(timeout 2 hyprctl activewindow -j 2>/dev/null) || return 0
  cls=$(jq -r '.class // empty' <<<"$win" 2>/dev/null) || return 0
  [ -n "$cls" ] || return 0
  title=$(jq -r '.title // empty' <<<"$win" 2>/dev/null | tr -d '"\n' | cut -c1-120)
  if [ -n "$title" ]; then
    printf 'The text came from the app "%s" (window title: "%s").' "$cls" "$title"
  else
    printf 'The text came from the app "%s".' "$cls"
  fi
}

friday_app_context_cmd() {
  local flag="${XDG_CONFIG_HOME:-$HOME/.config}/friday/no-app-context"
  case "${1:-status}" in
    on)  rm -f "$flag"; echo "On: a question about selected text says which app it came from (name and window title)." ;;
    off) mkdir -p "$(dirname "$flag")" && : >"$flag"; echo "Off: selected text is sent without the app name or window title." ;;
    status)
      if [ -e "$flag" ]; then echo "Off: selected text is sent without the app name or window title."
      else echo "On: a question about selected text says which app it came from (name and window title). Turn off: friday app-context off"; fi ;;
    *) echo "usage: friday app-context [on|off|status]" >&2; return 2 ;;
  esac
}

# What FRIDAY keeps on this computer, and a way to wipe it. Counts only: the
# contents are never printed here.
friday_forget() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  local mem_dir=""
  [ -r "$env_file" ] && mem_dir=$(sed -n 's/^FRIDAY_MEMORY_DIR=//p' "$env_file" | tail -n 1 | tr -d '"'"'")
  if [ -z "$mem_dir" ]; then
    mem_dir="$state_dir/memory"
    [ -e "$mem_dir/episodes.jsonl" ] || ! [ -e "$HOME/friday-data/episodes.jsonl" ] || mem_dir="$HOME/friday-data"
  fi
  local what="" yes=false arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=true ;;
      answers|sent|memory|actions|all) what="$arg" ;;
      *) echo "usage: friday forget [answers|sent|memory|actions|all] [--yes]" >&2; return 2 ;;
    esac
  done
  local n_answers n_asks n_sent n_mem n_actions
  n_actions=$(wc -l 2>/dev/null <"$state_dir/actions.jsonl" || true)
  n_answers=$(cat "$state_dir/answers.1.md" "$state_dir/answers.md" 2>/dev/null | grep -c '^<!-- friday answer -->' || true)
  n_asks=$(wc -l 2>/dev/null <"$state_dir/ask-history" || true)
  n_sent=$(wc -l 2>/dev/null <"$state_dir/egress.jsonl" || true)
  n_mem=$(wc -l 2>/dev/null <"$mem_dir/episodes.jsonl" || true)
  if [ -z "$what" ]; then
    echo "FRIDAY keeps this on your computer:"
    echo "  answers  ${n_answers:-0} saved answers, ${n_asks:-0} remembered questions, day summaries   ($state_dir)"
    echo "  sent     ${n_sent:-0} entries in the log of what was sent to AI providers"
    echo "  memory   ${n_mem:-0} things FRIDAY remembered between questions   ($mem_dir),"
    echo "           and the current conversation's last few turns"
    echo "  actions  ${n_actions:-0} things FRIDAY did on your desktop (friday actions)"
    echo "Wipe some:  friday forget answers|sent|memory|actions|all   (add --yes to skip the question)"
    return 0
  fi
  if ! $yes; then
    if [ ! -t 0 ]; then echo "Say yes with --yes: friday forget $what --yes" >&2; return 2; fi
    local reply
    read -r -p "Delete FRIDAY's $what? This can't be undone. [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Nothing deleted."; return 0; }
  fi
  if [ "$what" = answers ] || [ "$what" = all ]; then
    rm -f "$state_dir/answers.md" "$state_dir/answers.1.md" "$state_dir/answers.lock" "$state_dir/last-answer.md" "$state_dir/last-memories" "$state_dir/ask-history"
    rm -rf "$state_dir/days"
    echo "Deleted ${n_answers:-0} saved answers and ${n_asks:-0} remembered questions."
  fi
  if [ "$what" = sent ] || [ "$what" = all ]; then
    rm -f "$state_dir/egress.jsonl"
    echo "Deleted ${n_sent:-0} entries from the log of what was sent."
  fi
  if [ "$what" = actions ] || [ "$what" = all ]; then
    rm -f "$state_dir/actions.jsonl"
    echo "Deleted ${n_actions:-0} entries from the log of desktop actions."
  fi
  if [ "$what" = memory ] || [ "$what" = all ]; then
    # The daemon holds the journal open, so it stops while it is deleted.
    local was_up=false
    if systemctl --user is-active --quiet friday-linux-daemon 2>/dev/null; then
      was_up=true; systemctl --user stop friday-linux-daemon 2>/dev/null || true
    fi
    rm -f "$mem_dir/episodes.jsonl" "$state_dir/conversations.json" "$state_dir/conversation" "$state_dir/lessons.jsonl" "$state_dir/thoughts.jsonl" "$state_dir/dictations.jsonl" \
      "$(friday_memory_file)"
    if $was_up; then systemctl --user start friday-linux-daemon 2>/dev/null || true; fi
    echo "Deleted ${n_mem:-0} remembered things."
  fi
  return 0
}

# memory.md: what you asked FRIDAY to remember, one "- " line each; every
# ask carries it. `friday memory [list|edit|forget <words>|import <file> [--apply]]`.
friday_memory_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/friday/memory.md"; }
friday_memory() {
  local f; f=$(friday_memory_file)
  case "${1:-list}" in
    list)
      if ! grep -q '^- ' "$f" 2>/dev/null; then
        echo "FRIDAY remembers nothing about you yet. Say \"remember that I use fish\" (or: friday memory edit)."
        return 0
      fi
      echo "What FRIDAY remembers about you ($f; every ask carries it):"
      grep '^- ' "$f"
      # What stopped being true (a newer fact replaced it): kept, never sent.
      if grep -q '^## No longer true' "$f"; then echo; echo "No longer true:"; sed -n '/^## No longer true/,$p' "$f" | grep '^\* ' | sed 's/^\* /  /'; fi ;;
    edit)
      mkdir -p "$(dirname "$f")"
      [ -s "$f" ] || printf '# What FRIDAY remembers about you. Edit freely: one "- " line each.\n' >"$f"
      "${VISUAL:-${EDITOR:-nano}}" "$f" ;;
    forget)
      local words="${*:2}" n
      [ -n "$words" ] || { echo "usage: friday memory forget <words in the line>" >&2; return 2; }
      # Only its "- " lines: headings and notes in the file are yours.
      n=$(awk -v w="${words,,}" '/^- / && index(tolower($0), w) { n++ } END { print n + 0 }' "$f" 2>/dev/null || echo 0)
      if [ "${n:-0}" -gt 0 ]; then
        awk -v w="${words,,}" '!(/^- / && index(tolower($0), w))' "$f" >"$f.tmp" && mv -f "$f.tmp" "$f"
        echo "Forgot $n line(s) with \"$words\"."
      else
        echo "No line of $f has \"$words\"."
      fi
      # And every copy of it: the journal, conversations, day summaries,
      # screen recall, answers. The daemon holds some of them, so it stops
      # while they change.
      friday_feature_on forget-everywhere || { [ "${n:-0}" -gt 0 ]; return; }
      local was_up=false
      if systemctl --user is-active --quiet friday-linux-daemon 2>/dev/null; then
        was_up=true; systemctl --user stop friday-linux-daemon 2>/dev/null || true
      fi
      friday-ctl forget-everywhere --daemon-stopped "$words" || true
      if $was_up; then systemctl --user start friday-linux-daemon 2>/dev/null || true; fi ;;
    import)
      # Another assistant's notes (a CLAUDE.md, an exported memory list):
      # a preview of what would be added, then --apply adds it.
      [ -n "${2:-}" ] || { echo "usage: friday memory import <file> [--apply]" >&2; return 2; }
      friday-ctl memory import "${@:2}" ;;
    tidy)
      # Fuller than an ask carries: your AI provider proposes a shorter list;
      # `friday memory tidy apply` puts exactly that in place.
      friday-ctl memory tidy "${@:2}" ;;
    used)
      local mem_file="${XDG_STATE_HOME:-$HOME/.local/state}/friday/last-memories"
      case "${2:-list}" in
        list|"")
          if [ ! -s "$mem_file" ]; then
            echo "No remembered facts were used in the last answer."
            return 0
          fi
          awk '{ print NR ". " $0 }' "$mem_file"
          ;;
        forget)
          local n="${3:-}"
          [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] || { echo "usage: friday memory used forget <n>" >&2; return 2; }
          [ -s "$mem_file" ] || { echo "No remembered facts were used in the last answer." >&2; return 1; }
          local fact
          fact=$(sed -n "${n}p" "$mem_file")
          [ -n "$fact" ] || { echo "No memory numbered $n in the last answer." >&2; return 1; }
          # The card names the fact too: a list that moved since (a quick
          # second click) forgets nothing.
          if [ -n "${4:-}" ] && [ "$fact" != "$4" ]; then
            echo "The list changed; nothing forgotten." >&2; return 1
          fi
          # Exactly that fact's line: "forget" by words could take others with it.
          local f; f=$(friday_memory_file)
          # Through the environment: awk -v would turn backslashes into escapes.
          if L="- $fact" awk '$0 == ENVIRON["L"] { n++ } END { exit !n }' "$f" 2>/dev/null; then
            L="- $fact" awk '$0 != ENVIRON["L"]' "$f" >"$f.tmp" && mv -f "$f.tmp" "$f"
            echo "Forgot: $fact"
          else
            echo "\"$fact\" isn't in $f any more."
          fi
          sed "${n}d" "$mem_file" >"$mem_file.tmp" && mv -f "$mem_file.tmp" "$mem_file"
          chmod 0600 "$mem_file" 2>/dev/null || true
          ;;
        *) echo "usage: friday memory used [forget <n> [the fact]]" >&2; return 2 ;;
      esac
      ;;
    *) echo "Usage: friday memory [list|edit|forget <words>|import <file> [--apply]|tidy [apply]|used [forget <n>]]" >&2; return 2 ;;
  esac
}

# What FRIDAY did on your desktop (actions.jsonl), newest last. Which
# action, with what, whether it worked: never what was on your screen.
friday_actions() {
  local n="${1:-20}"
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/friday/actions.jsonl"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "usage: friday actions [N]" >&2; return 2; }
  if [ ! -s "$f" ]; then
    echo "FRIDAY hasn't done anything on your desktop yet."
    echo "Try: friday ask \"put firefox on workspace 2\""
    return 0
  fi
  tail -n "$n" "$f" | jq -r '[(.ts | sub("\\.[0-9]+"; "") | sub("T"; " ") | sub("Z"; "")),
    (if .ok then "ok    " else "failed" end), .verb, (.params | tojson), "(" + .risk + ")"] | join("  ")' 2>/dev/null \
    || tail -n "$n" "$f"
}

# Standing tasks ("every morning at 8 tell me the weather"): the file the
# daemon runs them from. Made by asking; managed here.
friday_tasks() {
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/friday/standing.json"
  local cmd="${1:-list}" id="${2:-}"
  case "$cmd" in
    list|--json)
      if [ "$cmd" = "--json" ]; then
        [ -s "$f" ] && jq -c '.tasks // []' "$f" 2>/dev/null || echo '[]'
        return 0
      fi
      if [ ! -s "$f" ] || [ "$(jq '.tasks | length' "$f" 2>/dev/null || echo 0)" = 0 ]; then
        echo "No standing tasks yet."
        echo "Try: friday ask \"every morning at 8 tell me the weather\""
        return 0
      fi
      jq -r '.tasks[] | [.id,
        (if .trigger.kind == "daily" then
           "every " + (if .trigger.weekdays_only then "weekday" else "day" end) + " at " +
           ("0" + (.trigger.hour | tostring))[-2:] + ":" + ("0" + (.trigger.minute | tostring))[-2:]
         elif .trigger.kind == "every" then
           (if .trigger.minutes % 60 == 0 then "every " + ((.trigger.minutes / 60) | tostring) + " h"
            else "every " + (.trigger.minutes | tostring) + " min" end)
         elif .trigger.kind == "once" then "once at " + (.trigger.at | localtime | strftime("%H:%M on %d %b"))
         elif .trigger.kind == "download_done" then "when a download finishes"
         elif .trigger.kind == "file_changed" then "when " + .trigger.path + " changes"
         elif .trigger.kind == "app_opens" then "when " + .trigger.app + " opens"
         else "battery under " + (.trigger.percent | tostring) + "%" end),
        .goal, (if .paused then "(paused)" else "" end)] | join("  ")' "$f" 2>/dev/null \
        | sed 's/[[:space:]]*$//' \
        || { echo "FRIDAY couldn't read $f" >&2; return 1; }
      ;;
    status|on|off)
      friday_switch FRIDAY_STANDING_TASKS "Standing tasks" tasks \
        "FRIDAY can run what you ask to repeat, each with the usual rules" \
        "nothing repeats and no new ones can be made" "$cmd" ;;
    quiet|limit)
      # Quiet hours (recurring tasks wait them out) and the most runs a day.
      local edit tmp="$f.tmp.$$"
      if [ "$cmd" = quiet ]; then
        case "${id:-status}" in
          off) edit='del(.quiet)' ;;
          status)
            jq -r 'if .quiet then "Quiet hours: \(.quiet[0]):00 to \(.quiet[1]):00 (repeating tasks wait; reminders still come). Off: friday tasks quiet off"
                   else "Quiet hours: off. On: friday tasks quiet 22-7" end' "$f" 2>/dev/null || echo "Quiet hours: off. On: friday tasks quiet 22-7"
            return 0 ;;
          *) [[ "$id" =~ ^([0-9]{1,2})-([0-9]{1,2})$ ]] && (( 10#${BASH_REMATCH[1]} < 24 && 10#${BASH_REMATCH[2]} < 24 )) \
               || { echo "usage: friday tasks quiet <from>-<to> (hours, like 22-7) | off" >&2; return 2; }
             edit=".quiet = [$((10#${BASH_REMATCH[1]})), $((10#${BASH_REMATCH[2]}))]" ;;
        esac
      else
        [[ "$id" =~ ^[0-9]+$ ]] && [ "$id" -ge 1 ] || { echo "usage: friday tasks limit <runs a day>" >&2; return 2; }
        edit=".daily_cap = $id"
      fi
      [ -s "$f" ] || { mkdir -p "$(dirname "$f")"; echo '{"tasks":[]}' >"$f"; }
      ( umask 077; jq "$edit" "$f" >"$tmp" ) && mv -f "$tmp" "$f" \
        || { rm -f "$tmp"; echo "FRIDAY couldn't change $f" >&2; return 1; }
      if [ "$cmd" = quiet ]; then
        friday_tasks quiet status
        # A daily task timed inside them would never run: say which.
        jq -r 'select(.quiet) | .quiet as [$a, $b] | .tasks[]
          | select(.trigger.kind == "daily")
          | select(if $a <= $b then (.trigger.hour >= $a and .trigger.hour < $b)
                   else (.trigger.hour >= $a or .trigger.hour < $b) end)
          | "Note: \(.id) (\(.goal)) is set for \(.trigger.hour):\(("0" + (.trigger.minute | tostring))[-2:]), inside the quiet hours, so it won'"'"'t run while they last."' "$f" 2>/dev/null || true
      else
        echo "At most $id task runs a day."
      fi
      ;;
    pause|resume|delete)
      [[ "$id" =~ ^t[0-9]+$ ]] || { echo "usage: friday tasks $cmd <id>   (ids are in: friday tasks)" >&2; return 2; }
      [ -s "$f" ] && jq -e --arg id "$id" '.tasks | any(.id == $id)' "$f" >/dev/null 2>&1 \
        || { echo "No standing task $id. See: friday tasks" >&2; return 1; }
      local edit
      case "$cmd" in
        pause)  edit='.tasks |= map(if .id == $id then .paused = true else . end)' ;;
        resume) edit='.tasks |= map(if .id == $id then .paused = false else . end)' ;;
        delete) edit='.tasks |= map(select(.id != $id))' ;;
      esac
      local tmp="$f.tmp.$$"
      ( umask 077; jq --arg id "$id" "$edit" "$f" >"$tmp" ) && mv -f "$tmp" "$f" \
        || { rm -f "$tmp"; echo "FRIDAY couldn't change $f" >&2; return 1; }
      echo "Standing task $id: $cmd done."
      ;;
    recipes|recipe)
      # Ready-made standing tasks: a list, or one added by name.
      friday_feature_on task-recipes || { echo "Task recipes are turned off (friday feature task-recipes on)."; return 0; }
      exec friday-ctl tasks "$cmd" ${id:+"$id"}
      ;;
    *)
      echo "usage: friday tasks [list|--json|pause <id>|resume <id>|delete <id>|recipes|recipe <name>|status|on|off]" >&2
      return 2
      ;;
  esac
}

# Coding agents FRIDAY runs for you (opencode, agy): what each run did, and
# your answer to a step that waits for you. Started by asking ("have opencode
# add a README to ~/code/site").
friday_agents() {
  local d="${XDG_STATE_HOME:-$HOME/.local/state}/friday/agents"
  local cmd="${1:-list}" id="${2:-}"
  case "$cmd" in
    list)
      local runs
      runs=$(ls -t "$d"/r*.json 2>/dev/null | head -n 10 || true)
      if [ -z "$runs" ]; then
        echo "No agent runs yet."
        echo "Try: friday ask \"have opencode add a README to ~/code/site\""
        return 0
      fi
      local f
      for f in $runs; do
        jq -r '[.id, .agent, .folder,
          (if .status == "waiting_for_you" then "WAITING FOR YOU: " + .pending.step + " (" + .pending.why + ")"
           else .status end)] | join("  ")' "$f" 2>/dev/null
      done
      if [ -s "$d/hooks.jsonl" ]; then
        local today approved
        today=$(date -u +%s); today=$((today - 86400))
        approved=$(jq -s --argjson t "$today" '[.[] | select(.ts >= $t and .decision == "approved")] | length' "$d/hooks.jsonl" 2>/dev/null || echo 0)
        echo
        echo "In your own agent sessions, FRIDAY approved $approved routine step(s) in the last day."
      fi
      if grep -ls '"waiting_for_you"' $runs >/dev/null 2>&1; then
        echo
        echo "Answer a step with: friday agents allow <id>   or   friday agents deny <id>"
        echo "Answer a question with: friday agents reply <id> \"your answer\""
      fi
      ;;
    show)
      [[ "$id" =~ ^r[0-9a-f]+$ ]] && [ -f "$d/$id.json" ] \
        || { echo "usage: friday agents show <id>   (ids are in: friday agents)" >&2; return 2; }
      jq -r '"\(.agent) in \(.folder): \(.status)",
        "You asked: \(.request)",
        "FRIDAY approved \(.approved_by_friday) step(s), you approved \(.approved_by_you), \(.rejected) rejected.",
        "", (.summary // "")' "$d/$id.json"
      if [ -s "$d/$id.jsonl" ]; then
        echo
        echo "What happened:"
        jq -r 'if .event == "approved" then "  approved by \(.by): \(.step)"
          elif .event == "rejected" then "  rejected: \(.step) (\(.why // ""))"
          elif .event == "asked_you" then "  asked you: \(.step)"
          elif .event == "answered" then "  \(if .by == "you" then "You" else "FRIDAY" end) answered the agent: \(.text)"
          elif .event == "step_done" then "  done: \(.step)"
          elif .event == "step_failed" then "  failed: \(.step)"
          else empty end' "$d/$id.jsonl" 2>/dev/null | tail -n 40
      fi
      ;;
    allow|deny)
      [[ "$id" =~ ^r[0-9a-f]+$ ]] && [ -f "$d/$id.json" ] \
        || { echo "usage: friday agents $cmd <id>   (ids are in: friday agents)" >&2; return 2; }
      jq -e '.status == "waiting_for_you"' "$d/$id.json" >/dev/null 2>&1 \
        || { echo "Run $id isn't waiting for you." >&2; return 1; }
      printf '%s' "$cmd" >"$d/$id.answer"
      echo "Told run $id: $cmd."
      ;;
    hooks)
      # Your own Claude Code sessions: FRIDAY approves the routine steps there too.
      friday-ctl agent-hooks "${id:-status}"
      ;;
    reply)
      local text="${*:3}"
      [[ "$id" =~ ^r[0-9a-f]+$ ]] && [ -f "$d/$id.json" ] && [ -n "$text" ] \
        || { echo "usage: friday agents reply <id> \"your answer\"   (ids are in: friday agents)" >&2; return 2; }
      jq -e '.status == "waiting_for_you"' "$d/$id.json" >/dev/null 2>&1 \
        || { echo "Run $id isn't waiting for you." >&2; return 1; }
      printf 'reply:%s' "$text" >"$d/$id.answer"
      echo "Told run $id."
      ;;
    accept|discard|compare)
      [[ "$id" =~ ^r[0-9a-f]+$ ]] && [ -f "$d/$id.json" ] \
        || { echo "usage: friday agents $cmd <id>   (ids are in: friday agents)" >&2; return 2; }
      friday-ctl agents "$cmd" "$id" ;;
    worktree)
      # Off unless turned on: each run works in its own copy of a git folder.
      local wt_env="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      case "${id:-status}" in
        on) friday_env_set FRIDAY_AGENT_WORKTREE 1; systemctl --user restart friday-linux-daemon 2>/dev/null || true
            echo "Separate copies: on. In a git folder each agent run works on its own branch; friday agents accept <id> brings its changes in, friday agents discard <id> drops them." ;;
        off) friday_env_set FRIDAY_AGENT_WORKTREE 0; systemctl --user restart friday-linux-daemon 2>/dev/null || true
             echo "Separate copies: off." ;;
        status) if grep -qx 'FRIDAY_AGENT_WORKTREE=1' "$wt_env" 2>/dev/null; then echo "Separate copies: on. Turn off: friday agents worktree off"
                else echo "Separate copies: off. Turn on: friday agents worktree on (each run in a git folder then works on its own branch until you accept it)"; fi ;;
        *) echo "Usage: friday agents worktree [status|on|off]" >&2; return 2 ;;
      esac
      ;;
    sandbox)
      # Off unless turned on: each agent runs under bubblewrap, writing only
      # its folder, with ~/.ssh, keyrings and other keys hidden.
      local sb_env="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      case "${id:-status}" in
        on) command -v bwrap >/dev/null || { echo "The sandbox needs bubblewrap: sudo pacman -S bubblewrap" >&2; return 1; }
            friday_env_set FRIDAY_AGENT_SANDBOX 1; systemctl --user restart friday-linux-daemon 2>/dev/null || true
            echo "Agent sandbox: on. Agents write only in their folder and can't read ~/.ssh, keyrings or other keys." ;;
        off) friday_env_set FRIDAY_AGENT_SANDBOX 0; systemctl --user restart friday-linux-daemon 2>/dev/null || true
             echo "Agent sandbox: off." ;;
        status) if grep -qx 'FRIDAY_AGENT_SANDBOX=1' "$sb_env" 2>/dev/null; then echo "Agent sandbox: on. Turn off: friday agents sandbox off"
                else echo "Agent sandbox: off. Turn on: friday agents sandbox on (agents then write only in their folder, keys hidden)"; fi ;;
        *) echo "Usage: friday agents sandbox [status|on|off]" >&2; return 2 ;;
      esac
      ;;
    check)
      # Off unless turned on: the tests run code the agent just wrote.
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      case "${id:-status}" in
        on) friday_env_set FRIDAY_AGENT_CHECK 1; systemctl --user restart friday-linux-daemon 2>/dev/null || true
            echo "Checking agents' work: on. When an agent says it's done, FRIDAY runs the project's tests (they run code the agent just wrote)." ;;
        off) friday_env_set FRIDAY_AGENT_CHECK 0; systemctl --user restart friday-linux-daemon 2>/dev/null || true
             echo "Checking agents' work: off." ;;
        status) if grep -qx 'FRIDAY_AGENT_CHECK=1' "$env_file" 2>/dev/null; then echo "Checking agents' work: on. Turn off: friday agents check off"
                else echo "Checking agents' work: off. Turn on: friday agents check on (FRIDAY then runs the project's tests when an agent says it's done)"; fi ;;
        *) echo "Usage: friday agents check [status|on|off]" >&2; return 2 ;;
      esac
      ;;
    status|on|off)
      friday_switch FRIDAY_AGENTS "Coding agents" agents \
        "FRIDAY can run opencode, agy, Claude Code or Codex for you and answer their routine approvals; risky steps wait for you" \
        "FRIDAY won't start coding agents" "$cmd" ;;
    *)
      echo "usage: friday agents [list|show <id>|allow <id>|deny <id>|reply <id> \"text\"|hooks [on|off]|status|on|off]" >&2
      return 2
      ;;
  esac
}

friday_sent() {
  local n="${1:-20}"
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
  local f="$state_dir/egress.jsonl"
  if [ ! -f "$f" ] || [ ! -s "$f" ]; then
    echo "Nothing has been sent yet."
    return 0
  fi

  local now_sec cutoff_sec total=0 screenshots=0 masked_sum=0
  now_sec=$(date +%s)
  cutoff_sec=$(( now_sec - 7 * 86400 ))
  declare -A prov_counts

  while IFS=$'\t' read -r ts provider model text_chars image_bytes masked outcome; do
    [ -z "$ts" ] && continue
    local p_name ts_sec
    p_name=$(friday_sent_map_provider "$provider")
    ts_sec=$(date -d "$ts" +%s 2>/dev/null || echo 0)
    if [ "$ts_sec" -ge "$cutoff_sec" ]; then
      total=$(( total + 1 ))
      prov_counts["$p_name"]=$(( ${prov_counts["$p_name"]:-0} + 1 ))
      if [ "${image_bytes:-0}" -gt 0 ]; then
        screenshots=$(( screenshots + 1 ))
      fi
      masked_sum=$(( masked_sum + ${masked:-0} ))
    fi
  done < <(jq -r '[.ts // "", .provider // "", .model // "", (.text_chars // 0), (.image_bytes // 0), (.masked // 0), .outcome // ""] | @tsv' "$f" 2>/dev/null)

  local table_rows=""
  while IFS=$'\t' read -r ts provider model text_chars image_bytes masked outcome kinds; do
    [ -z "$ts" ] && continue
    local p_name local_time chars_fmt ib what
    p_name=$(friday_sent_map_provider "$provider")
    local_time=$(date -d "$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")
    chars_fmt=$(friday_sent_format_num "${text_chars:-0}")
    ib="${image_bytes:-0}"
    if [[ "$kinds" == *"search"* ]]; then
      what="search $chars_fmt chars"
    elif [ "$ib" -ge 1024 ]; then
      local kb=$(( (ib + 512) / 1024 ))
      what="text $chars_fmt chars + screenshot $(friday_sent_format_num "$kb") KB"
    elif [ "$ib" -gt 0 ]; then
      what="text $chars_fmt chars + screenshot $(friday_sent_format_num "$ib") B"
    else
      what="text $chars_fmt chars"
    fi
    table_rows+="$(printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$local_time" "$p_name" "$model" "$what" "${masked:-0}" "$outcome")"$'\n'
  done < <(tail -n "$n" "$f" | jq -r '[.ts // "", .provider // "", .model // "", (.text_chars // 0), (.image_bytes // 0), (.masked // 0), .outcome // "", ((.kinds // []) | join(","))] | @tsv' 2>/dev/null)

  if [ -n "$table_rows" ]; then
    {
      printf 'TIME\tPROVIDER\tMODEL\tWHAT\tMASKED\tOUTCOME\n'
      printf '%s' "$table_rows"
    } | column -t -s $'\t'
    echo
  fi

  if [ "$total" -gt 0 ]; then
    local prov_list=()
    for p in "${!prov_counts[@]}"; do
      prov_list+=("${prov_counts[$p]} $p")
    done
    IFS=$'\n' sorted_provs=($(sort -rn <<<"${prov_list[*]}"))
    unset IFS
    local prov_str=""
    for sp in "${sorted_provs[@]}"; do
      [ -z "$sp" ] && continue
      if [ -n "$prov_str" ]; then
        prov_str="$prov_str, $sp"
      else
        prov_str="$sp"
      fi
    done

    local req_word="requests"
    [ "$total" -eq 1 ] && req_word="request"
    local summary="$total $req_word in the last 7 days: $prov_str"
    if [ "$screenshots" -gt 0 ]; then
      summary="$summary; $screenshots with a screenshot"
    fi
    if [ "$masked_sum" -gt 0 ]; then
      local sec_word="secrets"
      [ "$masked_sum" -eq 1 ] && sec_word="secret"
      summary="$summary; $masked_sum $sec_word masked"
    fi
    echo "$summary"
  else
    echo "0 requests in the last 7 days."
  fi
}

# `friday local-ai`: a model on this computer, sized to it.
#   detect   what the machine has (RAM, GPU, video memory, AVX2, free disk)
#   presets  how much local AI may use, and the model each budget gets
# Tests point FRIDAY_HW_ROOT at a fake /proc and /sys, and set
# FRIDAY_DISK_FREE_MB.

# The ladder: id|memory it needs (MB)|largest download, Ollama or GGUF (MB)|sees screenshots|engine
# (empty: both; ollama or llamacpp: only there, so Ollama lists only models
# in its own library, and llama.cpp can offer GGUF-only ones).
FRIDAY_LOCAL_MODELS="lfm3-vl:2b|2304|1243|1|llamacpp
qwen3:1.7b|2048|1834|0|ollama
qwen3:4b|3584|2497|0
gemma3:4b|4608|3350|1
gemma3:12b|9216|8164|1
gemma3:27b|19456|17413|1"

friday_local_ai_detect() {
  local root="${FRIDAY_HW_ROOT:-}" ram_mb=0 gpu=none discrete=no vram=unknown threads=0 avx2=no disk
  ram_mb=$(awk '/^MemTotal:/ {print int($2 / 1024)}' "$root/proc/meminfo" 2>/dev/null)
  threads=$(grep -c '^processor' "$root/proc/cpuinfo" 2>/dev/null || true)
  grep -qw avx2 "$root/proc/cpuinfo" 2>/dev/null && avx2=yes
  # The strongest GPU: NVIDIA, then AMD with its own memory, then integrated.
  local dev vendor mem
  # PCI display devices (class 0x03xx), so a GPU with no driver loaded counts.
  for dev in "$root"/sys/bus/pci/devices/*; do
    [[ -r "$dev/class" && $(<"$dev/class") == 0x03* ]] || continue
    vendor=$(<"$dev/vendor")
    case "$vendor" in
      0x10de)
        gpu=nvidia discrete=yes vram=unknown
        if command -v nvidia-smi >/dev/null 2>&1; then
          mem=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -dc 0-9 || true)
          [[ -n "$mem" ]] && vram=$mem
        fi
        break ;;
      0x1002)
        mem=$(( $(cat "$dev/mem_info_vram_total" 2>/dev/null || echo 0) / 1048576 ))
        if (( mem >= 2048 )); then gpu=amd discrete=yes vram=$mem
        elif [[ $gpu == none ]]; then gpu=amd; fi ;;
      0x8086) [[ $gpu == none ]] && gpu=intel ;;
    esac
  done
  if [[ -n "${FRIDAY_DISK_FREE_MB:-}" ]]; then disk=$FRIDAY_DISK_FREE_MB
  else
    local where="${FRIDAY_DISK_PATH:-$HOME}"
    while [[ ! -d "$where" ]]; do where=$(dirname "$where"); done
    disk=$(df -Pm "$where" 2>/dev/null | awk 'NR == 2 {print $4}')
  fi
  echo "ram_mb=${ram_mb:-0}"
  echo "gpu=$gpu"
  echo "gpu_discrete=$discrete"
  echo "vram_mb=$vram"
  echo "cpu_threads=${threads:-0}"
  echo "avx2=$avx2"
  echo "disk_free_mb=${disk:-0}"
}

# friday_local_ai_model <budget_mb> [engine]: the largest ladder model that
# fits (and that the engine has, when one is given).
friday_local_ai_model() {
  local id need _ eng best=""
  while IFS='|' read -r id need _ _ eng; do
    [[ -z "$eng" || -z "${2:-}" || "$eng" == "$2" ]] || continue
    (( $1 >= need )) && best=$id
  done <<<"$FRIDAY_LOCAL_MODELS"
  echo "$best"
}

# friday_local_ai_models [engine]: every ladder model the engine has, one id a line.
friday_local_ai_models() {
  awk -F'|' -v e="${1:-}" '$5 == "" || e == "" || $5 == e { print $1 }' <<<"$FRIDAY_LOCAL_MODELS"
}

# friday_local_ai_info <id>: "need_mb download_mb vision"
friday_local_ai_info() {
  awk -F'|' -v id="$1" '$1 == id { print $2, $3, $4 }' <<<"$FRIDAY_LOCAL_MODELS"
}

# friday_local_ai_local_first <model> <auto|local|cloud>: 1 when the local
# model answers first. Auto: above 4B it answers about as well as the free
# cloud models, so it goes first; at 4B and below cloud goes first while
# there's internet, and the local model backs it up.
# A measured speed ([3], tokens a second; `friday local-ai bench`) can only
# hold a big model back: under FRIDAY_LOCAL_MIN_TPS (8) it backs up cloud
# too, since every answer would drag.
friday_local_ai_local_first() {
  case "$2" in
    local) echo 1 ;;
    cloud) echo 0 ;;
    *) local size="${1##*:}"
       awk -v s="${size%b}" -v tps="${3:-}" -v min=8 'BEGIN { print (s + 0 > 4 && (tps == "" || tps + 0 >= min)) ? 1 : 0 }' ;;
  esac
}

# friday_local_ai_bench <base url> <model>: tokens a second, or nothing. One
# warm-up answer (loads the model), then one timed short answer.
friday_local_ai_bench() {
  local url="$1/chat/completions" body t0 t1 tokens
  body=$(jq -nc --arg m "$2" '{model: $m, messages: [{role: "user", content: "Say hi."}], max_tokens: 1}')
  timeout 300 curl -s -o /dev/null -H 'Content-Type: application/json' -d "$body" "$url" 2>/dev/null || return 0
  body=$(jq -nc --arg m "$2" '{model: $m, messages: [{role: "user", content: "Count from one to forty in words, separated by commas."}], max_tokens: 64}')
  t0=$(date +%s%N)
  tokens=$(timeout 300 curl -s -H 'Content-Type: application/json' -d "$body" "$url" 2>/dev/null \
    | jq -r '.usage.completion_tokens // empty' 2>/dev/null || true)
  t1=$(date +%s%N)
  [[ "$tokens" =~ ^[0-9]+$ ]] && (( tokens > 0 && t1 > t0 )) || return 0
  echo $(( tokens * 1000000000 / (t1 - t0) ))
}

