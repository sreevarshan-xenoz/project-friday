      echo "Nothing to cancel: no goal is running." >&2
      exit 1
    fi
    ;;
  health)
    # Each part of FRIDAY, whether it works here, and its switches.
    friday_feature_on health-page || { echo "The health page is turned off (friday feature health-page on)."; exit 0; }
