  shell)
    # FRIDAY Shell. A copy in ~/.config/friday/shell (or $FRIDAY_SHELL_DIR)
    # takes precedence over the packaged one, for people who want to edit it.
    shift
    dir="${FRIDAY_SHELL_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell}"
    [ -f "$dir/shell.qml" ] || dir=/usr/share/friday/shell
    [ -f "$dir/shell.qml" ] || { echo "friday: FRIDAY Shell not found ($dir)" >&2; exit 1; }
    command -v quickshell >/dev/null 2>&1 || { echo "friday: quickshell is not installed" >&2; exit 1; }
    pidfile="${XDG_RUNTIME_DIR:-/tmp}/friday-shell-$(id -u).pid"
    supervisor=""
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then supervisor=$(cat "$pidfile"); fi
    case "${1:-start}" in
      start)
        if [ -n "$supervisor" ]; then echo "FRIDAY Shell is already running (pid $supervisor)"; exit 0; fi
        # A window look written before the frosted glass has no blur rule.
        look="${XDG_CONFIG_HOME:-$HOME/.config}/friday/hypr-look.lua"
        if [ -f "$look" ] && ! grep -q layer_rule "$look"; then shell_window_look; fi
        shell_supervise "$dir" "$pidfile" ;;
      restart)
        if [ -n "$supervisor" ]; then
          # The supervisor starts it again; the flag says this exit is wanted.
          : >"$pidfile.restart"
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
        else
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
          setsid -f "$0" shell start >/dev/null 2>&1 </dev/null
        fi ;;
      stop)
        if [ -n "$supervisor" ]; then kill -TERM "$supervisor"; else exec quickshell kill -p "$dir"; fi ;;
      style|palette)
        # The look, as the control drawer's Look picker sets it: merged into
        # shell.json, which the shell applies live.
        key=$1; shift
        if [ "$key" = style ]; then opts="ember island dock"; else opts="ember frost moss dawn classic"; fi
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        cur=$(jq -r --arg k "$key" '.[$k] // empty' "$conf" 2>/dev/null || true)
        [ "$cur" = friday ] && cur=ember
        [ "$cur" = omarchy ] && cur=classic
        if [ -z "${1:-}" ] || [ "$1" = list ]; then
          for o in $opts; do if [ "$o" = "${cur:-ember}" ]; then echo "* $o"; else echo "  $o"; fi; done
          exit 0
        fi
        [ "$key" = palette ] && [ "$1" = omarchy ] && set -- classic
        case " $opts " in
          *" $1 "*) ;;
          *) echo "friday: no $key '$1' (choose one of: $opts)" >&2; exit 1 ;;
        esac
        mkdir -p "$(dirname "$conf")"
        if ! jq --arg k "$key" --arg v "$1" '.[$k] = $v' "$conf" >"$conf.tmp" 2>/dev/null; then
          jq -n --arg k "$key" --arg v "$1" '{($k): $v}' >"$conf.tmp"
        fi
        mv -f "$conf.tmp" "$conf"
        shell_window_look
        echo "FRIDAY Shell $key: $1" ;;
      close)   exec quickshell -p "$dir" ipc call shell close ;;
      ipc)     shift; exec quickshell -p "$dir" ipc call "$@" ;;
      friday|control|calendar|launcher|session)
               exec quickshell -p "$dir" ipc call shell toggle "$1" ;;
      *) echo "Usage: friday shell [start|restart|stop|close|friday|control|calendar|launcher|session|style [name]|palette [name]|ipc <target> <fn> [args]]" >&2; exit 1 ;;
    esac
