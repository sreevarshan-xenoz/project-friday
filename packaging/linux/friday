#!/bin/bash
# FRIDAY Unified CLI & System Control
# Bridges FRIDAY Cognitive Loop & Skill Forge with Omarchy Desktop Substrate

set -eo pipefail

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
case ":$PATH:" in
  *":${OMARCHY_PATH%/}/bin:"*) ;;
  *) PATH="${OMARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
esac
export PATH

show_help() {
  cat << 'HELP_EOF'
FRIDAY OS Command Center (M7 Cognitive Edition)

Usage:
  friday <command> [args...]
  friday <group> <command> [args...]

Autonomous Agent & Cognitive Loop:
  friday ask ["<objective>"]       Ask FRIDAY (prompts if no text); result as a notification
  friday ask --selection           Ask about the selected/copied text (Super+Alt+Y)
  friday ask --screen              Ask about what's on screen (Super+Ctrl+Y)
  friday answers                   Show past answers (last one: friday answers --last)
  friday goal "<objective>"        Dispatch an autonomous goal to FRIDAY agent
  friday cancel                    Cancel the goal FRIDAY is working on
  friday status | system-info      Inspect daemon state, memory, and telemetry
  friday context screen [--yes]    Share screen context with assistant
  friday daemon <status|restart|logs> Control friday-linux-daemon service
  friday doctor                    Check daemon, AI provider and desktop health
  friday setup-ai [provider]       Set or change the AI provider key

Skill Forge:
  friday create-skill <id>         Create new skill template
  friday validate [<path>]         Validate skill manifest and schema
  friday publish <id-or-path>      Publish validated skill

Desktop & System Substrate:
  friday theme [list|set <name>]   Switch desktop visual theme (22 available)
  friday bar [toggle|reload]       Configure Quickshell bar and widgets
  friday update                    Update system and OS components
  friday wifi [scan|connect]        Manage network connections
  friday audio [mute|vol-up]        Audio volume and device control
  friday menu                      Launch system control menu
  friday commands [--all|--json]   List all desktop substrate commands

Run 'friday <group> --help' or 'omarchy --help' for full substrate routing.
HELP_EOF
}

# `friday doctor`: one screen answering "why isn't FRIDAY working?".
# Read-only; never prints secrets. Exit 1 if any check fails.
friday_doctor() {
  local fails=0 warns=0
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
  local state="$state_dir/state.json"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  ok()   { printf '  \e[32m✓\e[0m %s\n' "$1"; }
  warn() { printf '  \e[33m!\e[0m %s\n      → %s\n' "$1" "$2"; warns=$((warns + 1)); }
  bad()  { printf '  \e[31m✗\e[0m %s\n      → %s\n' "$1" "$2"; fails=$((fails + 1)); }

  echo "FRIDAY doctor"
  echo
  echo "Daemon"
  local svc_active=false
  if systemctl --user is-active --quiet friday-linux-daemon 2>/dev/null; then
    svc_active=true
    ok "friday-linux-daemon service is active"
  else
    bad "friday-linux-daemon service is not active" "friday daemon start; then: friday daemon logs"
  fi
  if [ -r "$state" ]; then
    local status
    status=$(jq -r '.status // "unknown"' "$state" 2>/dev/null || echo "unreadable")
    if [ "$status" = "running" ] && ! $svc_active; then
      bad "state.json says running, but the service is not (stale: the daemon crashed or was killed)" \
        "friday daemon restart; if it fails again: friday daemon logs"
    elif [ "$status" = "running" ]; then ok "state.json reports: running"
    else bad "state.json reports: $status" "friday daemon restart; then: friday daemon logs"; fi
    if [ "$(jq -r '(.token // "") | length > 0' "$state" 2>/dev/null)" = "true" ]; then
      ok "command token present"
    else
      bad "no command token in state.json" "friday daemon restart (the daemon writes a fresh token)"
    fi
  else
    bad "no state file at $state" "the daemon has not started for this user: friday daemon start"
  fi
  # The daemon publishes its real address; :18432 is only the default (a second
  # user's daemon falls back to a free port).
  local listen host port
  listen=$(jq -r '.listen // empty' "$state" 2>/dev/null || true)
  listen="${listen:-127.0.0.1:18432}"
  host="${listen%:*}" port="${listen##*:}"
  if (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
    ok "listening on $listen"
  else
    bad "nothing listening on $listen" "friday daemon logs"
  fi

  echo
  echo "AI provider"
  local key_var=""
  if [ -r "$env_file" ]; then
    key_var=$(grep -oE '^[A-Z_]+_API_KEY=.+' "$env_file" | head -n1 | cut -d= -f1 || true)
  fi
  if [ -n "$key_var" ]; then ok "$key_var is set in $env_file"
  else ok "no API key: using OpenCode Zen's free models (rate-limited; friday setup-ai to add a key)"; fi
  # Can this machine reach the provider at all? (Offline, a firewall or a
  # captive portal otherwise only shows up as asks failing.) Any HTTP answer
  # counts as reachable; no credentials are sent.
  local api_host
  case "$key_var" in
    GEMINI_API_KEY)     api_host=generativelanguage.googleapis.com ;;
    GROQ_API_KEY)       api_host=api.groq.com ;;
    OPENROUTER_API_KEY) api_host=openrouter.ai ;;
    CEREBRAS_API_KEY)   api_host=api.cerebras.ai ;;
    NVIDIA_NIM_API_KEY) api_host=integrate.api.nvidia.com ;;
    *)                  api_host=opencode.ai ;;
  esac
  if curl -sS -o /dev/null --max-time 6 "https://$api_host/" 2>/dev/null; then
    ok "$api_host is reachable"
  else
    bad "can't reach $api_host" "check the network (Wi-Fi, firewall, captive portal); asks fail until it's reachable"
  fi

  echo
  echo "Desktop"
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then ok "inside a Hyprland session"
  else warn "not inside a Hyprland session" "desktop checks below may not apply over SSH/TTY"; fi
  # The Quickshell bar is FRIDAY OS's desktop; a standalone install (the
  # `friday` package on any Wayland desktop) only needs the prompt and
  # notification tools.
  local pkgs=(fuzzel libnotify jq)
  if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/ii" ]; then
    if pgrep -x qs >/dev/null || pgrep -x quickshell >/dev/null; then ok "Quickshell bar is running"
    else warn "Quickshell bar is not running" "qs -c ii &disown   (or log out and back in)"; fi
    pkgs=(quickshell qt6-positioning qt6-virtualkeyboard ttf-material-symbols-variable "${pkgs[@]}")
  fi
  local pkg missing=0
  if command -v pacman >/dev/null 2>&1; then
    for pkg in "${pkgs[@]}"; do
      if ! pacman -Q "$pkg" >/dev/null 2>&1; then
        bad "package $pkg is missing" "sudo pacman -S $pkg"; missing=$((missing + 1))
      fi
    done
    [ "$missing" -eq 0 ] && ok "required desktop packages installed"
  fi
  local tool
  for tool in friday-ctl fuzzel notify-send jq; do
    command -v "$tool" >/dev/null 2>&1 || bad "$tool not on PATH" "reinstall the package that provides $tool"
  done

  echo
  if [ "$fails" -eq 0 ] && [ "$warns" -eq 0 ]; then
    echo "All good."
  else
    echo "$fails problem(s), $warns warning(s)."
  fi
  [ "$fails" -eq 0 ]
}

# `friday setup-ai [provider]`: choose a provider, store its key in
# ~/.config/friday/friday.env (0600), restart the daemon. The key is read
# from the terminal (hidden) or from stdin, never from argv.
friday_setup_ai() {
  local provider="${1:-}" key="" var="" vision=false choice
  if [ -z "$provider" ]; then
    command -v gum >/dev/null || { echo "usage: echo KEY | friday setup-ai <opencode|gemini|groq|nvidia-nim|openrouter|cerebras>" >&2; return 1; }
    echo "FRIDAY thinks with a cloud language model. Pick a provider:"
    choice=$(gum choose --cursor="❯ " \
      "OpenCode Zen (free, no key needed)" \
      "Google Gemini (vision, free tier)" "Groq (fast, vision)" "NVIDIA NIM (vision)" \
      "OpenRouter (many models, no screen context)" "Cerebras (fast, no screen context)") || return 1
    case "$choice" in
      "OpenCode Zen"*) provider=opencode ;;
      "Google Gemini"*) provider=gemini ;; "Groq"*) provider=groq ;; "NVIDIA NIM"*) provider=nvidia-nim ;;
      "OpenRouter"*) provider=openrouter ;; "Cerebras"*) provider=cerebras ;;
    esac
  fi
  case "$provider" in
    opencode)   var=OPENCODE_API_KEY;   vision=true ;;
    gemini)     var=GEMINI_API_KEY;     vision=true ;;
    groq)       var=GROQ_API_KEY;       vision=true ;;
    nvidia-nim) var=NVIDIA_NIM_API_KEY; vision=true ;;
    openrouter) var=OPENROUTER_API_KEY ;;
    cerebras)   var=CEREBRAS_API_KEY ;;
    *) echo "unknown provider '$provider' (opencode, gemini, groq, nvidia-nim, openrouter, cerebras)" >&2; return 1 ;;
  esac
  if [ -t 0 ]; then
    local hint="paste your key"
    [ "$provider" = opencode ] && hint="optional (Enter for the free models)"
    key=$(gum input --password --prompt="$var › " --placeholder="$hint") || return 1
  else
    IFS= read -r key || true
  fi
  # OpenCode Zen's free models need no key: an empty key is valid there.
  if [ "$provider" = opencode ] && [ -z "$key" ]; then
    :
  elif [[ ! "$key" =~ ^[A-Za-z0-9._:-]{8,}$ ]]; then
    echo "That doesn't look like an API key (too short, or contains spaces/symbols)." >&2
    return 1
  fi
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  mkdir -p "$(dirname "$env_file")"
  (
    umask 077
    {
      echo "# FRIDAY AI provider credentials (friday setup-ai)."
      grep -vE '^(#|[A-Z_]+_API_KEY=|FRIDAY_CONTEXT_PROVIDER=)' "$env_file" 2>/dev/null || true
      [ -z "$key" ] || printf '%s=%s\n' "$var" "$key"
      if $vision; then echo "FRIDAY_CONTEXT_PROVIDER=$provider"; fi
    } >"$env_file.tmp"
    mv -f "$env_file.tmp" "$env_file"
  )
  if [ -n "$key" ]; then echo "Saved $var to $env_file (only you can read it)."
  else echo "Using OpenCode Zen's free models (no key). Saved to $env_file."; fi
  if systemctl --user restart friday-linux-daemon 2>/dev/null; then
    echo "Restarted FRIDAY. Press Super+Y to ask something."
  else
    echo "Saved, but could not restart the daemon; run: friday daemon restart" >&2
  fi
}

# `friday welcome`: one-time first-login greeting (autostarted by Hyprland).
friday_welcome() {
  local stamp="${XDG_STATE_HOME:-$HOME/.local/state}/friday/welcomed"
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
  [ "${1:-}" = "--force" ] || [ ! -e "$stamp" ] || return 0
  mkdir -p "$(dirname "$stamp")"; : >"$stamp"
  sleep "${FRIDAY_WELCOME_DELAY:-6}"   # let the notification daemon come up
  local name action
  name=$(getent passwd "${USER:-$(id -un)}" | cut -d: -f5 | cut -d, -f1 || true); name="${name:-${USER:-friend}}"
  local body="Press Super+Y to ask me anything, Super+Alt+Y about selected text, Super+Ctrl+Y about your screen."
  grep -qE '^[A-Z_]+_API_KEY=.+' "$env_file" 2>/dev/null \
    || body="$body I'm on OpenCode Zen's free models; add your own key any time."
  action=$(notify-send -a FRIDAY -t 20000 -A keys="Show shortcuts" -A setup="Choose AI provider" \
    "Hello, $name. I'm FRIDAY." "$body" 2>/dev/null || true)
  case "$action" in
    setup) foot -T "FRIDAY setup" bash -c 'friday setup-ai; echo; read -rsn1 -p "Press any key to close."' ;;
    keys)  notify-send -a FRIDAY -t 20000 "FRIDAY shortcuts" \
             $'Super+Y  ask\nSuper+Alt+Y  ask about selected text\nSuper+Ctrl+Y  ask about the screen\nfriday doctor  check health\nfriday answers  past answers' ;;
  esac
}

case "${1:-}" in
  ""|"-h"|"--help"|"help")
    show_help
    exit 0
    ;;
  ask)
    # Desktop entry point (SUPER+Y): prompt, run the goal, report the outcome
    # as a notification, and keep the full answer on disk.
    #   friday ask [text]               ask (prompts if no text)
    #   friday ask --selection [text]   ask about the selected/copied text (SUPER+ALT+Y)
    #   friday ask --screen [text]      ask about what's on screen (SUPER+CTRL+Y);
    #                                   a screenshot goes to the AI provider, this once
    shift
    use_selection=false use_screen=false details="" daemon_down=false
    case "${1:-}" in
      --selection|-s) use_selection=true; shift ;;
      --screen) use_screen=true; shift ;;
    esac
    goal="$*"
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    history_file="$state_dir/ask-history"
    notify() { notify-send -a FRIDAY "$@" 2>/dev/null || true; }

    context=""
    if $use_selection; then
      # Primary selection (highlighted text) first, then the clipboard.
      source_label="Selected"
      context=$(wl-paste --primary --no-newline 2>/dev/null || true)
      if [ -z "${context//[[:space:]]/}" ]; then
        source_label="Clipboard"
        context=$(wl-paste --no-newline 2>/dev/null || true)
        # The clipboard often holds a just-copied password or token. Never
        # send something shaped like one (a single long token mixing letters
        # and digits) to a cloud model by accident.
        if [[ "$context" =~ ^[^[:space:]]{12,}$ && "$context" =~ [A-Za-z] && "$context" =~ [0-9] ]]; then
          notify "FRIDAY" "The clipboard looks like a password or token, so I won't send it. Highlight the text you mean instead."
          exit 0
        fi
      fi
      if [ -z "${context//[[:space:]]/}" ]; then
        notify "FRIDAY" "Select or copy some text first, then press Super+Alt+Y."
        exit 0
      fi
      context="${context:0:4000}"
    fi

    if [ -z "$goal" ]; then
      if $use_screen; then
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY 👁 " --width=70 \
          --placeholder="Ask about your screen (a screenshot goes to your AI provider)" </dev/null) || exit 0
      elif $use_selection; then
        preview=$(tr '\n\t' '  ' <<<"$context" | cut -c1-50)
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=70 \
          --placeholder="$source_label: \"$preview…\" (e.g. summarise, explain, translate)" </dev/null) || exit 0
      elif [ -s "$history_file" ]; then
        # Recent asks, newest first. Enter re-runs the highlighted one;
        # Shift+Enter sends exactly what was typed (fuzzel execute-input).
        goal=$(fuzzel --dmenu --prompt="FRIDAY › " --width=60 --minimal-lines --lines=8 \
          --placeholder="Ask anything · Shift+Enter sends your text as typed" \
          <"$history_file") || exit 0
      else
        goal=$(fuzzel --dmenu --prompt-only="FRIDAY › " --width=60 \
          --placeholder="Ask anything" </dev/null) || exit 0
      fi
    fi
    [ -n "${goal// /}" ] || exit 0
    mkdir -p "$state_dir"
    # Remember the question (not the pasted context): newest first, no dups, last 50.
    { printf '%s\n' "$goal"; grep -vxF -- "$goal" "$history_file" 2>/dev/null || true; } \
      | head -n 50 >"$history_file.tmp" && mv -f "$history_file.tmp" "$history_file"

    request="$goal"
    if [ -n "$context" ]; then
      request=$(printf '%s\n\nUse this text as context:\n"""\n%s\n"""' "$goal" "$context")
    fi

    ok=true
    if $use_screen; then
      # Pressing the key and typing the question is the per-use consent;
      # the daemon's ContextGate still enforces it.
      notify "FRIDAY" "Looking at your screen: $goal"
      out=$(friday-ctl context screen --yes --ask "$goal" 2>&1) || ok=false
      summary=$(jq -s 'map(select(type == "object")) | last // {} | {result: .response, error: .error}' <<<"$out" 2>/dev/null || echo '{}')
    else
      notify "FRIDAY" "Working on: $goal"
      out=$(friday-ctl goal --wait "$request" 2>&1) || ok=false
      # The final {outcome,result,error} object; keep every line of the answer.
      summary=$(jq -s 'map(select(type == "object" and .outcome? != null)) | last // {}' <<<"$out" 2>/dev/null || echo '{}')
    fi
    if $ok; then
      answer=$(jq -r '.result // empty' <<<"$summary")
      [ -n "$answer" ] || answer="Done: $goal"
      title="FRIDAY ✓"
    else
      answer=$(jq -r '.error // .outcome // empty' <<<"$summary")
      [ -n "$answer" ] || answer="$out"
      # Plain-language messages for the failures people actually hit; the raw
      # error stays in the saved answer for debugging.
      details="$answer"
      case "$answer$out" in
        *FreeUsageLimitError*)
          answer="OpenCode Zen's free limit is used up for now. Try again later, or add your own key: friday setup-ai" ;;
        *"no token found"*|*"cannot reach daemon"*|*"Connection refused"*)
          answer="FRIDAY isn't running, so I couldn't ask. Start it and try again."
          daemon_down=true ;;
        *"timed out after"*)
          answer="This is taking longer than expected. FRIDAY may still be working on it: check the bar icon, or run friday answers --last later." ;;
        *) details="" ;;
      esac
      title="FRIDAY ✗ $goal"
    fi

    # Full answer on disk; the notification shows a preview with an Open button.
    answer_file="$state_dir/last-answer.md"
    {
      printf '# %s\n\n_%s_\n\n' "$goal" "$(date '+%Y-%m-%d %H:%M')"
      [ -n "$context" ] && printf '> %s\n\n' "$(head -c 300 <<<"$context" | tr '\n' ' ')"
      printf '%s\n' "$answer"
      [ -z "${details:-}" ] || printf '\n<details>\n\n```\n%s\n```\n' "$details"
    } >"$answer_file"
    cat "$answer_file" >>"$state_dir/answers.md"
    printf '\n---\n\n' >>"$state_dir/answers.md"

    preview="$answer"
    [ "${#preview}" -le 220 ] || preview="${preview:0:217}…"
    urgency=normal; $ok || urgency=critical
    actions=(-A open="Open full answer")
    [ "${daemon_down:-false}" = true ] && actions=(-A start="Start FRIDAY")
    (
      action=$(notify-send -a FRIDAY -u "$urgency" "${actions[@]}" "$title" "$preview" 2>/dev/null || true)
      case "$action" in
        open)
          foot -T "FRIDAY · $goal" less -R "$answer_file" 2>/dev/null \
            || xdg-open "$answer_file" 2>/dev/null || true ;;
        start)
          systemctl --user restart friday-linux-daemon 2>/dev/null \
            && notify-send -a FRIDAY "FRIDAY" "Started. Ask again with Super+Y." 2>/dev/null || true ;;
      esac
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    ;;
  goal)
    shift
    exec friday-ctl goal "$@"
    ;;
  cancel)
    if friday-ctl cancel >/dev/null 2>&1; then
      echo "Cancelled the current goal."
      notify-send -a FRIDAY "FRIDAY" "Cancelled the current goal." 2>/dev/null || true
    else
      echo "Nothing to cancel: no goal is running." >&2
      exit 1
    fi
    ;;
  doctor)
    friday_doctor
    ;;
  setup-ai)
    shift
    friday_setup_ai "$@"
    ;;
  welcome)
    shift
    friday_welcome "$@"
    ;;
  answers)
    d="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    f="$d/answers.md"; [ "${2:-}" = "--last" ] && f="$d/last-answer.md"
    if [ ! -s "$f" ]; then echo "No answers yet. Try: friday ask \"what's using my disk?\""; exit 0; fi
    if [ -t 1 ]; then exec less -R +G "$f"; else cat "$f"; fi
    ;;
  status|system-info)
    shift
    exec friday-ctl system-info "$@"
    ;;
  context)
    shift
    exec friday-ctl context "$@"
    ;;
  daemon)
    shift
    sub="${1:-status}"
    case "$sub" in
      status)  exec systemctl --user status friday-linux-daemon ;;
      restart) exec systemctl --user restart friday-linux-daemon ;;
      stop)    exec systemctl --user stop friday-linux-daemon ;;
      start)   exec systemctl --user start friday-linux-daemon ;;
      logs)    exec journalctl --user -u friday-linux-daemon -f ;;
      *) echo "Usage: friday daemon <status|restart|start|stop|logs>" ; exit 1 ;;
    esac
    ;;
  create-skill|validate|publish)
    if [ -x /usr/lib/friday/friday-skill-forge ]; then
      exec /usr/lib/friday/friday-skill-forge "$@"
    elif [ -x /usr/bin/friday-skill-forge ]; then
      exec /usr/bin/friday-skill-forge "$@"
    elif [ -x "$(dirname "$0")/friday-skill-forge" ]; then
      exec "$(dirname "$0")/friday-skill-forge" "$@"
    else
      echo "friday: skill-forge component not found" >&2
      exit 1
    fi
    ;;
  *)
    # Route to Omarchy substrate commands
    if command -v omarchy >/dev/null 2>&1; then
      exec omarchy "$@"
    elif [ -x /usr/share/omarchy/bin/omarchy ]; then
      exec /usr/share/omarchy/bin/omarchy "$@"
    elif [ -x "$(dirname "$0")/../share/omarchy/bin/omarchy" ]; then
      exec "$(dirname "$0")/../share/omarchy/bin/omarchy" "$@"
    else
      echo "friday: unrecognized command '$1' and omarchy substrate not found" >&2
      exit 1
    fi
    ;;
esac
