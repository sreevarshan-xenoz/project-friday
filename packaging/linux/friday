        what="$2"; shift 2
        [ -n "$*" ] || { echo "Usage: friday watch until <command> | gone <window title words>" >&2; exit 2; }
        # Started in the background; one that ends at once (a refused
        # command, no such window) says why here.
        out=$(mktemp)
        setsid friday-ctl watch "$what" "$@" </dev/null >"$out" 2>&1 &
        pid=$!
        sleep 0.5
        if ! kill -0 "$pid" 2>/dev/null; then
          rc=0; wait "$pid" || rc=$?
          if [ -s "$out" ] || [ "$rc" -ne 0 ]; then cat "$out"; else echo "That works already."; fi
          rm -f "$out"
          [ "$rc" -eq 0 ] || exit 1
          exit 0
        fi
        rm -f "$out"
        if [ "$what" = until ]; then
          echo "Watching. I'll tell you when this works: $*  (checked less often as time goes on; stop: friday watch stop)"
        else
          echo "Watching. I'll tell you when the \"$*\" window closes. Stop: friday watch stop"
        fi ;;
