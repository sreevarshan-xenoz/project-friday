  helper)
    shift
    friday_helper "$@"
    ;;
  answers)
    if [ "${2:-}" = search ]; then
      shift 2
      friday_feature_on past-answers || { echo "Searching past answers is turned off (friday feature past-answers on)."; exit 0; }
      exec friday-ctl answers search "$@"
    fi
    d="${XDG_STATE_HOME:-$HOME/.local/state}/friday"
    f="$d/answers.md"; [ "${2:-}" = "--last" ] && f="$d/last-answer.md"
    if [ ! -s "$f" ]; then echo "No answers yet. Try: friday ask \"what's using my disk?\""; exit 0; fi
    if [ -t 1 ]; then exec less -R +G "$f"; else cat "$f"; fi
    ;;
  sent)
    shift
    friday_sent "$@"
    ;;
  actions)
    shift
    friday_actions "$@"
    ;;
  tasks)
    shift
    friday_tasks "$@"
    ;;
  agents)
    shift
    friday_agents "$@"
    ;;
  secrets)
    shift
    friday_secrets "$@"
    ;;
  desktop)
    shift
    friday_desktop "$@"
    ;;
  bundles)
    # Apps for a kind of work, installed in one go.
    shift; friday_bundles "$@"; exit $?
    ;;
  keys)
    shift
    friday_keys "$@"
    ;;
  app-context)
    shift
    friday_app_context_cmd "$@"
    ;;
  forget)
    shift
    friday_forget "$@"
    ;;
  memory)
    shift
    friday_memory "$@"
    ;;
  backup)
    # A checked backup of settings, memory and history (no API keys or
    # voices): `friday backup [folder]`, `friday backup check <folder>`,
    # `friday backup restore <folder>` (checks first, keeps what it replaces).
    shift
    friday_feature_on backup || { echo "Backups are turned off (friday feature backup on)."; exit 0; }
    if [ "${1:-}" = github ]; then shift; friday_backup_github "$@"; exit; fi
    exec friday-ctl backup "$@"
    ;;
  verify-log)
    # Whether the action log is as FRIDAY wrote it (hash-chained lines).
    exec friday-ctl verify-log
    ;;
  import)
    # Keys and a model from other assistants: a preview, then --apply adds
    # what friday.env doesn't have (into the keyring when keys live there).
    shift
    friday_feature_on config-import || { echo "Importing settings is turned off (friday feature config-import on)."; exit 0; }
    if [ "${1:-}" = --apply ]; then
      env_file="${XDG_CONFIG_HOME:-$HOME/.config}/friday/friday.env"
      had_keyring=false; grep -qs '=keyring:$' "$env_file" && had_keyring=true
      friday-ctl import --apply || exit 1
      if $had_keyring; then friday_secrets keychain >/dev/null 2>&1 || true; fi
      systemctl --user restart friday-linux-daemon 2>/dev/null || true
      exit 0
    fi
    exec friday-ctl import
    ;;
  dictations)
    # The last 20 voice-typed texts, newest first; copy one back.
    shift; friday_dictations "$@"; exit $?
    ;;
  obscura)
    # A small headless browser for reading pages, from its pinned release.
    shift; friday_tool obscura "$@"; exit $?
    ;;
  llmfit)
    # Which local models fit this computer, from its pinned release.
    shift; friday_tool llmfit "$@"; exit $?
    ;;
  sounds)
    # Quiet cues for listening, done and failed (off unless turned on).
    shift; friday_sounds "$@"; exit $?
    ;;
  retention)
    # How long each kind of record FRIDAY keeps stays.
    exec friday-ctl retention
    ;;
  day)
    # A short summary of a day by project, from FRIDAY's own logs; kept in
    # the state folder, deleted with `friday day forget <date|all>`.
    shift
    friday_feature_on day-summary || { echo "Day summaries are turned off (friday feature day-summary on)."; exit 0; }
    exec friday-ctl day "$@"
    ;;
  risks)
    # What FRIDAY may do on its own: each tool action runs, is watched, asks
    # first, or never runs.
    friday_feature_on risk-table || { echo "The risk table is turned off (friday feature risk-table on)."; exit 0; }
    exec friday-ctl risks
    ;;
  activity)
    # Agent steps waiting for you, runs going now, standing tasks and runs
    # finished this week, in one list.
    friday_feature_on activity || { echo "The activity list is turned off (friday feature activity on)."; exit 0; }
    exec friday-ctl activity
    ;;
  usage)
    # Calls, failures, free-limit hits and speed per AI provider, from this
    # computer's egress log: `friday usage [days]`.
    shift
    friday_feature_on usage-page || { echo "The usage page is turned off (friday feature usage-page on)."; exit 0; }
    if [ -n "${1:-}" ]; then exec friday-ctl usage --days "$1"; fi
    exec friday-ctl usage
    ;;
  brief)
    # What happened while you were away (agents, standing tasks, reminders
    # today), from FRIDAY's own state; --say reads it aloud.
    shift
    exec friday-ctl brief "$@"
    ;;
  status|system-info)
    shift
    exec friday-ctl system-info "$@"
    ;;
  context)
    shift
    exec friday-ctl context "$@"
    ;;
  wallpaper)
    shift; friday_wallpaper "$@"; exit $?
    ;;
  lock)
    command -v hyprlock >/dev/null 2>&1 || { echo "friday: hyprlock is not installed" >&2; exit 1; }
    # Never two lock screens (this user's: another user's hyprlock doesn't lock this session).
    pgrep -u "$(id -u)" -x hyprlock >/dev/null 2>&1 && exit 0
    # If FRIDAY's config can't be written (a full disk), the packaged plain
    # one still locks: never fail open.
    if conf=$(friday_lock_conf 2>/dev/null) && [ -s "$conf" ]; then exec hyprlock -c "$conf"; fi
    exec hyprlock -c /usr/share/friday/hypr/hyprlock.conf
    ;;
  idle)
    command -v hypridle >/dev/null 2>&1 || { echo "friday: hypridle is not installed" >&2; exit 1; }
    pgrep -u "$(id -u)" -x hypridle >/dev/null 2>&1 && { echo "hypridle is already running"; exit 0; }
    # Your own ~/.config/friday/hypridle.conf, else FRIDAY's.
    conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/hypridle.conf"
    [ -f "$conf" ] || conf=/usr/share/friday/hypr/hypridle.conf
    # Kept running: if hypridle dies, nothing would lock when idle or before
    # sleep. A clean exit (stopped on purpose) ends it; five crashes in a
    # minute stop the retries.
    starts=0 window=$SECONDS
    while :; do
      status=0; hypridle -c "$conf" || status=$?
      [ "$status" -eq 0 ] && exit 0
      [ -e "${XDG_RUNTIME_DIR:-/nonexistent}/${WAYLAND_DISPLAY:-wayland-0}" ] || exit 0
      if (( SECONDS - window > 60 )); then starts=0; window=$SECONDS; fi
      starts=$((starts + 1))
      if (( starts > 5 )); then
        notify-send -a FRIDAY -u critical "The idle lock stopped" "hypridle keeps crashing; the screen won't lock by itself. Lock with Super+L." 2>/dev/null || true
        exit 1
      fi
      sleep 2
    done
    ;;
  shell)
    # FRIDAY Shell. A copy in ~/.config/friday/shell (or $FRIDAY_SHELL_DIR)
    # takes precedence over the packaged one, for people who want to edit it.
    shift
    dir="${FRIDAY_SHELL_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell}"
    [ -f "$dir/shell.qml" ] || dir=/usr/share/friday/shell
    [ -f "$dir/shell.qml" ] || { echo "friday: FRIDAY Shell not found ($dir)" >&2; exit 1; }
    command -v quickshell >/dev/null 2>&1 || { echo "friday: quickshell is not installed" >&2; exit 1; }
    pidfile="$(friday_run)/friday-shell-$(id -u).pid"
    supervisor=""
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then supervisor=$(cat "$pidfile"); fi
    case "${1:-start}" in
      start)
        if [ -n "$supervisor" ]; then echo "FRIDAY Shell is already running (pid $supervisor)"; exit 0; fi
        # A window look written before the frosted glass has no blur rule.
        look="${XDG_CONFIG_HOME:-$HOME/.config}/friday/hypr-look.lua"
        # (Or one that blurs every FRIDAY surface, which kept it redrawing.)
        if [ -f "$look" ] && { ! grep -q layer_rule "$look" || grep -qF '"^friday-.*$"' "$look"; }; then shell_window_look; fi
        shell_supervise "$dir" "$pidfile" ;;
      restart)
        if [ -n "$supervisor" ]; then
          # The supervisor starts it again; the flag says this exit is wanted.
          : >"$pidfile.restart"
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
        else
          quickshell kill -p "$dir" >/dev/null 2>&1 || true
          setsid -f "$0" shell start >/dev/null 2>&1 </dev/null
        fi ;;
      stop)
        if [ -n "$supervisor" ]; then kill -TERM "$supervisor"; else exec quickshell kill -p "$dir"; fi ;;
      dock)
        # The dock along the bottom (shell.json "dock"); off unless turned on.
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        case "${2:-status}" in
          on|off)
            mkdir -p "$(dirname "$conf")"; tmp=$(mktemp "$conf.XXXXXX")
            v=false; [ "$2" = on ] && v=true
            jq --argjson v "$v" '.dock = $v' "$conf" >"$tmp" 2>/dev/null || jq -n --argjson v "$v" '{dock: $v}' >"$tmp"
            mv -f "$tmp" "$conf"; echo "Dock: $2." ;;
          status) if [ "$(jq -r '.dock // false' "$conf" 2>/dev/null)" = true ]; then echo "Dock: on"; else echo "Dock: off (friday shell dock on)"; fi ;;
          *) echo "Usage: friday shell dock [on|off|status]" >&2; exit 2 ;;
        esac
        exit 0 ;;
      shelf)
        # The shelf on the right edge (shell.json "shelf"); off unless turned on.
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        case "${2:-status}" in
          on|off)
            mkdir -p "$(dirname "$conf")"; tmp=$(mktemp "$conf.XXXXXX")
            v=false; [ "$2" = on ] && v=true
            jq --argjson v "$v" '.shelf = $v' "$conf" >"$tmp" 2>/dev/null || jq -n --argjson v "$v" '{shelf: $v}' >"$tmp"
            mv -f "$tmp" "$conf"; echo "Shelf: $2." ;;
          status) if [ "$(jq -r '.shelf // false' "$conf" 2>/dev/null)" = true ]; then echo "Shelf: on"; else echo "Shelf: off (friday shell shelf on)"; fi ;;
          *) echo "Usage: friday shell shelf [on|off|status]" >&2; exit 2 ;;
        esac
        exit 0 ;;
      autohide|corners|background)
        # The bar's switches in shell.json: auto-hide (off unless turned on),
        # its corners and its background (on unless turned off).
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        case "$1" in
          autohide) key=barAutoHide name="Auto-hide bar" def=false ;;
          corners) key=barCorners name="Bar corners" def=true ;;
          background) key=barBackground name="Bar background" def=true ;;
        esac
        case "${2:-status}" in
          on|off)
            mkdir -p "$(dirname "$conf")"; tmp=$(mktemp "$conf.XXXXXX")
            v=false; [ "$2" = on ] && v=true
            jq --arg k "$key" --argjson v "$v" '.[$k] = $v' "$conf" >"$tmp" 2>/dev/null || jq -n --arg k "$key" --argjson v "$v" '{($k): $v}' >"$tmp"
            mv -f "$tmp" "$conf"; echo "$name: $2." ;;
          status)
            # Not "//": it takes a false as missing.
            v=$(jq -r --arg k "$key" 'if has($k) then .[$k] else empty end' "$conf" 2>/dev/null || true); [ -n "$v" ] || v=$def
            if [ "$v" = true ]; then echo "$name: on"; else echo "$name: off (friday shell $1 on)"; fi ;;
          *) echo "Usage: friday shell $1 [on|off|status]" >&2; exit 2 ;;
        esac
        exit 0 ;;
      preset)
        # A style and palette that go together (Look > Presets); either can be
        # changed on its own afterwards. Keep in step with Config.qml presets.
        presets="core:ember:core desk:lean:walnut rose:rail:rose nocturne:island:nocturne mauve:ember:mauve"
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        if [ -z "${2:-}" ]; then
          cur="$(jq -r '"\(.style // "ember"):\(.palette // "core")"' "$conf" 2>/dev/null || echo ember:core)"
          for p in $presets; do
            if [ "${p#*:}" = "$cur" ]; then echo "* ${p%%:*}"; else echo "  ${p%%:*}"; fi
          done
          exit 0
        fi
        for p in $presets; do
          [ "${p%%:*}" = "$2" ] || continue
          st=${p#*:}; st=${st%%:*}; pa=${p##*:}
          "$0" shell style "$st" >/dev/null && "$0" shell palette "$pa" >/dev/null || exit 1
          echo "Preset $2: the $st style with $pa colours."
          exit 0
        done
        echo "friday: no preset \"$2\" (core, desk, rose, nocturne, mauve)" >&2; exit 2 ;;
      style|palette)
        # The look, as the control drawer's Look picker sets it: merged into
        # shell.json, which the shell applies live.
        key=$1; shift
        if [ "$key" = style ]; then opts="ember lean island dock rail keystone orbit statusline glaze blade taskbar neon monolith"; else opts="core ember polar frost moss dawn walnut rose nocturne mauve neon contrast classic"; fi
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/friday/shell.json"
        cur=$(jq -r --arg k "$key" '.[$k] // empty' "$conf" 2>/dev/null || true)
        [ "$cur" = friday ] && cur=ember
        [ "$cur" = omarchy ] && cur=classic
        if [ -z "${1:-}" ] || [ "$1" = list ]; then
          for o in $opts; do if [ "$o" = "${cur:-ember}" ]; then echo "* $o"; else echo "  $o"; fi; done
          exit 0
        fi
        [ "$key" = palette ] && [ "$1" = omarchy ] && set -- classic
        case " $opts " in
          *" $1 "*) ;;
          *) echo "friday: no $key '$1' (choose one of: $opts)" >&2; exit 1 ;;
        esac
        mkdir -p "$(dirname "$conf")"
        tmp=$(mktemp "$conf.XXXXXX")
        # Choosing a palette means its accent, not the wallpaper's.
        if ! jq --arg k "$key" --arg v "$1" '.[$k] = $v | if $k == "palette" then del(.wallpaperAccent) else . end' "$conf" >"$tmp" 2>/dev/null; then
          jq -n --arg k "$key" --arg v "$1" '{($k): $v}' >"$tmp"
        fi
        mv -f "$tmp" "$conf"
        shell_window_look
        echo "FRIDAY Shell $key: $1" ;;
      close)   exec quickshell -p "$dir" ipc call shell close ;;
      # "--" first: a value like --screen (the answer card's mode) is an
      # argument, not one of quickshell's options.
      ipc)     shift; exec quickshell -p "$dir" ipc call -- "$@" ;;
      friday|control|calendar|launcher|session)
               exec quickshell -p "$dir" ipc call shell toggle "$1" ;;
      overview) exec quickshell -p "$dir" ipc call overview toggle ;;
      wallpaper) exec quickshell -p "$dir" ipc call wallpaper toggle ;;
      *) echo "Usage: friday shell [start|restart|stop|close|friday|control|calendar|launcher|session|overview|wallpaper|dock [on|off]|shelf [on|off]|autohide|corners|background [on|off]|preset [name]|style [name]|palette [name]|ipc <target> <fn> [args]]" >&2; exit 1 ;;
    esac
    ;;
  daemon)
    shift
    sub="${1:-status}"
    case "$sub" in
      status)  exec systemctl --user status friday-linux-daemon ;;
      restart) exec systemctl --user restart friday-linux-daemon ;;
      stop)    exec systemctl --user stop friday-linux-daemon ;;
      start)   exec systemctl --user start friday-linux-daemon ;;
      logs)    exec journalctl --user -u friday-linux-daemon -f ;;
      *) echo "Usage: friday daemon <status|restart|start|stop|logs>" ; exit 1 ;;
    esac
    ;;
  create-skill|validate|publish)
    if [ -x /usr/lib/friday/friday-skill-forge ]; then
      exec /usr/lib/friday/friday-skill-forge "$@"
    elif [ -x /usr/bin/friday-skill-forge ]; then
      exec /usr/bin/friday-skill-forge "$@"
    elif [ -x "$(dirname "$0")/friday-skill-forge" ]; then
      exec "$(dirname "$0")/friday-skill-forge" "$@"
    else
      echo "friday: skill-forge component not found" >&2
      exit 1
    fi
    ;;
  *)
    # Route to Omarchy substrate commands
    if command -v omarchy >/dev/null 2>&1; then
      exec omarchy "$@"
    elif [ -x /usr/share/omarchy/bin/omarchy ]; then
      exec /usr/share/omarchy/bin/omarchy "$@"
    elif [ -x "$(dirname "$0")/../share/omarchy/bin/omarchy" ]; then
      exec "$(dirname "$0")/../share/omarchy/bin/omarchy" "$@"
    else
      echo "friday: unrecognized command '$1' and omarchy substrate not found" >&2
      exit 1
    fi
    ;;
esac
