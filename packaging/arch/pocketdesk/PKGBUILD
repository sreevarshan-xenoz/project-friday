# Pocketdesk (your computer on your Android phone) for FRIDAY OS: the phone
# as a screen, keyboard and remote, and a place to answer FRIDAY's questions.
# FRIDAY OS and the [friday] pacman repo carry this package, so it installs
# and updates with pacman and nothing is fetched from the AUR at install time.
#
# It repackages the project's own Linux release (the tarball is a static
# build) rather than compiling it: the release is pinned below by version and
# checksum. To move the pin, change the version and the four hashes in their
# own commit (the release's SHA256SUMS lists the tarball's; the desktop entry
# and icon are fetched from the same tag). The service is installed but not
# turned on: pairing a phone (`friday phone`) does that, with consent.

pkgname=pocketdesk
pkgver=0.9.0
pkgrel=1
pkgdesc="Your Linux or Windows desktop on your Android phone: screen, input, clipboard, files and notifications (Pocketdesk, packaged for FRIDAY OS)"
arch=('x86_64')
url="https://github.com/sreevarshan-xenoz/Pocketdesk"
license=('MIT OR Apache-2.0')
# What the static binaries still load (checked with ldd on the release).
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme' 'libdrm' 'libpipewire' 'libxcb' 'mesa' 'wayland')
optdepends=(
  'pipewire: screen capture through the portal, and sound'
  'xdg-desktop-portal: screen capture on GNOME and KDE'
  'wl-clipboard: the clipboard on Wayland'
  'xclip: the clipboard on X11'
  'playerctl: what is playing, and Play/Pause and skip from the phone'
  'tailscale: reaching the computer through a tailnet'
)
install=pocketdesk.install
options=('!strip' '!debug' '!lto')

_tag="v${pkgver}"
_dir="pocketdesk-${_tag}-linux-x86_64"
source=("pocketdesk-${pkgver}.tar.gz::${url}/releases/download/${_tag}/${_dir}.tar.gz"
        "dev.pocketdesk.Pocketdesk-${pkgver}.desktop::https://raw.githubusercontent.com/sreevarshan-xenoz/Pocketdesk/${_tag}/packaging/linux/dev.pocketdesk.Pocketdesk.desktop"
        "pocketdesk-icon-${pkgver}.svg::https://raw.githubusercontent.com/sreevarshan-xenoz/Pocketdesk/${_tag}/assets/brand/pocketdesk-icon.svg")
sha256sums=('70db37efa1608b96105542f03a586a10f5fb4d9a8a1e918ae26e540b2467df9a'
            '39bbc06f8c101ef74a743df4507c683a432e020091d358cc60f301c80b57f2d8'
            'e9ec45fd3db0d6e7f32f18909f3fbb30ad924083e9667dfd29868b6eeb8696cf')

package() {
  cd "$srcdir/$_dir"
  for bin in pocketdesk pocketdesk-app pocketdesk-tray; do
    install -Dm755 "$bin" "$pkgdir/usr/bin/$bin"
  done
  # "Approve with my phone": PAM's helper, root's. Unused until the owner
  # adds its line to /etc/pam.d; the package never touches PAM.
  install -Dm755 pocketdesk-pam-ask "$pkgdir/usr/lib/pocketdesk/pocketdesk-pam-ask"
  # A session-bound user unit: off until `friday phone` (or systemctl --user
  # enable --now pocketdesk) turns it on.
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/pocketdesk start|' pocketdesk.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/pocketdesk.service"
  install -Dm644 "$srcdir/dev.pocketdesk.Pocketdesk-${pkgver}.desktop" \
    "$pkgdir/usr/share/applications/dev.pocketdesk.Pocketdesk.desktop"
  install -Dm644 "$srcdir/pocketdesk-icon-${pkgver}.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/pocketdesk.svg"
  install -Dm644 man/pocketdesk.1 "$pkgdir/usr/share/man/man1/pocketdesk.1"
  for file in README.md SECURITY.md config.toml.example; do
    install -Dm644 "$file" "$pkgdir/usr/share/doc/$pkgname/$file"
  done
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
