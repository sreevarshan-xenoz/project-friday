# FRIDAY for an existing Arch Linux install: the daemon, the `friday` CLI,
# its user service and the desktop hooks (launcher entry, Hyprland keys).
# FRIDAY OS installs this same package (iso/friday/build-iso.sh builds it).
#
# Build from a checkout of this repository:
#   cd packaging/arch && makepkg -si
# makepkg clones the checkout's committed HEAD (uncommitted changes are not
# packaged). Set FRIDAY_REPO to build from another clone or a URL.

pkgname=friday-git
_name=friday

# agent-desktop (Vercel Labs, Apache-2.0): reads and operates apps through the
# accessibility tree. FRIDAY uses it, when present, to look inside apps. The
# release is pinned here by version and checksum; the weekly bump job
# (.github/workflows/agent-desktop-bump.yml) changes only these four lines,
# after checking the new release, and a person or CI merges the result.
# _ad_sha256_windows pins the Windows build the MSI bundles
# (installer/windows/build.ps1); makepkg does not use it.
_ad_ver=1.3.1
_ad_sha256_tar=ca77b6b75034eeb12e537dd8c0a4f2a3424119253f38b7e6bd79ba0d2fef1264
_ad_sha256_windows=6ee4b1e078f4e78792e79f16e32e4a78b9919464aa3c55629b7e27ed53a08c13
_ad_sha256_license=cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30
_ad_url="https://github.com/vercel-labs/agent-desktop"
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="FRIDAY: press a key, ask about what's on screen or selected, get an answer"
arch=('x86_64')
url="https://github.com/sreevarshan-xenoz/project-friday"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc' 'openssl' 'bash' 'curl' 'jq' 'fuzzel' 'libnotify' 'wl-clipboard' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
optdepends=(
  'grim: ask about the screen (friday ask --screen)'
  'bubblewrap: coding agents in a sandbox (friday agents sandbox on)'
  'tesseract: a picked area, or a window with no text of its own, goes as its words read here, not a picture'
  'hyprland: the bundled keybindings and window context'
  'niri: the bundled keybindings (/usr/share/friday/niri/friday.kdl)'
  'foot: open full answers in a terminal'
  'gum: interactive provider picker in friday setup-ai'
  'quickshell: FRIDAY Shell (friday shell)'
  'ttf-jetbrains-mono-nerd: FRIDAY Shell icons'
  "noto-fonts: characters FRIDAY's own fonts lack"
  'brightnessctl: brightness slider in FRIDAY Shell'
  'networkmanager: network status in FRIDAY Shell'
  'friday-mobile: pair a phone (friday phone) and answer FRIDAY from it'
  'fd: file search in the FRIDAY Shell launcher'
  'age: encrypted sync between your machines (friday sync, with openssh to sign)'
  'opencode: more free answers when Zen refuses other apps (same free quota)'
  'arch-wiki-lite: answers from the Arch wiki on this computer, offline too'
  'tealdeer: answers from tldr pages on this computer (after tldr --update)'
  'sound-theme-freedesktop: the sound before FRIDAY listens for a spoken run or cancel'
)
provides=("$_name")
conflicts=("$_name")
install=friday.install
source=("$_name::git+${FRIDAY_REPO:-file://$(realpath "${startdir:-.}/../..")}"
        "agent-desktop-${_ad_ver}.tar.gz::${_ad_url}/releases/download/v${_ad_ver}/agent-desktop-v${_ad_ver}-x86_64-unknown-linux-gnu.tar.gz"
        "agent-desktop-LICENSE-${_ad_ver}::https://raw.githubusercontent.com/vercel-labs/agent-desktop/v${_ad_ver}/LICENSE")
sha256sums=('SKIP' "$_ad_sha256_tar" "$_ad_sha256_license")
options=('!lto' '!debug')

pkgver() {
  cd "$_name"
  local v
  v=$(sed -n 's/^version *= *"\(.*\)"/\1/p' services/mobile/Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "${v:-0.1.0}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release \
    --package friday-mobile --bin friday-linux-daemon --bin friday-ctl \
    --package friday-skill-forge --bin friday \
    --package friday-os-helper --bin friday-os-helper
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --package friday-mobile
}

package() {
  cd "$_name"
  local lin=packaging/linux

  install -Dm755 target/release/friday-linux-daemon -t "$pkgdir/usr/bin"
  install -Dm755 target/release/friday-ctl -t "$pkgdir/usr/bin"
  # skill-forge's binary is also called `friday`; the CLI script owns that name.
  install -Dm755 target/release/friday "$pkgdir/usr/lib/friday/friday-skill-forge"
  # root helper binary (inert until explicitly enabled via `friday helper enable`)
  install -Dm755 target/release/friday-os-helper "$pkgdir/usr/lib/friday/friday-os-helper"
  install -Dm755 "$lin/friday" -t "$pkgdir/usr/bin"
  install -Dm755 "$lin/upgrade/friday-upgrade" -t "$pkgdir/usr/lib/friday"
  install -Dm644 "$lin/upgrade/friday-upgrade.service" "$lin/upgrade/friday-upgrade.timer" -t "$pkgdir/usr/lib/systemd/system"
  # FRIDAY's guide: questions about FRIDAY are answered from this copy.
  install -Dm644 docs/USING.md -t "$pkgdir/usr/share/doc/friday"
  # FRIDAY's browser extension (load it from here) and its native host.
  install -Dm644 "packaging/browser/extension/manifest.json" \
    "packaging/browser/extension/background.js" -t "$pkgdir/usr/share/friday/browser-extension"
  install -Dm644 packaging/browser/extension/icons/*.png -t "$pkgdir/usr/share/friday/browser-extension/icons"
  install -Dm755 "packaging/browser/friday-browser-host" -t "$pkgdir/usr/lib/friday"
  # Every browser finds the host by itself: no setup step.
  local d
  for d in etc/chromium/native-messaging-hosts etc/opt/chrome/native-messaging-hosts \
      etc/opt/edge/native-messaging-hosts etc/opt/vivaldi/native-messaging-hosts \
      etc/brave/native-messaging-hosts; do
    install -Dm644 packaging/browser/org.friday.browser.chromium.json "$pkgdir/$d/org.friday.browser.json"
  done
  install -Dm644 packaging/browser/org.friday.browser.firefox.json \
    "$pkgdir/usr/lib/mozilla/native-messaging-hosts/org.friday.browser.json"

  install -Dm644 "$lin/friday-linux-daemon.service" "$lin/friday-local-ai.service" \
    "$lin/friday-llama.service" "$lin/friday-recall.service" "$lin/friday-clips.service" "$lin/friday-wake.service" \
    "$lin/friday-session-save.service" "$lin/friday-session-save.timer" -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 "$lin/_friday" -t "$pkgdir/usr/share/zsh/site-functions"

  install -Dm644 "$lin/friday.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "$lin/friday-settings.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "$lin/brand/friday.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/friday.svg"
  install -Dm644 "$lin/fonts/"*.ttf -t "$pkgdir/usr/share/fonts/friday"
  install -Dm644 "$lin/fonts/"OFL-*.txt -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$lin/hyprland/friday.lua" -t "$pkgdir/usr/share/friday/hyprland"
  install -Dm644 "$lin/niri/friday.kdl" -t "$pkgdir/usr/share/friday/niri"
  # App bundles for `friday bundles` (the first-login tour offers them).
  install -Dm644 "$lin"/bundles/* -t "$pkgdir/usr/share/friday/bundles"
  # System helper service and policy files (inert until enabled by `friday helper enable`).
  install -Dm644 "$lin/helper/friday-os-helper.service" \
    "$lin/helper/org.friday.Helper1.service" \
    "$lin/helper/org.friday.Helper1.conf" \
    "$lin/helper/org.friday.helper.policy" \
    -t "$pkgdir/usr/share/friday/helper"
  # FRIDAY Shell (Quickshell config), run with `friday shell`.
  find "$lin/shell" -type f -name '*.qml' -print0 | while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$pkgdir/usr/share/friday/shell/${f#"$lin/shell/"}"
  done
  # The key FRIDAY releases are signed with, for pacman's [friday] repo.
  install -Dm644 "$lin/whats-new" -t "$pkgdir/usr/share/friday"
  install -Dm644 packaging/arch/friday-signing-key.asc packaging/arch/friday-signing-key.fpr \
    -t "$pkgdir/usr/share/friday"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"

  # agent-desktop, beside its clipboard helper (the X11 clipboard owner it
  # looks for next to itself). Not on PATH: FRIDAY finds it here.
  install -Dm755 "$srcdir/agent-desktop" "$pkgdir/usr/lib/friday/agent-desktop"
  install -Dm755 "$srcdir/agent-desktop-linux-clipboard-owner" \
    "$pkgdir/usr/lib/friday/agent-desktop-linux-clipboard-owner"
  install -Dm644 "$srcdir/agent-desktop-LICENSE-${_ad_ver}" \
    "$pkgdir/usr/share/licenses/$pkgname/agent-desktop-LICENSE"
}
