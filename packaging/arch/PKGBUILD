# FRIDAY for an existing Arch Linux install: the daemon, the `friday` CLI,
# its user service and the desktop hooks (launcher entry, Hyprland keys).
# FRIDAY OS installs this same package (iso/friday/build-iso.sh builds it).
#
# Build from a checkout of this repository:
#   cd packaging/arch && makepkg -si
# makepkg clones the checkout's committed HEAD (uncommitted changes are not
# packaged). Set FRIDAY_REPO to build from another clone or a URL.

pkgname=friday-git
_name=friday
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="FRIDAY: press a key, ask about what's on screen or selected, get an answer"
arch=('x86_64')
url="https://github.com/sreevarshan-xenoz/project-friday"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc' 'openssl' 'bash' 'curl' 'jq' 'fuzzel' 'libnotify' 'wl-clipboard')
makedepends=('cargo' 'git')
optdepends=(
  'grim: ask about the screen (friday ask --screen)'
  'hyprland: the bundled keybindings and window context'
  'foot: open full answers in a terminal'
  'gum: interactive provider picker in friday setup-ai'
  'quickshell: FRIDAY Shell (friday shell)'
  'ttf-jetbrains-mono-nerd: FRIDAY Shell icons'
  'noto-fonts: FRIDAY Shell text'
  'brightnessctl: brightness slider in FRIDAY Shell'
  'networkmanager: network status in FRIDAY Shell'
)
provides=("$_name")
conflicts=("$_name")
install=friday.install
source=("$_name::git+${FRIDAY_REPO:-file://$(realpath "${startdir:-.}/../..")}")
sha256sums=('SKIP')
options=('!lto' '!debug')

pkgver() {
  cd "$_name"
  local v
  v=$(sed -n 's/^version *= *"\(.*\)"/\1/p' services/mobile/Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "${v:-0.1.0}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release \
    --package friday-mobile --bin friday-linux-daemon --bin friday-ctl \
    --package friday-skill-forge --bin friday
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --package friday-mobile
}

package() {
  cd "$_name"
  local lin=packaging/linux

  install -Dm755 target/release/friday-linux-daemon -t "$pkgdir/usr/bin"
  install -Dm755 target/release/friday-ctl -t "$pkgdir/usr/bin"
  # skill-forge's binary is also called `friday`; the CLI script owns that name.
  install -Dm755 target/release/friday "$pkgdir/usr/lib/friday/friday-skill-forge"
  install -Dm755 "$lin/friday" -t "$pkgdir/usr/bin"

  install -Dm644 "$lin/friday-linux-daemon.service" -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 "$lin/_friday" -t "$pkgdir/usr/share/zsh/site-functions"

  install -Dm644 "$lin/friday.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "$lin/hyprland/friday.lua" -t "$pkgdir/usr/share/friday/hyprland"
  # FRIDAY Shell (Quickshell config), run with `friday shell`.
  find "$lin/shell" -type f -name '*.qml' -print0 | while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$pkgdir/usr/share/friday/shell/${f#"$lin/shell/"}"
  done
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
