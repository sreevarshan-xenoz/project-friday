# Generated by Cargo
/target
# Separate build dir used while the soak's bridge binary is locked on /target
/target-validate

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Python (orchestrator, SDK, plugins)
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node (frontend)
node_modules/
dist/
*.tsbuildinfo

# Secrets / local config
.env
.env.*
# FRIDAY live provider-credential file (sets FRIDAY_CONTEXT_PROVIDER + API keys)
friday.env
# Secret content files (a source module like secrets.rs is NOT a secret file)
secrets.json
secrets.yaml
secrets.yml
secrets.toml
secrets.env
secrets.txt
*.pem

# Logs
logs/
*.log

# Validation harness run artifacts (samples + logs + reports)
artifacts/validation/

# FRIDAY local fabric cache
.fabric/

bench/sherpa/

# Frozen upstream checkout used as FRIDAY's substrate reference (R5).
# Never committed inside project-friday; FRIDAY integrates as an overlay.
omarchy/


# ISO build output (build-iso.sh latest-ISO symlink)
iso/out/

# The friday-git package and its local repo, built by build-iso.sh.
iso/friday/airootfs/opt/friday/repo/

# makepkg output and working dirs (packaging/arch)
packaging/arch/*.pkg.tar.*
packaging/arch/friday/
packaging/arch/src/
packaging/arch/pkg/
