<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-free logic behind the tray app (asking, parsing friday-ctl's
       answers, the AI key file, restart policy). Unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FridayTray.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
