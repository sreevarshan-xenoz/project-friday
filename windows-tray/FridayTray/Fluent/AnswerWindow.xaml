<Window x:Class="FridayTray.Fluent.AnswerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FRIDAY"
                 Width="588" MinWidth="0" MinHeight="0"
                 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                 WindowStartupLocation="Manual"
>
  <Grid x:Name="Frame" Margin="24">
    <!-- The shadow is its own layer, so the card's text stays crisp. -->
    <Border CornerRadius="14" Background="{StaticResource Ink}" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" /></Border.Effect>
    </Border>
  <Border x:Name="Card" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="14">
    <Grid>
    <Border x:Name="Wash" Background="{StaticResource EmberWash}" CornerRadius="14" IsHitTestVisible="False" />
    <Grid x:Name="Body" Margin="18,14,12,14" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The orb says how it went; the question says what was asked. -->
      <Grid x:Name="Header" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="OrbHost" Width="14" Height="14" VerticalAlignment="Center">
          <Ellipse x:Name="Halo" Fill="{StaticResource Ember}" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource EmberFill}" />
        </Grid>
        <TextBlock x:Name="Question" Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}" FontSize="14.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
        <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="25,10,6,0">
        <!-- Waiting: three dots in a slow wave. -->
        <StackPanel x:Name="Thinking" Orientation="Horizontal" Margin="0,6,0,6">
          <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="0,0,5,0" Fill="{StaticResource Subtext}" />
          <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="0,0,5,0" Fill="{StaticResource Subtext}" />
          <Ellipse x:Name="Dot3" Width="6" Height="6" Margin="0,0,10,0" Fill="{StaticResource Subtext}" />
          <TextBlock x:Name="ThinkingText" Style="{StaticResource Body}" Foreground="{StaticResource Subtext}" Text="Thinking…" />
        </StackPanel>
        <ScrollViewer x:Name="Scroll" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
          <StackPanel x:Name="Blocks" Margin="0,0,10,0" />
        </ScrollViewer>
      </Grid>

      <!-- Where the answer came from: a quiet line under it. -->
      <TextBlock x:Name="Footer" Grid.Row="2" Margin="25,2,6,0" Style="{StaticResource Caption}"
                 TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

      <WrapPanel x:Name="Buttons" Grid.Row="3" Margin="25,14,4,0" Orientation="Horizontal" HorizontalAlignment="Right" />
    </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
