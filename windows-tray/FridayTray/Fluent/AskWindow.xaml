<Window x:Class="FridayTray.Fluent.AskWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ask FRIDAY"
                 Width="728" MinWidth="0" MinHeight="0" SizeToContent="Height"
                 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                 WindowStartupLocation="Manual"
>
  <Grid x:Name="Frame" Margin="24">
    <!-- The shadow is its own layer, so the card's text stays crisp. -->
    <Border CornerRadius="14" Background="{StaticResource Ink}" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" /></Border.Effect>
    </Border>
  <Border x:Name="Card" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Border Background="{StaticResource EmberWash}" CornerRadius="14" IsHitTestVisible="False" />
      <StackPanel x:Name="Body" Margin="20,16,18,14">

        <!-- The field: the orb, the question, and Enter. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="16" Height="16" VerticalAlignment="Center">
            <Ellipse x:Name="Halo" Fill="{StaticResource Ember}" Opacity="0.22" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="1.2" ScaleY="1.2" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="9" Height="9" Fill="{StaticResource EmberFill}" />
          </Grid>
          <Grid Grid.Column="1" Margin="14,0,10,0">
            <TextBlock x:Name="Placeholder" Text="Ask FRIDAY anything…" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
            <TextBox x:Name="Input" Style="{StaticResource BareInput}" FontSize="20" VerticalAlignment="Center"
                     AutomationProperties.Name="Ask FRIDAY" />
          </Grid>
          <Border x:Name="EnterKey" Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center" Opacity="0">
            <TextBlock Text="↵" FontSize="13" Foreground="{StaticResource Subtext}" />
          </Border>
        </Grid>

        <!-- What goes with it (a selection, the screen). -->
        <Border x:Name="Context" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="30,12,0,0" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon x:Name="ContextIcon" Symbol="TextQuote24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ContextText" FontSize="12" MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Where a coding agent will work; click to pick another folder. -->
        <Border x:Name="FolderChip" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="30,12,0,0" Visibility="Collapsed" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Folder24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext}" />
            <TextBlock x:Name="FolderText" FontSize="12" MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource Subtext}" />
          </StackPanel>
        </Border>

        <!-- "Explain this" with nothing picked: which "this"? Click for the window. -->
        <Border x:Name="ThisChip" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="30,12,0,0" Visibility="Collapsed" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext}" />
            <TextBlock Text="Which “this”?   Ctrl+↵ the window in front (sent to your AI provider)   ·   ↵ just my words" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Subtext}" />
          </StackPanel>
        </Border>

        <!-- Quick actions for a selection: a soft highlight follows the keys. -->
        <ItemsControl x:Name="Quick" Margin="22,10,0,0" Visibility="Collapsed" Focusable="False" />

        <TextBlock x:Name="Keys" Margin="30,12,0,0" Style="{StaticResource Caption}" />
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</Window>
