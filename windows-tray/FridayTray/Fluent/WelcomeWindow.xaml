<Window x:Class="FridayTray.Fluent.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Welcome to FRIDAY"
                 Width="628" MinWidth="0" MinHeight="0" SizeToContent="Height"
                 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
                 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
>
  <Grid x:Name="Frame" Margin="24">
    <!-- The shadow is its own layer, so the card's text stays crisp. -->
    <Border CornerRadius="14" Background="#FF0D0F13" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" /></Border.Effect>
    </Border>
  <Border x:Name="Card" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Border Background="{StaticResource EmberWash}" CornerRadius="14" IsHitTestVisible="False" />
      <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,12,12,0" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
      </Button>
      <StackPanel x:Name="Body" Margin="38,34,38,28">

        <!-- The orb: FRIDAY's mark, glowing. -->
        <Grid x:Name="Orb" Width="60" Height="60" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="OrbScale" ScaleX="0.6" ScaleY="0.6" /></Grid.RenderTransform>
          <Ellipse x:Name="Halo" Fill="{StaticResource Ember}" Opacity="0.16" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="42" Height="42" Stroke="{StaticResource Ember}" StrokeThickness="1.5" Opacity="0.55" />
          <Ellipse Width="22" Height="22" Fill="{StaticResource EmberFill}">
            <Ellipse.Effect><DropShadowEffect Color="{StaticResource EmberColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.7" /></Ellipse.Effect>
          </Ellipse>
        </Grid>

        <TextBlock x:Name="Hello" Margin="0,20,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}">
          <Run Text="Hello. I'm " /><Run Text="FRIDAY" Foreground="{StaticResource Ember}" /><Run Text="." />
        </TextBlock>
        <TextBlock x:Name="Intro" Style="{StaticResource Body}" Foreground="{StaticResource Subtext}" Margin="0,6,0,20" FontSize="14.5"
                   Text="Ask me about what's on your screen or what you've selected, and I'll answer or do it. I only act when you ask." />

        <StackPanel x:Name="Keys" />

        <StackPanel x:Name="Tray" Orientation="Horizontal" Margin="2,10,0,0">
          <ui:SymbolIcon Symbol="ChevronUp24" FontSize="13" Foreground="{StaticResource Subtext}" Margin="0,1,8,0" VerticalAlignment="Top" />
          <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource Subtext}" MaxWidth="470"
                     Text="I live in the tray by the clock (behind the ^ arrow until you drag me out). Click the icon to ask, right-click for everything else." />
        </StackPanel>

        <Border x:Name="Note" Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Background="{StaticResource Well}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="15" Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
            <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource Subtext}" MaxWidth="440"
                       Text="Until you add your own key, I use free models. They may keep what you send them, so for anything private choose your own provider." />
          </StackPanel>
        </Border>

        <WrapPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</Window>
