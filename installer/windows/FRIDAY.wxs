<!--
  FRIDAY for Windows: a per-user MSI (no admin prompt), WiX v5.

  Installs everything build.ps1 staged (friday-tray, friday-daemon,
  friday-ctl, friday-windows-host and their .NET runtime) into
  %LOCALAPPDATA%\Programs\FRIDAY, and:
    - a Start menu shortcut,
    - starts the tray at login (HKCU Run, the same entry the tray's
      "Start at login" toggles),
    - puts the install folder on the user's PATH (friday-ctl in terminals),
    - starts the tray when an interactive install finishes,
    - closes the tray (and with it the daemon and host) before an upgrade
      or uninstall replaces its files.
  User data in %LOCALAPPDATA%\friday and %APPDATA%\friday is left alone.

  Build: installer\windows\build.ps1 (wix build ... -bindpath stage=<dir>)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="FRIDAY"
           Manufacturer="Project FRIDAY"
           Version="$(var.Version)"
           UpgradeCode="6b1f4f2e-3c55-4c49-9a0e-6a0f0b3f1d21"
           Scope="perUser"
           Compressed="yes">

    <!-- Same-version upgrades: a 0.2.0 release replaces the 0.2.0-alpha MSI
         (the MSI version has no pre-release part). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of FRIDAY is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Press a key, ask about what's on screen or selected, get an answer." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sreevarshan-xenoz/project-friday" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FRIDAY" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FRIDAY">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Integration" />
    </Feature>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**" />
    </ComponentGroup>

    <!-- Everything outside the install folder, keyed on one HKCU value so a
         per-user install validates. -->
    <Component Id="Integration" Directory="INSTALLFOLDER" Guid="9a0d2f64-5f0a-4f39-8f87-4d1c2a7b6e01">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="FRIDAY" Type="string"
                     Value="&quot;[INSTALLFOLDER]friday-tray.exe&quot;" />
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FRIDAY"
                Description="Ask FRIDAY (Win+Y)" Target="[INSTALLFOLDER]friday-tray.exe" WorkingDirectory="INSTALLFOLDER" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- End the running tray, daemon, and host before files are replaced or
         removed (their windows are hidden, so a close message alone would not do
         it), so upgrade/uninstall never leaves them running or files locked. -->
    <util:CloseApplication Id="CloseTray" Target="friday-tray.exe" CloseMessage="yes" TerminateProcess="1"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseDaemon" Target="friday-daemon.exe" TerminateProcess="1"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseHost" Target="friday-windows-host.exe" TerminateProcess="1"
                           RebootPrompt="no" />

    <!-- Start the tray after an interactive install (not for /quiet, which CI
         and winget use). -->
    <CustomAction Id="LaunchTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]friday-tray.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt; 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
