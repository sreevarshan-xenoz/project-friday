<!--
  FRIDAY for Windows: a per-user MSI (no admin prompt), WiX v5.

  Installs everything build.ps1 staged (friday-tray, friday-daemon,
  friday-ctl, friday-windows-host and their .NET runtime) into
  %LOCALAPPDATA%\Programs\FRIDAY, and:
    - a Start menu shortcut,
  and, as options the person can turn on or off on the Customize page (or
  with ADDLOCAL on the command line; a silent install takes the defaults):
    - StartAtLogin (on): starts the tray at login (HKCU Run, the same entry
      the tray's "Start at login" toggles),
    - PathEntry (on): puts the install folder on the user's PATH
      (friday-ctl in terminals),
    - DesktopShortcut (off),
    - ScreenText (on): screen questions send a window's text instead of a
      screenshot when the app offers it (the tray's default; the tray menu
      turns it off),
    - AdminAccess (off): starts FRIDAY with administrator rights at every
      sign-in so it can control apps that run as administrator. A per-user
      install cannot elevate itself, so the tray asks Windows for permission
      once, when it first starts after setup (one prompt, never one per
      setting), and sets up the sign-in task,
  and it starts the tray when an interactive install finishes, if the
  "Start FRIDAY now" box on the last page is ticked,
    - closes the tray (and with it the daemon and host) before an upgrade
      or uninstall replaces its files.
  User data in %LOCALAPPDATA%\friday and %APPDATA%\friday is left alone.

  Build: installer\windows\build.ps1 (wix build ... -bindpath stage=<dir>)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="FRIDAY"
           Manufacturer="Project FRIDAY"
           Version="$(var.Version)"
           UpgradeCode="6b1f4f2e-3c55-4c49-9a0e-6a0f0b3f1d21"
           Scope="perUser"
           Compressed="yes">

    <!-- Same-version upgrades: a 0.2.0 release replaces the 0.2.0-alpha MSI
         (the MSI version has no pre-release part). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of FRIDAY is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Replace every file on upgrade, whatever its version: 0.4.5 and older
         stamped the .NET files 1.0.0.0, so Windows Installer kept those as
         "newer", then removed them with the old product, leaving no
         FridayTray.Core.dll. The install folder is FRIDAY's alone. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <Property Id="ARPCOMMENTS" Value="Press a key, ask about what's on screen or selected, get an answer." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sreevarshan-xenoz/project-friday" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FRIDAY" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Level 1 features are on by default, level 2 ones off (INSTALLLEVEL is
         1). The Customize page shows each with its description. -->
    <Feature Id="Main" Title="FRIDAY" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Description="The tray app, the daemon, the Windows helper and the friday-ctl command.">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Integration" />
      <Feature Id="StartAtLogin" Title="Start FRIDAY when I sign in" Level="1" AllowAdvertise="no"
               Description="FRIDAY waits in the tray so Win+Y works right away. You can also switch this in the tray menu.">
        <ComponentRef Id="StartAtLoginEntry" />
      </Feature>
      <Feature Id="PathEntry" Title="Use friday-ctl from any terminal" Level="1" AllowAdvertise="no"
               Description="Adds the FRIDAY folder to your PATH (your account only).">
        <ComponentRef Id="PathEntryVariable" />
      </Feature>
      <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAdvertise="no"
               Description="A FRIDAY icon on the desktop (there is always one in the Start menu).">
        <ComponentRef Id="DesktopShortcutIcon" />
      </Feature>
      <Feature Id="ScreenText" Title="Read a window's text for screen questions" Level="1" AllowAdvertise="no"
               Description="On by default. When you ask about your screen, FRIDAY sends the window's text when the app offers enough of it (faster, and less than a picture; it can include words scrolled out of view), otherwise a screenshot. To always send the screenshot, turn it off in the tray menu.">
        <ComponentRef Id="ScreenTextChoice" />
      </Feature>
      <Feature Id="AdminAccess" Title="Start with administrator rights" Level="2" AllowAdvertise="no"
               Description="Off unless you tick it. Lets FRIDAY control apps that run as administrator, but everything FRIDAY does then runs with those rights. Windows asks for permission once, right after setup. Change it later in Settings.">
        <ComponentRef Id="AdminAccessChoice" />
      </Feature>
    </Feature>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**" />
    </ComponentGroup>

    <!-- What always happens, keyed on one HKCU value so a per-user install
         validates. -->
    <Component Id="Integration" Directory="INSTALLFOLDER" Guid="9a0d2f64-5f0a-4f39-8f87-4d1c2a7b6e01">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FRIDAY"
                Description="Ask FRIDAY (Win+Y)" Target="[INSTALLFOLDER]friday-tray.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Component Id="StartAtLoginEntry" Directory="INSTALLFOLDER" Guid="1c7e4b88-2d3a-4a8e-9b51-7f06a3c2d902">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="FRIDAY" Type="string"
                     Value="&quot;[INSTALLFOLDER]friday-tray.exe&quot;" KeyPath="yes" />
    </Component>

    <Component Id="PathEntryVariable" Directory="INSTALLFOLDER" Guid="5e2a9c14-8b60-4d77-a3f2-0c91d4e7b303">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Setup" Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
    </Component>

    <Component Id="DesktopShortcutIcon" Directory="INSTALLFOLDER" Guid="b84d0e63-9c1f-4f25-8e7a-3a5b6d1c2404">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Setup" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      <Shortcut Id="DesktopShortcutLink" Directory="DesktopFolder" Name="FRIDAY"
                Description="Ask FRIDAY (Win+Y)" Target="[INSTALLFOLDER]friday-tray.exe" WorkingDirectory="INSTALLFOLDER" />
    </Component>

    <!-- The tray reads ScreenText once on its first start, turns the setting
         on in friday.env and deletes the value, so the tray menu's toggle is
         the only switch afterwards. ScreenTextChoice (the one the installer
         tracks) stays so uninstall removes the keys. -->
    <!-- Same one-shot pattern: the tray reads AdminAccess on its first start,
         asks Windows once, creates the sign-in task and deletes the value. -->
    <Component Id="AdminAccessChoice" Directory="INSTALLFOLDER" Guid="e7a2c5d1-6b39-4f84-a0c2-9d4e1b7f3606">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Setup" Name="AdminAccess" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Options" Name="AdminAccess" Type="integer" Value="1" />
    </Component>

    <Component Id="ScreenTextChoice" Directory="INSTALLFOLDER" Guid="d3f6a1b9-4e82-4c0d-b7a5-6e19f2c8a505">
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Setup" Name="ScreenText" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\FRIDAY\Options" Name="ScreenText" Type="integer" Value="1" />
    </Component>

    <!-- End the running tray, daemon, and host before files are replaced or
         removed (their windows are hidden, so a close message alone would not do
         it), so upgrade/uninstall never leaves them running or files locked. -->
    <util:CloseApplication Id="CloseTray" Target="friday-tray.exe" CloseMessage="yes" TerminateProcess="1"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseDaemon" Target="friday-daemon.exe" TerminateProcess="1"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseHost" Target="friday-windows-host.exe" TerminateProcess="1"
                           RebootPrompt="no" />

    <!-- The install screens: Welcome, Customize (the options above), the
         progress page, then a last page with "Start FRIDAY now" ticked.
         No licence page (the licences are in the install folder); a silent
         install (/quiet, which CI and winget use) shows nothing. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start FRIDAY now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTray" Order="999"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <CustomAction Id="LaunchTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]friday-tray.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />
  </Package>
</Wix>
